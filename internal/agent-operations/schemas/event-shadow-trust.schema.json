{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proto-ui.dev/schemas/event-shadow-trust.schema.json",
  "title": "Proto UI deployment-bound Event shadow trust anchors",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "repositoryId",
    "repositoryFullName",
    "hookIds",
    "installationIds",
    "selfActorIds"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "proto-ui.event-shadow-trust" },
    "repositoryId": { "type": "integer", "minimum": 1 },
    "repositoryFullName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "hookIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "installationIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "selfActorIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    }
  }
}
