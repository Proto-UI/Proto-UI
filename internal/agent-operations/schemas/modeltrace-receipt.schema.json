{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proto-ui.dev/schemas/modeltrace-receipt.schema.json",
  "title": "Unsigned closed-set ModelTrace collaboration attribution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "measuredAt",
    "expiresAt",
    "scope",
    "source",
    "sampling",
    "result",
    "declared",
    "anomalies",
    "priorReceiptDigest",
    "trust"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "proto-ui.modeltrace-receipt"
    },
    "id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "measuredAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "sessionDigest", "contextDigest", "routeDigest"],
      "properties": {
        "repositoryId": {
          "type": "string",
          "pattern": "^github\\.com:[^/\\s]+/[^/\\s]+$"
        },
        "sessionDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contextDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "routeDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "bankDigest",
        "scorerDigest",
        "challengeDigest",
        "policyVersion"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/xqy2006/ModelTrace"
        },
        "revision": {
          "const": "d4131b30243dfa05e70180b5eedde742103f1d73"
        },
        "bankDigest": {
          "const": "e514c76928ea38d23bc0f14d3935f23c97b1efb6d96b18a19bdc88ad2d830536"
        },
        "scorerDigest": {
          "const": "83fa5bd611e18f8339122582335123c8ea168ed242298bb31f4e363abeeb6e4a"
        },
        "challengeDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policyVersion": {
          "const": "proto-ui.modeltrace.2026-10-04.1"
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "queries", "counts", "sampleDigests", "contextCalibrated"],
      "properties": {
        "method": {
          "enum": ["active-model-literals", "same-context-native-forks"]
        },
        "queries": {
          "const": 3
        },
        "counts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 120,
                  "maximum": 273
                },
                {
                  "type": "null"
                }
              ]
            },
            {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 129,
                  "maximum": 292
                },
                {
                  "type": "null"
                }
              ]
            },
            {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 136,
                  "maximum": 309
                },
                {
                  "type": "null"
                }
              ]
            }
          ],
          "items": false
        },
        "sampleDigests": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "contextCalibrated": {
          "const": false
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "modelId", "familyId", "probability", "margin", "candidates"],
      "properties": {
        "status": {
          "enum": ["candidate", "ambiguous", "failed"]
        },
        "modelId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "familyId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "probability": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "margin": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "candidates": {
          "type": "array",
          "maxItems": 3,
          "$comment": "Identity projection of models[].id in the pinned unified_bank.json (sha256:e514c76928ea38d23bc0f14d3935f23c97b1efb6d96b18a19bdc88ad2d830536). Each enrolled identity may occur at most once regardless of probability or score; uniqueItems alone compares whole candidate objects. A reviewed bank update must refresh this projection.",
          "allOf": [
            {
              "contains": { "properties": { "modelId": { "const": "gpt-5.4" } } },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": { "properties": { "modelId": { "const": "gpt-5.5" } } },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": { "properties": { "modelId": { "const": "gpt-5.6-sol" } } },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": { "properties": { "modelId": { "const": "gpt-5.6-terra" } } },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": { "properties": { "modelId": { "const": "gpt-5.6-luna" } } },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": { "properties": { "modelId": { "const": "gpt-6-astra" } } },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": { "properties": { "modelId": { "const": "gpt-6-sol" } } },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": { "properties": { "modelId": { "const": "gpt-6-luna" } } },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": { "modelId": { "const": "claude-haiku-4-5-20251001" } }
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": { "properties": { "modelId": { "const": "claude-sonnet-4-6" } } },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": { "properties": { "modelId": { "const": "claude-sonnet-5" } } },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": { "properties": { "modelId": { "const": "claude-opus-4-6" } } },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": { "properties": { "modelId": { "const": "claude-opus-4-7" } } },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": { "properties": { "modelId": { "const": "claude-opus-4-8" } } },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": { "properties": { "modelId": { "const": "claude-opus-5" } } },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": { "properties": { "modelId": { "const": "claude-opus-5-5" } } },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": { "properties": { "modelId": { "const": "claude-sonnet-5-5" } } },
              "minContains": 0,
              "maxContains": 1
            }
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["modelId", "familyId", "probability", "score"],
            "properties": {
              "modelId": {
                "type": "string",
                "enum": [
                  "gpt-5.4",
                  "gpt-5.5",
                  "gpt-5.6-sol",
                  "gpt-5.6-terra",
                  "gpt-5.6-luna",
                  "gpt-6-astra",
                  "gpt-6-sol",
                  "gpt-6-luna",
                  "claude-haiku-4-5-20251001",
                  "claude-sonnet-4-6",
                  "claude-sonnet-5",
                  "claude-opus-4-6",
                  "claude-opus-4-7",
                  "claude-opus-4-8",
                  "claude-opus-5",
                  "claude-opus-5-5",
                  "claude-sonnet-5-5"
                ]
              },
              "familyId": {
                "type": "string",
                "minLength": 1
              },
              "probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "score": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "declared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systemModel", "harnessModel"],
      "properties": {
        "systemModel": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/+-]{0,119}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "harnessModel": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/+-]{0,119}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "anomalies": {
      "type": "array",
      "uniqueItems": true,
      "allOf": [
        { "contains": { "const": "context-uncalibrated" } },
        { "contains": { "const": "unknown-model-not-excluded" } }
      ],
      "items": {
        "enum": [
          "context-uncalibrated",
          "unknown-model-not-excluded",
          "ambiguous-candidates",
          "system-label-mismatch",
          "harness-label-mismatch",
          "declaration-conflict",
          "declared-model-not-in-bank",
          "system-label-unavailable",
          "harness-label-unavailable",
          "retest-inconsistent",
          "probe-failed",
          "sample-validation-failed",
          "count-deviation"
        ]
      }
    },
    "priorReceiptDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signed", "backendAuthenticated", "grantsPermission", "unknownModelDetectable"],
      "properties": {
        "signed": {
          "const": false
        },
        "backendAuthenticated": {
          "const": false
        },
        "grantsPermission": {
          "const": false
        },
        "unknownModelDetectable": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "priorReceiptDigest": { "type": "null" }
        }
      },
      "then": {
        "properties": {
          "anomalies": {
            "not": { "contains": { "const": "retest-inconsistent" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "properties": {
              "status": { "const": "failed" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "modelId": { "type": "null" },
              "familyId": { "type": "null" },
              "probability": { "type": "null" },
              "margin": { "type": "null" },
              "candidates": { "maxItems": 0 }
            }
          },
          "anomalies": {
            "contains": {
              "enum": ["probe-failed", "sample-validation-failed"]
            }
          }
        }
      },
      "else": {
        "properties": {
          "sampling": {
            "properties": {
              "counts": { "items": { "type": "integer" } },
              "sampleDigests": { "items": { "type": "string" } }
            }
          },
          "result": {
            "properties": {
              "probability": { "type": "number" },
              "margin": { "type": "number" },
              "candidates": { "minItems": 3 }
            },
            "if": {
              "properties": {
                "status": { "const": "ambiguous" }
              }
            },
            "then": {
              "properties": {
                "modelId": { "type": "null" },
                "familyId": { "type": "null" }
              }
            },
            "else": {
              "properties": {
                "modelId": { "type": "string", "minLength": 1 },
                "familyId": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  ],
  "description": "Runtime recomputes all three strict unmodified raw samples, scores, anomalies, canonical receipt digest, scope and TTL before writes. Schema validity alone proves neither measurement provenance nor backend identity. Candidate probabilities are conditional on the pinned closed candidate set, not authenticated identity confidence."
}
