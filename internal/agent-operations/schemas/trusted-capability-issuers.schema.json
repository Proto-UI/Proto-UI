{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proto UI Trusted Capability Issuers",
  "type": "object",
  "required": ["schemaVersion", "issuers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "issuers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "keyId",
          "purposes",
          "evaluatorIds",
          "publicKeySpkiBase64",
          "status",
          "notBefore",
          "expiresAt"
        ],
        "properties": {
          "keyId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{3,120}$" },
          "purposes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["capability-attestation", "task-probe"] }
          },
          "evaluatorIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 200 }
          },
          "publicKeySpkiBase64": { "type": "string", "minLength": 44 },
          "status": { "enum": ["active", "revoked"] },
          "notBefore": { "type": "string", "format": "date-time", "minLength": 20 },
          "expiresAt": { "type": "string", "format": "date-time", "minLength": 20 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
