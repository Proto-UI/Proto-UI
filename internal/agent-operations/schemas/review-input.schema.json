{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proto UI Review Input Snapshot",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "repositoryId",
    "pullRequest",
    "pullRequestState",
    "pullRequestAuthor",
    "isDraft",
    "baseRefName",
    "baseSha",
    "headSha",
    "pullRequestBody",
    "changedFiles",
    "commits",
    "reviews",
    "comments",
    "replies",
    "threads",
    "checks",
    "externalEvidence"
  ],
  "properties": {
    "schemaVersion": { "const": 4 },
    "kind": { "const": "proto-ui.review-input" },
    "repositoryId": { "type": "string", "minLength": 4 },
    "pullRequest": { "type": "integer", "minimum": 1 },
    "pullRequestState": { "enum": ["OPEN", "CLOSED", "MERGED"] },
    "pullRequestAuthor": { "type": "string", "minLength": 1 },
    "isDraft": { "type": "boolean" },
    "baseRefName": { "type": "string", "minLength": 1 },
    "baseSha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "headSha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "pullRequestBody": { "type": "string" },
    "changedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "previousPath", "status"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "previousPath": { "type": ["string", "null"], "minLength": 1 },
          "status": {
            "enum": ["added", "removed", "modified", "renamed", "copied", "changed", "unchanged"]
          }
        },
        "additionalProperties": false
      }
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sha", "message", "author", "committer"],
        "properties": {
          "sha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
          "message": { "type": "string" },
          "author": { "$ref": "#/$defs/commitActor" },
          "committer": { "$ref": "#/$defs/commitActor" }
        },
        "additionalProperties": false
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "author", "state", "commitSha", "submittedAt", "body"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "author": { "type": ["string", "null"], "minLength": 1 },
          "state": { "type": "string", "minLength": 1 },
          "commitSha": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{40,64}$"
          },
          "submittedAt": { "type": ["string", "null"], "format": "date-time" },
          "body": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "author", "body", "updatedAt"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "author": { "type": "string", "minLength": 1 },
          "body": { "type": "string" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "replies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "threadId", "updatedAt", "author", "body"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "threadId": { "type": "string", "minLength": 1 },
          "updatedAt": { "type": "string", "format": "date-time" },
          "author": { "type": "string", "minLength": 1 },
          "body": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "isResolved", "updatedAt"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "isResolved": { "type": "boolean" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "conclusion",
          "completedAt",
          "detailsUrl",
          "source",
          "providerId",
          "repository",
          "workflowName",
          "workflowPath"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "conclusion": { "type": ["string", "null"] },
          "completedAt": { "type": ["string", "null"], "format": "date-time" },
          "detailsUrl": { "type": ["string", "null"], "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "providerId": { "type": ["string", "null"], "minLength": 1 },
          "repository": { "type": ["string", "null"], "minLength": 1 },
          "workflowName": { "type": ["string", "null"], "minLength": 1 },
          "workflowPath": { "type": ["string", "null"], "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "externalEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "locator", "digest"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "commitActor": {
      "type": "object",
      "required": ["login", "name", "email"],
      "properties": {
        "login": { "type": ["string", "null"], "minLength": 1 },
        "name": { "type": "string" },
        "email": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
