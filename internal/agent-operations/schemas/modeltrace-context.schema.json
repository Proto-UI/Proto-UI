{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proto-ui.dev/schemas/modeltrace-context.schema.json",
  "title": "Private independent ModelTrace session/context declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "repositoryId",
    "sessionId",
    "contextDigest",
    "routeDigest",
    "declared"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "proto-ui.modeltrace-context"
    },
    "repositoryId": {
      "type": "string",
      "pattern": "^github\\.com:[^/\\s]+/[^/\\s]+$"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "contextDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "routeDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "declared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systemModel", "harnessModel"],
      "properties": {
        "systemModel": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/+-]{0,119}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "harnessModel": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/+-]{0,119}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "description": "Declare stable task/instruction/tool settings and provider/model route independently from task-authored artifacts. The session ID is private; publish only its digest. This operator declaration is not runtime attestation or an authorization credential."
}
