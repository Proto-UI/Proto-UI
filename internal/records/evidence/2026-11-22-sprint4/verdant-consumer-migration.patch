+  console.log(`Verified ${pin.data.methods.length} pure methods from the original authored source.`);
+} else {
+  const written = await compiler.writeRustDataCompilation(compiled.value, output);
+  if (!written.ok) throw new Error(JSON.stringify(written.diagnostics));
+  await writeFile(receiptPath, JSON.stringify(receipt, null, 2) + '\n', { flag: 'wx' });
+  console.log(`Published ${pin.data.methods.length} checked pure methods as ${pin.data.crateName}.`);
+}
