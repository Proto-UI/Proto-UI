+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../..');
+const options = { pin: path.join(root, 'frontend/proto-ui/compiler.pin.json'), check: false };
+for (let index = 2; index < process.argv.length; index += 1) {
+  const argument = process.argv[index];
+  if (argument === '--check') options.check = true;
+  else if (argument === '--pin' || argument === '--upstream') {
+    assert.ok(process.argv[index + 1], `${argument} requires a path`);
+    options[argument.slice(2)] = path.resolve(process.argv[++index]);
+  } else throw new Error(`Unknown argument ${argument}`);
+}
+assert.ok(options.upstream, '--upstream must name the pinned compiler checkout');
+const pin = JSON.parse(await readFile(options.pin, 'utf8'));
+assert.equal(pin.data?.profile, 'rust-data-v1');
+assert.ok(Array.isArray(pin.data.methods) && pin.data.methods.length > 0);
+assert.equal(new Set(pin.data.methods).size, pin.data.methods.length);
+assert.ok(pin.data.methods.every((name) => typeof name === 'string' && name.length > 0));
+assert.match(pin.data.crateName, /^[a-z][a-z0-9-]*$/);
+const projectPath = (name) => {
+  assert.equal(typeof name, 'string');
+  assert.ok(name.length > 0 && !path.isAbsolute(name));
+  const resolved = path.resolve(root, name);
+  assert.ok(resolved.startsWith(root + path.sep), 'Data artifact path must stay inside this app');
+  return resolved;
+};
+const source = projectPath(pin.source);
+const output = projectPath(pin.data.output.directory);
+const receiptPath = projectPath(pin.data.output.receipt);
+assert.notEqual(output, projectPath(pin.output.directory), 'The data and GPUI artifacts have separate ownership');
+
+// Reuse the existing producer's exact revision, clean checkout, package and
+// toolchain gates and verify the retained GPUI view against fresh compilation.
+const gate = spawnSync(process.execPath, [path.join(root, 'frontend/proto-ui/tools/build-proto-ui.mjs'),
+  '--pin', options.pin, '--upstream', options.upstream, '--check'], { cwd: root, stdio: 'inherit' });
+assert.equal(gate.status, 0, 'Pinned GPUI producer/source verification failed');
+const require = createRequire(path.join(options.upstream, 'package.json'));
+const { register } = await import(pathToFileURL(require.resolve('tsx/esm/api')).href);
+register();
+const compiler = await import(pathToFileURL(path.join(options.upstream, 'packages/compiler/src/rust-data.ts')).href);
+const compiled = await compiler.compileRustDataFile(source, {
+  root, methods: pin.data.methods, crateName: pin.data.crateName,
+});
+if (!compiled.ok) throw new Error(`Pure authored method selection rejected: ${JSON.stringify(compiled.diagnostics, null, 2)}`);
+const artifacts = compiler.rustDataCompilationArtifacts(compiled.value);
+const sha256 = (value) => createHash('sha256').update(value).digest('hex');
+const git = (...args) => execFileSync('git', ['-C', options.upstream, ...args], { encoding: 'utf8' }).trim();
+assert.equal(git('rev-parse', 'HEAD'), pin.upstream.revision);
+assert.equal(git('status', '--porcelain', '--untracked-files=all'), '');
+const receipt = {
+  schema: 'verdant.proto-ui.rust-data-receipt.v1',
+  upstream: { repository: pin.upstream.repository, revision: pin.upstream.revision, tree: git('rev-parse', 'HEAD^{tree}') },
+  source: { path: pin.source, sha256: sha256(await readFile(source)) },
+  profile: compiled.value.output.profile, irVersion: compiled.value.ir.schemaVersion,
+  sourceClosure: compiled.value.ir.sourceFiles.map(({ file, sha256 }) => ({ file, sha256 })),
+  methods: compiled.value.output.methods, crateName: pin.data.crateName,
+  dependencies: compiled.value.output.dependencies,
+  output: pin.data.output.directory,
+  artifacts: artifacts.map(({ path, contents }) => ({ path, sha256: sha256(contents), bytes: Buffer.byteLength(contents) })),
+};
+if (options.check) {
+  const diff = await compiler.diffRustDataCompilation(compiled.value, output);
