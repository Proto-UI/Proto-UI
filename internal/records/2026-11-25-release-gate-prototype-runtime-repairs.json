  "sourceRepairs": [
    {
      "area": "NumberField steps",
      "change": "Replace forbidden authored hover/active variants in Brutalist, Bootstrap and Liquid with borrowed hovered/pressed paint that clears on cancel, disabled and unmount. Base retains the only value and activation owner.",
      "evidence": "Six new real-WC pointer, proposal, disabled, cancellation and remount cases fail before and pass after; all existing numeric families pass in the final set."
    },
    {
      "area": "Carousel Context",
      "change": "Use required Context read/subscribe consistently in the four family visual projections. Do not mix required subscriptions with optional trySubscribe on the same key.",
      "evidence": "All four-family continuous, nested feedback, nested audit, disabled and navigation cases pass."
    },
    {
      "area": "Liquid Drawer Content",
      "change": "Restore the supported zero-duration Base transition policy while retaining the declared material owner, opt-out, edge recipes and controlled refusal.",
      "authority": "P-LIQUID-GLASS-DRAWER requires Content material but does not guarantee motion; simultaneous material and typed-motion ownership remains unsupported and is not claimed by this repair.",
      "evidence": "Real Runtime callback capability, actual zero-duration scheduler, entering/entered/closed observations, controlled refusal and material candidate withdrawal retained."
    },
    {
      "area": "Brutalist Drawer Trigger and Close",
      "classification": "actual regression, not fixture drift",
      "change": "Restore the bounded flat recipe with existing min-height, wrapping, color, focus and disabled behavior. Remove shared elevated control/hit-envelope bundles; retain exactly one matching Base hook.",
      "authority": "internal/contracts/overlay/brutalist-drawer-command-density.presentation.v0.md",
      "history": {
        "regressionCommit": "c049606db4a93fa15e7e9a97708d2ea6364a0557",
        "pr": "https://github.com/Proto-UI/Proto-UI/pull/1818",
        "releaseIntake": "https://github.com/Proto-UI/Proto-UI/pull/1818#issuecomment-7144047242",
        "priorSource": "26a9bd1c2ec0fbef260728d0703add94cf99b181",
        "lastDensityContractChange": "00dc091f846f7f92985835e1a24df340dfcb5b50",
        "finding": "PR 1818 admits Header/Footer catalog work but contains no explicit supersession of the independent command-density boundary. The typed depth grammar does not name Drawer Trigger or Close as elevated controls."
      },
      "evidence": "Original no-shadow and no-transform oracles retained; actual pointer enter/down/cancel and disabled activation checks added. A disabled Trigger pointerdown can still produce the existing panel outside.press dismissal; it never adds trigger.press or close.press. Source-host/CSS evidence is not native hit-geometry acceptance."
    },
    {
      "area": "Bootstrap Dialog Footer",
      "classification": "actual regression, not fixture drift",
      "change": "Restore shadow-none in place of the fixed white inset highlight.",
      "authority": [
        "spec/prototypes/P-BOOTSTRAP-2-3-2-DIALOG-FOOTER.yaml",
        "spec/prototypes/P-BOOTSTRAP-2-3-2-DIALOG-CONTENT.yaml",
        "internal/records/2026-11-09-bootstrap-modal-repair.md"
      ],
      "evidence": "All three modal-family forbidden-white-highlight assertions retained; semantic title/description contrast checked against both palettes."
    }
  ],
  "fixtureRepairs": [
    "Preserve current family-specific geometry, ink, hover/press, disabled, focus-visible, controlled-refusal and lifecycle assertions while replacing superseded static recipes. Dynamic material paint is observed as resolved tokens; simple CSS-lowered rules retain their guarded prefixes.",
    "Select portal retirement observes both host-render opportunities and still checks retained identity, pending detach and the final unmount pair.",
    "Bootstrap typed presence uses the actual Web presentation sink and its real completion receipt; tests delay only delivery to observe entering/leaving. No fabricated phase or state is injected.",
    "Public Drawer tests follow the current goal editor, including increase, decrease and submit callbacks, while preserving sole-physical-action and root identity checks.",
    "Popover anchored 3px shadow is explicitly admitted by D-BRUTALIST-DEPTH-MOTION-GRAMMAR-0001; tests continue to forbid the generic 4px panel and displacement.",
    "The complete-family Popover collector was separately retried serially with identical inventory: it needed 11019ms and then exposed an obsolete font-black assertion. Only that full-family case receives the existing 120000ms family-closure budget; its complete normal/shadow CSS assertions remain intact."
  ],
