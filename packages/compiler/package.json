{
  "name": "@proto.ui/compiler",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Proto language compiler and typed native-source targets.",
  "engines": {
    "node": ">=24"
  },
  "protoUi": {
    "release": {
      "scan": false
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./frontend": {
      "types": "./src/frontend/index.ts",
      "default": "./src/frontend/index.ts"
    },
    "./editor": {
      "types": "./src/editor.ts",
      "default": "./src/editor.ts"
    },
    "./source-manifest": {
      "types": "./src/source-manifest.ts",
      "default": "./src/source-manifest.ts"
    },
    "./producer": {
      "types": "./src/producer/index.ts",
      "default": "./src/producer/index.ts"
    },
    "./targets/ir": "./src/targets/component-ir.ts",
    "./targets/validate": "./src/targets/validate.ts",
    "./targets/react": "./src/targets/react.ts",
    "./targets/gpui": "./src/targets/gpui.ts",
    "./support/react": "./src/support/react/index.ts",
    "./support/react/retained": "./src/support/react/retained.ts",
    "./support/owned-tasks": "./src/support/owned-tasks.ts"
  },
  "scripts": {
    "test": "node --test test/*.node-test.mjs",
    "lint": "node src/cli-entry.mjs lint",
    "test:targets:react": "node --test test/react-target.node-test.mjs",
    "test:targets:gpui": "node --test test/gpui-target.node-test.mjs",
    "status": "node src/cli-entry.mjs --status"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.25.12",
    "playwright-core": "1.58.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  }
}
