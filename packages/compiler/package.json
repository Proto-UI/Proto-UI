{
  "name": "@proto.ui/compiler",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Proto language compiler foundation; the legacy compiler is retired and all replacement targets are not implemented.",
  "engines": {
    "node": ">=24"
  },
  "protoUi": {
    "release": {
      "scan": false
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "node --test test/retirement.node-test.mjs",
    "status": "node src/cli-entry.mjs --status"
  }
}
