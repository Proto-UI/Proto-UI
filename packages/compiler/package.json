{
  "name": "@proto.ui/compiler",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Proto language compiler foundation and partial semantic analysis; all replacement source targets remain unimplemented.",
  "engines": {
    "node": ">=24"
  },
  "protoUi": {
    "release": {
      "scan": false
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./frontend": {
      "types": "./src/frontend/index.ts",
      "default": "./src/frontend/index.ts"
    },
    "./editor": {
      "types": "./src/editor.ts",
      "default": "./src/editor.ts"
    },
    "./source-manifest": {
      "types": "./src/source-manifest.ts",
      "default": "./src/source-manifest.ts"
    }
  },
  "dependencies": {
    "typescript": "^5.0.0"
  },
  "scripts": {
    "test": "node --test test/*.node-test.mjs",
    "lint": "node src/cli-entry.mjs lint",
    "status": "node src/cli-entry.mjs --status"
  }
}
