{
  "name": "@proto.ui/compiler",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "protoUi": {
    "release": {
      "scan": false
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    },
    "./browser": {
      "types": "./src/browser/index.ts",
      "default": "./src/browser/index.ts"
    }
  },
  "dependencies": {
    "@proto.ui/core": "workspace:*",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@proto.ui/hooks": "workspace:*",
    "@proto.ui/prototypes-base": "workspace:*",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "description": "Proto UI compiler: TypeScript semantic frontend, typed HIR and SSA, native React and GPUI AST targets, and LLVM IRBuilder.",
  "scripts": {
    "check:types": "tsc -p tsconfig.check.json --noEmit"
  }
}
