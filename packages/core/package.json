{
  "name": "@proto.ui/core",
  "version": "0.3.0-alpha.0",
  "private": false,
  "type": "module",
  "protoUi": {
    "buildDependencies": [
      "@proto.ui/types"
    ]
  },
  "devDependencies": {
    "@proto.ui/types": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "default": "./dist/internal.js"
    }
  },
  "description": "Proto UI core syntax and protocol primitives.",
  "license": "MIT",
  "homepage": "https://github.com/Proto-UI/Proto-UI/tree/main/packages/core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Proto-UI/Proto-UI.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Proto-UI/Proto-UI/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "proto-ui",
    "proto",
    "ui",
    "core"
  ],
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build/public-packages.mjs --package @proto.ui/core",
    "prepack": "pnpm run build"
  }
}
