{
  "name": "Release is idempotent, default action is window bound, disposal is terminal",
  "sessionId": "s1",
  "steps": [
    {
      "op": "install",
      "transaction": {
        "protocolVersion": 0,
        "sessionId": "s1",
        "instanceId": "i1",
        "viewEpoch": 1,
        "commitId": 1,
        "template": null,
        "slots": {
          "slots": ["slot-default"]
        },
        "events": {
          "registrations": [
            {
              "leaseId": "l-a",
              "scope": "root",
              "type": "press.commit"
            },
            {
              "leaseId": "l-b",
              "scope": "root",
              "type": "pointer.down"
            }
          ]
        },
        "focus": {
          "targets": [
            {
              "ref": "focus-root",
              "sequential": true,
              "programmatic": true
            }
          ]
        },
        "style": [],
        "a11y": null
      },
      "expect": {
        "status": "applied"
      }
    },
    {
      "op": "activate",
      "viewEpoch": 1,
      "commitId": 1,
      "expect": {
        "status": "activated"
      }
    },
    {
      "op": "release",
      "leaseIds": ["l-a", "l-missing"],
      "expect": {
        "released": ["l-a"],
        "alreadyReleased": [],
        "unknown": ["l-missing"]
      }
    },
    {
      "op": "release",
      "leaseIds": ["l-a"],
      "expect": {
        "released": [],
        "alreadyReleased": ["l-a"],
        "unknown": []
      }
    },
    {
      "op": "deliver",
      "sample": {
        "sampleId": "sm-1",
        "viewEpoch": 1,
        "type": "press.commit",
        "leaseIds": ["l-a"]
      },
      "expect": {
        "status": "rejected",
        "reason": "no-active-lease"
      }
    },
    {
      "op": "deliver",
      "sample": {
        "sampleId": "sm-2",
        "viewEpoch": 1,
        "type": "pointer.down",
        "leaseIds": ["l-b"]
      },
      "expect": {
        "status": "delivered",
        "leaseIds": ["l-b"]
      }
    },
    {
      "op": "defaultAction",
      "request": {
        "sessionId": "s1",
        "sampleId": "sm-2",
        "reason": "button.space-activation",
        "source": "base-button"
      },
      "withinWindow": true,
      "expect": {
        "status": "applied"
      }
    },
    {
      "op": "defaultAction",
      "request": {
        "sessionId": "s1",
        "sampleId": "sm-2"
      },
      "withinWindow": true,
      "expect": {
        "status": "duplicate"
      }
    },
    {
      "op": "deliver",
      "sample": {
        "sampleId": "sm-3",
        "viewEpoch": 1,
        "type": "pointer.down",
        "leaseIds": ["l-b"]
      },
      "expect": {
        "status": "delivered",
        "leaseIds": ["l-b"]
      }
    },
    {
      "op": "defaultAction",
      "request": {
        "sessionId": "s1",
        "sampleId": "sm-3"
      },
      "withinWindow": false,
      "expect": {
        "status": "late-prevention"
      }
    },
    {
      "op": "defaultAction",
      "request": {
        "sessionId": "s1",
        "sampleId": "sm-unknown"
      },
      "withinWindow": true,
      "expect": {
        "status": "unknown-sample"
      }
    },
    {
      "op": "defaultAction",
      "request": {
        "sessionId": "s2",
        "sampleId": "sm-3"
      },
      "withinWindow": true,
      "expect": {
        "status": "unknown-sample"
      }
    },
    {
      "op": "dispose",
      "expect": {
        "status": "disposed",
        "releasedLeaseIds": ["l-b"]
      }
    },
    {
      "op": "dispose",
      "expect": {
        "status": "already-disposed",
        "releasedLeaseIds": []
      }
    },
    {
      "op": "install",
      "transaction": {
        "protocolVersion": 0,
        "sessionId": "s1",
        "instanceId": "i1",
        "viewEpoch": 2,
        "commitId": 1,
        "template": null,
        "slots": {
          "slots": ["slot-default"]
        },
        "events": {
          "registrations": [
            {
              "leaseId": "l-c",
              "scope": "root",
              "type": "press.commit"
            }
          ]
        },
        "focus": {
          "targets": [
            {
              "ref": "focus-root",
              "sequential": true,
              "programmatic": true
            }
          ]
        },
        "style": [],
        "a11y": null
      },
      "expect": {
        "status": "failed",
        "diagnosticCodes": ["session-disposed"]
      }
    },
    {
      "op": "activate",
      "viewEpoch": 1,
      "commitId": 1,
      "expect": {
        "status": "disposed"
      }
    },
    {
      "op": "deliver",
      "sample": {
        "sampleId": "sm-4",
        "viewEpoch": 1,
        "type": "press.commit",
        "leaseIds": ["l-a"]
      },
      "expect": {
        "status": "rejected",
        "reason": "disposed"
      }
    },
    {
      "op": "snapshot",
      "expect": {
        "phase": "disposed",
        "activeEpoch": null,
        "leases": [
          {
            "leaseId": "l-a",
            "active": false,
            "released": true
          },
          {
            "leaseId": "l-b",
            "active": false,
            "released": true
          }
        ]
      }
    }
  ]
}
