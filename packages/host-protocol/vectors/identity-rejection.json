{
  "name": "A session owns one instance and one protocol version",
  "sessionId": "s1",
  "steps": [
    {
      "op": "install",
      "transaction": {
        "protocolVersion": 0,
        "sessionId": "s2",
        "instanceId": "i1",
        "viewEpoch": 1,
        "commitId": 1,
        "template": null,
        "slots": {
          "slots": ["slot-default"]
        },
        "events": {
          "registrations": [
            {
              "leaseId": "l-a",
              "scope": "root",
              "type": "press.commit"
            }
          ]
        },
        "focus": {
          "targets": [
            {
              "ref": "focus-root",
              "sequential": true,
              "programmatic": true
            }
          ]
        },
        "a11y": null
      },
      "expect": {
        "status": "failed",
        "diagnosticCodes": ["session-mismatch"]
      }
    },
    {
      "op": "install",
      "transaction": {
        "protocolVersion": 99,
        "sessionId": "s1",
        "instanceId": "i1",
        "viewEpoch": 1,
        "commitId": 1,
        "template": null,
        "slots": {
          "slots": ["slot-default"]
        },
        "events": {
          "registrations": [
            {
              "leaseId": "l-a",
              "scope": "root",
              "type": "press.commit"
            }
          ]
        },
        "focus": {
          "targets": [
            {
              "ref": "focus-root",
              "sequential": true,
              "programmatic": true
            }
          ]
        },
        "a11y": null
      },
      "expect": {
        "status": "unsupported",
        "diagnosticCodes": ["protocol-version"]
      }
    },
    {
      "op": "snapshot",
      "expect": {
        "currentEpoch": null,
        "leases": []
      }
    },
    {
      "op": "install",
      "transaction": {
        "protocolVersion": 0,
        "sessionId": "s1",
        "instanceId": "i1",
        "viewEpoch": 1,
        "commitId": 1,
        "template": null,
        "slots": {
          "slots": ["slot-default"]
        },
        "events": {
          "registrations": [
            {
              "leaseId": "l-a",
              "scope": "root",
              "type": "press.commit"
            }
          ]
        },
        "focus": {
          "targets": [
            {
              "ref": "focus-root",
              "sequential": true,
              "programmatic": true
            }
          ]
        },
        "a11y": null
      },
      "expect": {
        "status": "applied"
      }
    },
    {
      "op": "install",
      "transaction": {
        "protocolVersion": 0,
        "sessionId": "s1",
        "instanceId": "i2",
        "viewEpoch": 2,
        "commitId": 1,
        "template": null,
        "slots": {
          "slots": ["slot-default"]
        },
        "events": {
          "registrations": [
            {
              "leaseId": "l-b",
              "scope": "root",
              "type": "press.commit"
            }
          ]
        },
        "focus": {
          "targets": [
            {
              "ref": "focus-root",
              "sequential": true,
              "programmatic": true
            }
          ]
        },
        "a11y": null
      },
      "expect": {
        "status": "failed",
        "diagnosticCodes": ["instance-mismatch"]
      }
    },
    {
      "op": "snapshot",
      "expect": {
        "currentEpoch": 1,
        "leases": [
          {
            "leaseId": "l-a",
            "active": false,
            "released": false
          }
        ]
      }
    }
  ]
}
