{
  "name": "@proto.ui/module-feedback",
  "version": "0.3.0-alpha.1",
  "private": false,
  "type": "module",
  "dependencies": {
    "@proto.ui/core": "workspace:*",
    "@proto.ui/module-base": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internal/owned-slot": {
      "types": "./dist/material/owned-slot.d.ts",
      "import": "./dist/material/owned-slot.js",
      "default": "./dist/material/owned-slot.js"
    },
    "./internal/final-style-sink": {
      "types": "./dist/material/final-style-sink.d.ts",
      "import": "./dist/material/final-style-sink.js",
      "default": "./dist/material/final-style-sink.js"
    },
    "./internal/runtime-cap": {
      "types": "./dist/material/runtime-cap.d.ts",
      "import": "./dist/material/runtime-cap.js",
      "default": "./dist/material/runtime-cap.js"
    },
    "./internal/shared-policy": {
      "types": "./dist/material/shared-policy.d.ts",
      "import": "./dist/material/shared-policy.js",
      "default": "./dist/material/shared-policy.js"
    }
  },
  "description": "Proto UI module that provides feedback capability for adapters.",
  "license": "MIT",
  "homepage": "https://github.com/Proto-UI/Proto-UI/tree/main/packages/modules/feedback",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Proto-UI/Proto-UI.git",
    "directory": "packages/modules/feedback"
  },
  "bugs": {
    "url": "https://github.com/Proto-UI/Proto-UI/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "proto-ui",
    "proto",
    "ui",
    "module",
    "feedback"
  ],
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../../scripts/build/public-packages.mjs --package @proto.ui/module-feedback",
    "prepack": "pnpm run build"
  }
}
