{
  "name": "@proto.ui/module-presence",
  "version": "0.3.0-alpha.0",
  "private": false,
  "type": "module",
  "dependencies": {
    "@proto.ui/core": "workspace:*",
    "@proto.ui/types": "workspace:*",
    "@proto.ui/module-base": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "description": "Proto UI module that provides structural presence governance for adapters.",
  "license": "MIT",
  "homepage": "https://github.com/Proto-UI/Proto-UI/tree/main/packages/modules/presence",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Proto-UI/Proto-UI.git",
    "directory": "packages/modules/presence"
  },
  "bugs": {
    "url": "https://github.com/Proto-UI/Proto-UI/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "proto-ui",
    "proto",
    "ui",
    "module",
    "presence",
    "transition"
  ],
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../../scripts/build/public-packages.mjs --package @proto.ui/module-presence",
    "prepack": "pnpm run build"
  }
}
