{
  "name": "@proto.ui/cli",
  "version": "0.3.0-alpha.0",
  "private": false,
  "type": "module",
  "bin": {
    "proto-ui": "bin/proto-ui.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md"
  ],
  "dependencies": {
    "prompts": "^2.4.2",
    "typescript": "^5.0.0"
  },
  "description": "Proto UI command line tooling for initialization, component facade generation, and style presets.",
  "license": "MIT",
  "homepage": "https://github.com/Proto-UI/Proto-UI/tree/main/packages/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Proto-UI/Proto-UI.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Proto-UI/Proto-UI/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "proto-ui",
    "proto",
    "ui",
    "cli"
  ],
  "scripts": {
    "build": "node ../../scripts/build/public-packages.mjs --package @proto.ui/cli",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/prompts": "^2.4.9"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}
