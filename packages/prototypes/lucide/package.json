{
  "name": "@proto.ui/prototypes-lucide",
  "version": "0.3.0-alpha.0",
  "private": false,
  "type": "module",
  "protoUi": {
    "release": {
      "thirdPartyNotices": [
        "THIRD_PARTY_NOTICES.md"
      ]
    }
  },
  "dependencies": {
    "@proto.ui/core": "workspace:*",
    "lucide-static": "^1.8.0"
  },
  "scripts": {
    "generate:icons": "node ./scripts/generate-icons.mjs",
    "build": "node ../../../scripts/build/public-packages.mjs --package @proto.ui/prototypes-lucide",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@proto.ui/runtime": "workspace:*",
    "prettier": "^3.8.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js",
      "default": "./dist/icons/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js",
      "default": "./dist/icons/*.js"
    },
    "./manifest": {
      "types": "./dist/manifest.generated.d.ts",
      "import": "./dist/manifest.generated.js",
      "default": "./dist/manifest.generated.js"
    },
    "./snippets": {
      "types": "./dist/snippets.generated.d.ts",
      "import": "./dist/snippets.generated.js",
      "default": "./dist/snippets.generated.js"
    },
    "./loaders": {
      "types": "./dist/loaders.generated.d.ts",
      "import": "./dist/loaders.generated.js",
      "default": "./dist/loaders.generated.js"
    },
    "./all": {
      "types": "./dist/icons/index.generated.d.ts",
      "import": "./dist/icons/index.generated.js",
      "default": "./dist/icons/index.generated.js"
    }
  },
  "description": "Lucide-based Proto UI icon prototype library and svg render helpers.",
  "license": "MIT",
  "homepage": "https://github.com/Proto-UI/Proto-UI/tree/main/packages/prototypes/lucide",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Proto-UI/Proto-UI.git",
    "directory": "packages/prototypes/lucide"
  },
  "bugs": {
    "url": "https://github.com/Proto-UI/Proto-UI/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "proto-ui",
    "proto",
    "ui",
    "prototypes",
    "lucide",
    "prototype-library",
    "icon",
    "svg"
  ],
  "files": [
    "dist/",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ]
}
