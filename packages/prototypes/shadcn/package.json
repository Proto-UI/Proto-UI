{
  "name": "@proto.ui/prototypes-shadcn",
  "version": "0.3.0-alpha.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "protoUi": {
    "release": {
      "thirdPartyNotices": [
        "THIRD_PARTY_NOTICES.md"
      ]
    }
  },
  "dependencies": {
    "@proto.ui/core": "workspace:*",
    "@proto.ui/prototypes-base": "workspace:*"
  },
  "devDependencies": {
    "@proto.ui/module-as-trigger": "workspace:*",
    "@proto.ui/module-event": "workspace:*",
    "@proto.ui/module-expose-event": "workspace:*",
    "@proto.ui/module-rule-meta": "workspace:*",
    "@proto.ui/runtime": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js",
      "default": "./dist/button/index.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox/index.d.ts",
      "import": "./dist/checkbox/index.js",
      "default": "./dist/checkbox/index.js"
    },
    "./component-presets": {
      "types": "./dist/component-presets.d.ts",
      "import": "./dist/component-presets.js",
      "default": "./dist/component-presets.js"
    },
    "./dialog": {
      "types": "./dist/dialog/index.d.ts",
      "import": "./dist/dialog/index.js",
      "default": "./dist/dialog/index.js"
    },
    "./dropdown": {
      "types": "./dist/dropdown/index.d.ts",
      "import": "./dist/dropdown/index.js",
      "default": "./dist/dropdown/index.js"
    },
    "./hover-card": {
      "types": "./dist/hover-card/index.d.ts",
      "import": "./dist/hover-card/index.js",
      "default": "./dist/hover-card/index.js"
    },
    "./select": {
      "types": "./dist/select/index.d.ts",
      "import": "./dist/select/index.js",
      "default": "./dist/select/index.js"
    },
    "./separator": {
      "types": "./dist/separator/index.d.ts",
      "import": "./dist/separator/index.js",
      "default": "./dist/separator/index.js"
    },
    "./switch": {
      "types": "./dist/switch/index.d.ts",
      "import": "./dist/switch/index.js",
      "default": "./dist/switch/index.js"
    },
    "./tabs": {
      "types": "./dist/tabs/index.d.ts",
      "import": "./dist/tabs/index.js",
      "default": "./dist/tabs/index.js"
    },
    "./textarea": {
      "types": "./dist/textarea/index.d.ts",
      "import": "./dist/textarea/index.js",
      "default": "./dist/textarea/index.js"
    },
    "./toggle": {
      "types": "./dist/toggle/index.d.ts",
      "import": "./dist/toggle/index.js",
      "default": "./dist/toggle/index.js"
    }
  },
  "description": "shadcn-style Proto UI prototype library for adapter-driven components.",
  "license": "MIT",
  "homepage": "https://github.com/Proto-UI/Proto-UI/tree/main/packages/prototypes/shadcn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Proto-UI/Proto-UI.git",
    "directory": "packages/prototypes/shadcn"
  },
  "bugs": {
    "url": "https://github.com/Proto-UI/Proto-UI/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "proto-ui",
    "proto",
    "ui",
    "prototypes",
    "shadcn",
    "prototype-library",
    "shadcn-style"
  ],
  "files": [
    "dist/",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node ../../../scripts/build/public-packages.mjs --package @proto.ui/prototypes-shadcn",
    "prepack": "pnpm run build"
  }
}
