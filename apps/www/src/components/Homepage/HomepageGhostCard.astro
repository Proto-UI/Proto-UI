---
import LibraryCardPart from '../LibraryCardPart.astro';
import { homepageGhostThemeCss } from './homepage-ghost-theme';
import { panelSurfaceLayout, panelSurfaceProps } from '../surface-recipes';
interface Props {
  tall?: boolean;
}
const { tall = false } = Astro.props;
const families = ['shadcn', 'brutalist', 'bootstrap-2-3-2'] as const;
const colorSchemes = ['light', 'dark'] as const;
---

<!-- Passive continuation, not a loading state or simulated interactive demo.
     Public family parts own the same outer paint/anatomy as the real cards. -->
<style is:inline set:html={homepageGhostThemeCss()}></style>
<div class:list={['ghost-card', { 'ghost-card--tall': tall }]}>
  {
    families.map((family) => (
      <div class="ghost-card__family" data-ghost-family={family} data-home-ghost-theme={family}>
        {family === 'shadcn' ? (
          colorSchemes.map((colorScheme) => (
            <div class="ghost-card__scheme" data-home-ghost-scheme={colorScheme}>
              <LibraryCardPart
                part="shadcn-card"
                props={{ styleProfile: 'rhea' }}
                colorScheme={colorScheme}
              >
                <LibraryCardPart part="shadcn-header" props={{ styleProfile: 'rhea' }}>
                  <span class="ghost-card__line ghost-card__title" />
                  <span class="ghost-card__line" />
                </LibraryCardPart>
                <LibraryCardPart part="shadcn-content" props={{ styleProfile: 'rhea' }}>
                  <div class="ghost-card__body">
                    <span class="ghost-card__media" />
                    <span class="ghost-card__line" />
                  </div>
                </LibraryCardPart>
              </LibraryCardPart>
            </div>
          ))
        ) : (
          <LibraryCardPart
            part={`${family}-surface`}
            props={panelSurfaceProps('card')}
            layout={{ ...panelSurfaceLayout, padding: '1.25rem' }}
          >
            <div class="ghost-card__body">
              <span class="ghost-card__line ghost-card__title" />
              <span class="ghost-card__line" />
              <span class="ghost-card__media" />
              <span class="ghost-card__line" />
            </div>
          </LibraryCardPart>
        )}
      </div>
    ))
  }
</div>

<style>
  .ghost-card {
    min-width: 0;
  }
  .ghost-card__family {
    display: none;
  }
  /* Family identity changes only with the existing successful page commit.
     Shadcn is the homepage's no-script/default family, not a failed-swap fallback. */
  :global(html:not([data-site-library-family])) .ghost-card__family[data-ghost-family='shadcn'],
  :global(html[data-site-library-family='shadcn']) .ghost-card__family[data-ghost-family='shadcn'],
  :global(html[data-site-library-family='brutalist'])
    .ghost-card__family[data-ghost-family='brutalist'],
  :global(html[data-site-library-family='bootstrap-2-3-2'])
    .ghost-card__family[data-ghost-family='bootstrap-2-3-2'] {
    display: block;
  }
  /* Select complete public recipe endpoints even before JavaScript starts. */
  .ghost-card__scheme[data-home-ghost-scheme='dark'] {
    display: none;
  }
  :global(html.dark) .ghost-card__scheme[data-home-ghost-scheme='light'],
  :global(html[data-theme='dark']) .ghost-card__scheme[data-home-ghost-scheme='light'] {
    display: none;
  }
  :global(html.dark) .ghost-card__scheme[data-home-ghost-scheme='dark'],
  :global(html[data-theme='dark']) .ghost-card__scheme[data-home-ghost-scheme='dark'] {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not(.light):not(.dark):not([data-theme='light']):not([data-theme='dark']))
      .ghost-card__scheme[data-home-ghost-scheme='light'] {
      display: none;
    }
    :global(html:not(.light):not(.dark):not([data-theme='light']):not([data-theme='dark']))
      .ghost-card__scheme[data-home-ghost-scheme='dark'] {
      display: block;
    }
  }
  .ghost-card__body {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }
  /* Abstract content marks, deliberately not buttons, inputs or text labels. */
  .ghost-card__line,
  .ghost-card__media {
    display: block;
    background: currentColor;
    opacity: 0.12;
  }
  .ghost-card__line {
    width: 85%;
    height: 0.5rem;
  }
  .ghost-card__title {
    width: 55%;
    height: 0.875rem;
  }
  .ghost-card__media {
    width: 100%;
    height: 5rem;
  }
  .ghost-card--tall .ghost-card__media {
    height: 9rem;
  }
</style>
