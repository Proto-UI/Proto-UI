---
import '../../styles/global.css';
import SiteLibraryStyle from '../SiteLibraryStyle.astro';
import { resolveSiteLibraryFamily } from '../site-library-family';
const siteLibraryFamily = resolveSiteLibraryFamily(Astro.url.pathname);
import DocumentationImagePreview from '../DocumentationImagePreview.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<SiteLibraryStyle />
<DocumentationImagePreview />

<div
  data-site-family-scope
  data-site-library-family={siteLibraryFamily}
  class="site-page-frame bg-background text-foreground group/body overscroll-none font-sans antialiased [--footer-height:calc(var(--spacing)*14)] xl:[--footer-height:calc(var(--spacing)*24)]"
>
  <script>
    import '../../scripts/proto-concept';
  </script>
  <div
    class:list={[
      'bg-background container-wrapper flex flex-1 flex-col',
      { 'docs-shell': hasSidebar },
    ]}
  >
    <header class="bg-background sticky top-0 z-50 w-full"><slot name="header" /></header>
    <noscript>
      <style is:inline>
        /* Without measurements, keep document navigation in normal flow so
           enlarged headings cannot scroll behind an estimated sticky header. */
        .site-page-frame > .container-wrapper > header:has([data-docs-site-header]) {
          position: static !important;
        }
        @media (max-width: 63.999rem) {
          [data-page-frame-layout] {
            flex-direction: column !important;
          }

          .docs-sidebar {
            width: 100% !important;
          }

          .mobile-sidebar-pane {
            position: static !important;
            inset: auto !important;
            display: flex !important;
            width: 100% !important;
            max-height: min(60svh, 32rem);
            border-bottom: 1px solid var(--color-border);
          }

          .main-frame {
            width: 100% !important;
          }

          [data-site-contents-command] {
            display: none !important;
          }
        }
      </style>
    </noscript>
    <div
      data-page-frame-layout
      class="bg-background group/sidebar-wrapper has-data-[variant=inset]:bg-sidebar flex min-w-0 w-full 3xl:fixed:container 3xl:fixed:px-3 min-h-min flex-1 items-start px-0 [--sidebar-width:220px] [--top-spacing:0] lg:grid lg:grid-cols-[var(--sidebar-width)_minmax(0,1fr)] lg:[--sidebar-width:15rem] lg:[--top-spacing:calc(var(--spacing)*4)]"
    >
      {
        hasSidebar && (
          <>
            <nav
              class="docs-sidebar text-sidebar-foreground"
              aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}
            >
              <div id="starlight__sidebar" class="mobile-sidebar-pane sidebar-pane">
                <div class="mobile-sidebar-content sidebar-content sl-flex">
                  <slot name="sidebar" />
                </div>
              </div>
            </nav>
            <div class="main-frame min-w-0 w-full">
              <slot />
            </div>
          </>
        )
      }
    </div>
    {
      !hasSidebar && (
        <>
          <div class="main-frame min-w-0 w-full">
            <slot />
          </div>
        </>
      )
    }
  </div>
</div>

<script>
  import { applySiteLibraryFamily, resolveSiteLibraryFamily } from '../site-library-family';
  const syncLibraryRoute = () =>
    applySiteLibraryFamily(document, resolveSiteLibraryFamily(location.pathname));
  syncLibraryRoute();
  document.addEventListener('astro:page-load', syncLibraryRoute);

  import { initSiteSidebarCurrentVisibility } from '../site-sidebar-current-visibility';
  const revealCurrentArticle = () => initSiteSidebarCurrentVisibility(document);
  revealCurrentArticle();
  document.addEventListener('astro:page-load', revealCurrentArticle);

  import { initSiteContentsNavigation } from '../site-header-disclosure';
  const initializeContents = () => initSiteContentsNavigation(document);
  initializeContents();
  document.addEventListener('astro:page-load', initializeContents);
</script>

<style>
  .site-page-frame {
    --header-height: 4rem;
    --sl-nav-height: var(--header-height);
  }
  @media (max-width: 68.749rem) {
    .site-page-frame {
      --header-height: 7rem;
    }
  }
  @media (max-width: 47.999rem) {
    .site-page-frame {
      --header-height: 3.5rem;
    }
  }
  :global(.site-page-frame > .container-wrapper > header:has([data-site-header])) {
    container: docs-page / inline-size;
  }
  /* Our measured Header margin owns anchor clearance for every native main
     target, including PageTitle and legacy anchors outside MarkdownContent.
     Starlight root padding would otherwise add a second header offset. */
  :global(html:has(.site-page-frame [data-docs-site-header])) {
    scroll-padding-top: 0;
  }
  :global(.site-page-frame:has([data-docs-site-header]) main [id]) {
    scroll-margin-top: calc(var(--header-height) + 1rem);
  }
  /* The page-top fragment should preserve the same reading inset as a page
     without a fragment. Native fragment scrolling can run after deferred
     modules load; section clearance (1rem) would otherwise scroll the whole
     document up by 8px/16px despite unchanged layout. Keep this tied to the
     responsive reading padding rather than introducing a scroll correction.
     Splash pages have no docs inset and retain their original 1rem clearance. */
  :global(.site-page-frame:has([data-docs-site-header]) main h1[data-site-typography='h1']) {
    scroll-margin-top: calc(var(--header-height) + var(--docs-reading-inset, 1rem));
  }
  /* Keep the header and all three documentation columns on one centered canvas. */
  .docs-shell {
    container: docs-canvas / inline-size;
    max-width: 85rem;
    margin-inline: auto;
  }

  .docs-sidebar {
    width: 0;
    flex: none;
  }

  .mobile-sidebar-pane {
    position: fixed;
    z-index: 40;
    inset: var(--header-height) 0 0;
    display: none;
    width: 100%;
    padding: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-background);
  }

  :global([data-mobile-menu-expanded]) .mobile-sidebar-pane {
    display: flex;
  }

  @media (max-width: 63.999rem) {
    :global(body[data-mobile-menu-expanded]) {
      overflow: hidden;
    }
  }

  .mobile-sidebar-content {
    width: 100%;
    min-height: max-content;
    padding: 1rem var(--sl-sidebar-pad-x, 1rem) 2rem;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 64rem) {
    .docs-sidebar {
      position: sticky;
      z-index: 30;
      top: calc(var(--header-height) + 1px);
      display: flex;
      width: var(--sidebar-width);
      height: calc(100svh - var(--header-height) - 1px);
      flex-direction: column;
      overflow-y: auto;
      background: transparent;
      scrollbar-width: none;
    }

    .mobile-sidebar-pane {
      position: static;
      z-index: auto;
      display: flex;
      width: var(--sidebar-width);
      padding-block: 1rem 3rem;
      overflow: visible;
      background: transparent;
    }

    .mobile-sidebar-content {
      padding: 0;
    }
  }
</style>
