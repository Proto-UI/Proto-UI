---
import project from 'virtual:starlight/project-context';
import { localizedUrl } from '../../utils/localizedUrl';
import { resolveSiteLibraryFamily } from '../site-library-family';
import { siteSearchShortcutLabel } from '../site-search-shortcut';
import { headerResponsiveButtonFeedback } from '../site-header-control-recipes';
import StaticLucideIcon from '../StaticLucideIcon.astro';
import { renderSnapshotTokenCss } from '../snapshot-prototype-style';
import { snapshotStartupStyle, startupButtonProps } from '../site-startup-paint';

const documentationUrl = localizedUrl(
  new URL('/ui-libraries/', Astro.url),
  Astro.locals.starlightRoute.locale || 'en',
  project.trailingSlash
).pathname;
const family = resolveSiteLibraryFamily(Astro.url.pathname);
const startupTokens = await snapshotStartupStyle(`${family}-button`, {
  ...startupButtonProps(family, 'default'),
  disabled: true,
});

const isChinese = (Astro.locals.starlightRoute.locale || 'en').toLowerCase().startsWith('zh');
const loadingLabel = isChinese ? '正在加载搜索…' : 'Loading search…';
const copy = {
  title: Astro.locals.t('search.label'),
  description: isChinese ? '搜索全部文档并打开结果' : 'Search all documentation and open a result',
  placeholder: isChinese ? '搜索文档…' : 'Search documentation…',
  pages: isChinese ? '页面' : 'Pages',
  results: isChinese ? '搜索结果' : 'Search results',
  goToPage: isChinese ? '打开页面' : 'Go to page',
  hint: isChinese ? '输入关键词搜索全部文档' : 'Search across all documentation',
  loading: loadingLabel,
  empty: isChinese ? '未找到结果' : 'No results found',
  error: isChinese ? '搜索暂不可用，请重试' : 'Search is unavailable. Try again.',
  retry: isChinese ? '重试' : 'Retry',
  more: isChinese ? '加载更多结果' : 'Load more results',
  close: Astro.locals.t('search.cancelLabel'),
  count: isChinese ? '{count} 条匹配文档' : '{count} matching documents',
};
// Real destinations already used by the site Header; these are navigation,
// never fake search hits, and stay available if the data engine is unavailable.
const navigation = [
  { title: isChinese ? '首页' : 'Home', href: '/' },
  { title: isChinese ? '文档' : 'Docs', href: '/start-here/what-you-saw/' },
  { title: isChinese ? '组件库' : 'Libraries', href: '/ui-libraries/' },
  { title: isChinese ? '白皮书' : 'Whitepaper', href: '/whitepaper/0-preface/' },
].map((entry) => ({
  ...entry,
  href: localizedUrl(
    new URL(entry.href, Astro.url),
    Astro.locals.starlightRoute.locale || 'en',
    project.trailingSlash
  ).pathname,
}));
const bundlePath = import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/';
---

<site-search
  class={Astro.props.class}
  data-search-composition="command-dialog"
  data-search-style="rhea"
  data-search-copy={JSON.stringify(copy)}
  data-search-navigation={JSON.stringify(navigation)}
  data-pagefind-bundle={bundlePath}
  data-strip-trailing-slash={project.trailingSlash === 'never' ? '' : undefined}
  data-search-initial-family={family}
  data-open-label={Astro.locals.t('search.label')}
  data-close-label={Astro.locals.t('search.cancelLabel')}
  data-retry-label={copy.retry}
  data-ctrl-label={Astro.locals.t('search.ctrlKey')}
>
  <style is:inline set:html={renderSnapshotTokenCss(startupTokens, '[data-search-startup-button]')}
  ></style>
  <div data-search-startup>
    <button
      type="button"
      disabled
      aria-disabled="true"
      data-search-startup-button
      style={headerResponsiveButtonFeedback()}
      data-site-control-family={family}
      data-pui-style={startupTokens.join(' ')}
      aria-label={loadingLabel}
      title={loadingLabel}
    >
      <span aria-hidden="true"><StaticLucideIcon name="search" size="16px" /></span>
      <span class="sr-only">{loadingLabel}</span>
      <span aria-hidden="true" class="site-search-label sl-hidden md:sl-block"
        >{Astro.locals.t('search.label')}</span
      >
      <span aria-hidden="true" class="site-search-shortcut sl-hidden md:sl-flex"
        >{siteSearchShortcutLabel(Astro.locals.t('search.ctrlKey'))}</span
      >
    </button>
  </div>
  <div data-search-composition-mount>
    <div data-search-command-mount="open"></div><div data-search-dialog-mount></div>
  </div>
  <noscript
    ><a href={documentationUrl}>{isChinese ? '浏览文档' : 'Browse documentation'}</a></noscript
  >
</site-search>

<script>
  import {
    searchCommandParticipant,
    initDocumentationSearchCommands,
  } from '../site-search-commands';

  class SiteSearch extends HTMLElement {
    private cleanup?: () => void;
    private refreshCommands?: () => unknown;
    connectedCallback() {
      if (this.cleanup) {
        this.refreshCommands?.();
        return;
      }
      const commands = searchCommandParticipant(this);
      const docs = this.closest('[data-homepage-runtime]')
        ? null
        : initDocumentationSearchCommands(commands);
      this.refreshCommands = () => docs?.refresh();
      // Website accelerator opens the public Dialog. Escape, focus containment,
      // outside dismissal and restoration are owned by its public primitives.
      const onKeydown = (event: KeyboardEvent) => {
        if (event.defaultPrevented || event.isComposing || event.altKey) return;
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          commands.toggle();
        }
      };
      const onBeforeSwap = () => this.cleanup?.();
      window.addEventListener('keydown', onKeydown);
      document.addEventListener('astro:before-swap', onBeforeSwap);
      this.cleanup = () => {
        this.cleanup = undefined;
        this.refreshCommands = undefined;
        window.removeEventListener('keydown', onKeydown);
        document.removeEventListener('astro:before-swap', onBeforeSwap);
        commands.dispose();
        void docs
          ?.destroy()
          .catch((error) =>
            console.error('[SiteSearch] public composition cleanup failed.', error)
          );
      };
    }
    disconnectedCallback() {
      this.cleanup?.();
    }
  }
  if (!customElements.get('site-search')) customElements.define('site-search', SiteSearch);
</script>

<style>
  @layer starlight.core {
    site-search {
      display: contents;
    }
  }
</style>
