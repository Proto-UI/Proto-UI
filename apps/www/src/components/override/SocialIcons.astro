---
import links from '../../../../../shared/links.json';
import HomeActions from '../Homepage/HomeActions.astro';
import { SITE_LINK_ICONS, type SiteLinkIcon } from '../../prototypes/site-link-icons';
import '../../styles/site-native-links.css';
const isHomepage = /^(?:\/(?:en|zh-cn))?\/?$/.test(Astro.url.pathname);
const entries = (Object.keys(SITE_LINK_ICONS) as SiteLinkIcon[]).map((icon) => ({
  siteIcon: icon,
  text: SITE_LINK_ICONS[icon].label,
  link: links[icon],
  variant: 'secondary' as const,
  attrs: {
    target: '_blank',
    rel: 'noreferrer',
    'aria-label': SITE_LINK_ICONS[icon].label,
    title: SITE_LINK_ICONS[icon].label,
  },
}));
---

{
  isHomepage ? (
    <HomeActions id="home-social" actions={entries} />
  ) : (
    <div class="site-social-links">
      {entries.map(({ siteIcon: icon, link, attrs }) => (
        <a
          {...attrs}
          href={link}
          class="site-native-link"
          data-site-native-link
          data-site-link-appearance="icon"
          data-site-link-icon={icon}
        >
          <svg viewBox={SITE_LINK_ICONS[icon].viewBox} width="18" height="18" aria-hidden="true">
            <path fill="currentColor" d={SITE_LINK_ICONS[icon].path} />
          </svg>
        </a>
      ))}
    </div>
  )
}

<script>
  import { initSiteNativeControls } from '../site-native-controls';
  let release = () => {};
  const initialize = () => {
    release();
    release = initSiteNativeControls(document);
  };
  initialize();
  document.addEventListener('astro:page-load', initialize);
  document.addEventListener('astro:before-swap', () => release());
</script>
