---
/** 无前端变量输出，全部靠内联 JS 防 FOUC */
---

<meta name="color-scheme" content="light dark" />

{/* 提前设置 data-theme，避免 FOUC */}
<script is:inline>
  (function () {
    const KEY = 'starlight-theme';
    const mql = window.matchMedia('(prefers-color-scheme: light)');
    const getSystem = () => (mql.matches ? 'light' : 'dark');

    const normalizePreference = (value) =>
      value === 'light' || value === 'dark' || value === 'auto' ? value : 'auto';

    const loadPreference = () => {
      const value = typeof localStorage !== 'undefined' && localStorage.getItem(KEY);
      return normalizePreference(value || 'auto');
    };

    const resolveTheme = (preference) => (preference === 'auto' ? getSystem() : preference);

    const storePreference = (preference) => {
      try {
        localStorage.setItem(KEY, preference === 'auto' ? '' : preference);
      } catch (e) {}
    };

    const apply = (t) => {
      document.documentElement.dataset.theme = t;
      // 给 chrome/safari 一个暗色介面提示（和 meta 协同）
      document.documentElement.style.colorScheme = t;
    };

    const updatePickers = (preference = loadPreference()) => {
      document.querySelectorAll('starlight-theme-select').forEach((picker) => {
        const select = picker.querySelector('select');
        if (select) select.value = preference;

        const tmpl =
          document.querySelector('#theme-icons') ||
          document.querySelector('#starlight-theme-icons');
        const iconName = preference === 'auto' ? resolveTheme(preference) : preference;
        const newIcon = tmpl && tmpl.content.querySelector('.' + iconName);
        const oldIcon = picker.querySelector('svg.label-icon');
        if (newIcon && oldIcon) {
          oldIcon.replaceChildren(...newIcon.cloneNode(true).childNodes);
        }
      });
    };

    const setPreference = (preference) => {
      const nextPreference = normalizePreference(preference);
      const theme = resolveTheme(nextPreference);
      storePreference(nextPreference);
      apply(theme);
      updatePickers(nextPreference);
      document.dispatchEvent(
        new CustomEvent('starlight-theme:change', { detail: { theme, preference: nextPreference } })
      );
    };

    // 初始化（若无存储，则跟随系统）
    apply(resolveTheme(loadPreference()));

    window.StarlightThemeProvider = {
      updatePickers,
    };

    // 供其它组件调用的轻量全局单例
    window.StarlightTheme = {
      get() {
        // 返回实际应用中的主题（此实现下与存储一致）
        return document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
      },
      set(theme /* 'light' | 'dark' */) {
        setPreference(theme === 'light' ? 'light' : 'dark');
      },
      toggle() {
        this.set(this.get() === 'light' ? 'dark' : 'light');
      },
      // 让选择器控件在挂载时就能对齐当前主题/图标
      hydratePickers() {
        updatePickers(loadPreference());
        document.dispatchEvent(new CustomEvent('starlight-theme:hydrate'));
      },
    };

    // 如果恰好监听到了主题切换，那么随系统切换主题
    mql.addEventListener('change', () => {
      if (loadPreference() === 'auto') setPreference('auto');
    });
  })();
</script>

{/* 图标模板（与原始的两个 SVG 兼容，可直接引用类名 .light / .dark） */}
<template id="starlight-theme-icons">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="size-4.5 light"
  >
    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
    <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
    <path d="M12 3l0 18"></path>
    <path d="M12 9l4.65 -4.65"></path>
    <path d="M12 14.3l7.37 -7.37"></path>
    <path d="M12 19.6l8.85 -8.85"></path>
  </svg>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="size-4.5 dark rotate-180"
  >
    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
    <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
    <path d="M12 3l0 18"></path>
    <path d="M12 9l4.65 -4.65"></path>
    <path d="M12 14.3l7.37 -7.37"></path>
    <path d="M12 19.6l8.85 -8.85"></path>
  </svg>
</template>
