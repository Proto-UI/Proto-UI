---
import { resolveSiteLibraryFamily, siteControlTags } from '../site-library-family';
const family = resolveSiteLibraryFamily(Astro.url.pathname);
const { SelectRoot, SelectTrigger, SelectValue, SelectContent, SelectItem } =
  siteControlTags(family);
interface Props {
  id?: string;
  brutalistTriggerAppearance?: 'flat' | 'elevated';
}

const { id = 'adapter-select', brutalistTriggerAppearance } = Astro.props;
const labelId = `${id}-label-${Math.random().toString(36).slice(2)}`;

// 适配器选项
const options = [
  { value: 'wc', label: 'Web Components' },
  { value: 'react', label: 'React' },
  { value: 'vue', label: 'Vue' },
  { value: 'vue2', label: 'Vue 2' },
];
---

<div class="adapter-select-wrapper relative inline-flex items-center" data-adapter-select>
  <span id={labelId} class="sr-only">选择适配器</span>
  <SelectRoot
    data-site-control-family={family}
    id={id}
    data-site-select-root
    data-adapter-select-root
    data-site-initial-value="wc"
  >
    <SelectTrigger
      data-site-select-trigger
      aria-labelledby={labelId}
      data-size="sm"
      data-appearance={family === 'brutalist' ? brutalistTriggerAppearance : undefined}
      class="adapter-select"
    >
      <SelectValue data-placeholder="选择适配器">Runtime</SelectValue>
    </SelectTrigger>
    <SelectContent
      data-site-select-content
      data-site-control-family={family}
      data-position="popper"
      data-align="end"
    >
      {
        options.map((opt) => (
          <SelectItem data-value={opt.value} data-text-value={opt.label}>
            {opt.label}
          </SelectItem>
        ))
      }
    </SelectContent>
  </SelectRoot>
  <script>
    import { initSiteControls } from '../site-shadcn-controls';
    import { initAdapterSelects } from '../adapter-preference';

    initSiteControls(document);
    initAdapterSelects(document);
    document.addEventListener('astro:page-load', () => {
      initSiteControls(document);
      initAdapterSelects(document);
    });
  </script>
</div>

<style>
  .adapter-select-wrapper {
    min-width: 0;
    width: min(12rem, 100%);
    max-width: 100%;
  }
  .adapter-select-wrapper [data-site-select-root] {
    display: inline-flex;
  }

  .adapter-select-wrapper [data-site-select-trigger] {
    min-width: min(12rem, 100%);
  }

  /* Keep server-rendered chrome compact until the custom elements upgrade so
     the projected option list never flashes inline in the header. */
  .adapter-select-wrapper [data-site-select-content]:not(:defined) {
    display: none;
  }
</style>
