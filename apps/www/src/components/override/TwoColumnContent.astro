---
const { hasSidebar, entry } = Astro.locals.starlightRoute;
const isSplash = entry.data.template === 'splash';
const mainPaneClass = isSplash
  ? 'main-pane mx-auto flex w-full max-w-[88rem] min-w-0 flex-1 flex-col gap-8 px-1 py-6 text-foreground md:px-6 lg:gap-10 lg:py-10'
  : 'main-pane mx-auto flex w-full max-w-[var(--docs-reading-width,42rem)] min-w-0 flex-1 flex-col gap-8 px-0 [--docs-reading-inset:1.5rem] py-[var(--docs-reading-inset)] text-neutral-800 md:px-0 lg:[--docs-reading-inset:2rem] dark:text-neutral-200';
---

<div class="docs-reading-columns lg:sl-flex" data-layout={isSplash ? 'splash' : 'docs'}>
  {
    Astro.locals.starlightRoute.toc && (
      <aside class="right-sidebar-container print:hidden">
        <div class="right-sidebar">
          <slot name="right-sidebar" />
        </div>
      </aside>
    )
  }
  <div
    class={mainPaneClass}
    data-layout={isSplash ? 'splash' : 'docs'}
    data-has-sidebar={hasSidebar}
  >
    <slot />
  </div>
</div>

<style>
  .main-pane {
    isolation: isolate;
  }

  /* The middle reading measure is independent of the two edge rails. This
     replaces legacy viewport-minus-sidebar arithmetic with real grid tracks. */
  @media (min-width: 80rem) {
    .docs-reading-columns[data-layout='docs'] {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: var(--docs-column-gap, 1.5rem);
      width: 100%;
      min-width: 0;
    }
    .docs-reading-columns[data-layout='docs']:has(> .right-sidebar-container) {
      grid-template-columns: minmax(0, 1fr) var(--docs-toc-width, 18rem);
    }
    .docs-reading-columns[data-layout='docs'] > .main-pane {
      grid-column: 1;
      grid-row: 1;
      order: 1;
      width: 100%;
      max-width: var(--docs-reading-width, 42rem);
      justify-self: center;
    }
    .docs-reading-columns[data-layout='docs'] > .right-sidebar-container {
      grid-column: 2;
      grid-row: 1;
      order: 2;
      display: flex;
      position: sticky;
      top: calc(var(--header-height) + 1px);
      width: 100%;
      min-width: 0;
      height: calc(100svh - var(--header-height) - 1px);
      overflow-y: auto;
      padding-bottom: 1rem;
    }
    .docs-reading-columns[data-layout='docs'] .right-sidebar {
      position: static;
      width: 100%;
      min-width: 0;
      height: auto;
      padding-block: 0;
      overflow: visible;
    }
    .docs-reading-columns[data-layout='docs']
      .right-sidebar
      :global(.right-sidebar-panel .sl-container) {
      width: 100%;
      max-width: none;
      min-width: 0;
    }
  }
</style>

<style>
  /* Viewport media queries use the initial font size. The actual reading canvas
     must also respond to enlarged root text, before the old column arithmetic
     compresses the TOC into individual letters. Use the existing 72rem column
     budget in root-relative canvas space: an 80rem container limit overlaps
     the normal 80rem viewport because docs-shell has inline padding. Keep the
     same native TOC in normal flow without a duplicate or new disclosure. */
  @media (min-width: 80rem) {
    @container docs-canvas (max-width: 72rem) {
      .docs-reading-columns[data-layout='docs'] {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        width: 100%;
        gap: 1rem;
      }
      .docs-reading-columns[data-layout='docs'] > .right-sidebar-container {
        display: flex;
        position: static;
        order: 0;
        width: 100%;
        min-width: 0;
        flex: none;
        align-self: stretch;
        height: auto;
        padding-bottom: 0;
        overflow: visible;
      }
      .docs-reading-columns[data-layout='docs'] .right-sidebar {
        position: static;
        width: 100%;
        min-width: 0;
        flex: none;
        align-self: stretch;
        height: auto;
        padding-block: 0;
        overflow: visible;
      }
      .right-sidebar :global(sl-toc),
      .right-sidebar :global(sl-toc nav) {
        display: block;
        width: 100%;
        min-width: 0;
      }
      /* PageSidebar's slotted legacy container has a viewport-minus-rem
         quarter-width cap of its own. Reset that layout cap too, not just the
         outer Surface lane, so the actual native links gain the reading room. */
      .right-sidebar :global(.right-sidebar-panel .sl-container) {
        width: 100%;
        max-width: none;
        min-width: 0;
      }
      .docs-reading-columns[data-layout='docs'] > .main-pane {
        order: 1;
        width: 100%;
      }
    }
  }
</style>
