---
import config from 'virtual:starlight/user-config';
import context from 'virtual:starlight/project-context';
import { localizedUrl } from '../../utils/localizedUrl';
import SiteContentsCommand from '../SiteContentsCommand.astro';
import LanguageSelect from './LanguageSelect.astro';
import Search from './Search.astro';
import SiteTitle from './SiteTitle.astro';
import SocialIcons from './SocialIcons.astro';
import ThemeToggle from './ThemeToggle.astro';
import AdapterSelect from './AdapterSelect.astro';
import HomepageRuntime from '../Homepage/HomepageRuntime.astro';
import { resolveSiteLibraryFamily, siteControlTags } from '../site-library-family';
import '../../styles/site-header.css';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
const isHomepage = /^(?:\/(?:en|zh-cn))?\/?$/.test(Astro.url.pathname);
const currentLocale = Astro.locals.starlightRoute.locale || 'en';
const zh = currentLocale === 'zh-cn';
const localizedPath = (path: string) =>
  localizedUrl(new URL(path, Astro.url), currentLocale, context.trailingSlash).pathname;
const family = resolveSiteLibraryFamily(Astro.url.pathname);
const { Button } = siteControlTags(family);
const menuLabel = zh ? '导航与设置' : 'Navigation and settings';
const navigation = [
  { label: zh ? '文档' : 'Docs', href: localizedPath('/start-here/what-you-saw/') },
  { label: zh ? '组件库' : 'Libraries', href: localizedPath('/ui-libraries/') },
  { label: zh ? '白皮书' : 'Whitepaper', href: localizedPath('/whitepaper/0-preface/') },
];
---

{
  isHomepage ? (
    <HomepageRuntime>
      {shouldRenderSearch && <Search slot="search" />}
      <SocialIcons slot="social" />
    </HomepageRuntime>
  ) : (
    <div class="site-header" data-site-header data-docs-site-header>
      <div class="site-header-brand">
        <SiteTitle />
      </div>
      <nav
        class="site-header-navigation"
        data-site-header-desktop-navigation
        aria-label={zh ? '主导航' : 'Primary navigation'}
      >
        {navigation.map(({ label, href }) => (
          <a data-site-native-button href={href}>
            {label}
          </a>
        ))}
      </nav>
      <details class="site-header-panel" id="site-header-panel" data-site-header-panel>
        <summary
          data-site-header-fallback-summary
          aria-label={zh ? '导航与设置' : 'Navigation and settings'}
        >
          <span class="site-header-menu-icon" aria-hidden="true" />
        </summary>
        <div data-site-header-surface-mount />
        <div data-site-header-panel-content>
          <div data-site-header-panel-body>
            <nav
              class="site-header-navigation site-header-popup-navigation"
              data-site-header-navigation
              aria-label={zh ? '主导航' : 'Primary navigation'}
            >
              <span class="site-header-group-label">{zh ? '浏览' : 'Explore'}</span>
              {navigation.map(({ label, href }) => (
                <a data-site-native-button href={href}>
                  {label}
                </a>
              ))}
            </nav>
            <div data-site-header-compact-context>
              <div class="site-header-runtime" data-site-header-preferences>
                <span class="site-header-runtime-label">
                  {zh ? '预览 Runtime' : 'Preview runtime'}
                </span>
                <AdapterSelect brutalistTriggerAppearance="elevated" />
              </div>
            </div>
            <div class="site-header-settings" id="site-header-settings" data-site-header-settings>
              <span class="site-header-group-label">
                {zh ? '偏好与社区' : 'Preferences and community'}
              </span>
              <div class="site-header-setting">
                <span class="site-header-setting-label">{zh ? '语言' : 'Language'}</span>
                <LanguageSelect />
              </div>
              <div class="site-header-setting">
                <span class="site-header-setting-label">{zh ? '社区' : 'Community'}</span>
                <SocialIcons />
              </div>
            </div>
          </div>
        </div>
      </details>
      <div class="site-header-context" data-site-header-context data-site-header-wide-preferences>
        {Astro.locals.starlightRoute.hasSidebar && (
          <div
            class="site-header-docs-navigation"
            data-site-contents-label={zh ? '页面目录' : 'Page contents'}
          >
            <span aria-hidden="true">{zh ? '页面目录' : 'Contents'}</span>
            <SiteContentsCommand label={zh ? '页面目录' : 'Page contents'} />
          </div>
        )}
      </div>
      <div class="site-header-search">{shouldRenderSearch && <Search />}</div>
      <div class="site-header-theme">
        <ThemeToggle />
      </div>
      <div class="site-header-menu">
        <Button
          data-site-button
          data-site-control-family={family}
          data-site-menu-button
          data-variant={family === 'brutalist' ? 'surface' : 'ghost'}
          data-size="icon"
          aria-label={menuLabel}
          aria-expanded="false"
          aria-controls="site-header-panel"
          title={menuLabel}
        >
          <span class="site-header-menu-icon" aria-hidden="true" />
          <span class="sr-only">{menuLabel}</span>
        </Button>
      </div>
    </div>
  )
}

<script>
  import { initSiteControls } from '../site-shadcn-controls';
  import { initSiteHeaderDisclosure } from '../site-header-disclosure';
  import { initDocumentationHeaderSurface } from '../site-header-surface';
  const initialize = () => {
    document.querySelectorAll<HTMLElement>('[data-docs-site-header]').forEach((root) => {
      const button = root.querySelector<HTMLElement>('[data-site-menu-button]');
      if (!button || button.dataset.siteMenuBound === 'true') return;
      initSiteControls(root);
      const compact = window.matchMedia('(max-width: 47.999rem)');
      const syncAppearance = () => initSiteControls(root);
      compact.addEventListener('change', syncAppearance);
      const surface = initDocumentationHeaderSurface(root);
      const disclosure = initSiteHeaderDisclosure(root);
      const unbind = disclosure.bindButton(button);
      const onClick = (event: Event) => {
        if (event instanceof CustomEvent) disclosure.toggle();
      };
      button.addEventListener('click', onClick);
      button.dataset.siteMenuBound = 'true';
      disclosure.enhance();
      document.addEventListener(
        'astro:before-swap',
        () => {
          compact.removeEventListener('change', syncAppearance);
          void surface?.destroy();
          button.removeEventListener('click', onClick);
          unbind();
          delete button.dataset.siteMenuBound;
        },
        { once: true }
      );
    });
  };
  initialize();
  document.addEventListener('astro:page-load', initialize);
</script>
