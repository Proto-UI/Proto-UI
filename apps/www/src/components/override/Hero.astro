---
import HomeActions from '../Homepage/HomeActions.astro';
import { PAGE_TITLE_ID } from '../../constants';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const locale = Astro.locals.starlightRoute.locale;
const whitepaperHref =
  locale && locale !== 'root' ? `/${locale}/whitepaper/0-preface/` : '/whitepaper/0-preface/';
const whitepaperLabel =
  locale === 'zh-cn'
    ? '我们还要发明多少次 Button？'
    : 'How many more times must we reinvent the Button?';
---

<section class="homepage-hero" aria-labelledby={PAGE_TITLE_ID}>
  <HomeActions
    id="homepage-whitepaper"
    class="homepage-hero__eyebrow"
    actions={[
      { text: whitepaperLabel, link: whitepaperHref, variant: 'minimal', icon: 'arrow-right' },
    ]}
  />
  <h1 id={PAGE_TITLE_ID} data-page-title data-site-typography="slogan" set:html={title} />
  {
    tagline && (
      <p data-site-typography="tagline" class="homepage-hero__tagline" set:html={tagline} />
    )
  }
  {
    actions.length > 0 && (
      <HomeActions
        id="homepage-hero-actions"
        appearance="action"
        class="homepage-hero__actions"
        actions={actions}
      />
    )
  }
</section>

<style>
  .homepage-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 56rem;
    margin-inline: auto;
    padding: 1.5rem 0 0;
    text-align: center;
  }
  .homepage-hero :global(.homepage-hero__eyebrow) {
    margin-bottom: 0.5rem;
  }
  .homepage-hero :global(.homepage-hero__eyebrow .home-runtime-anchor),
  .homepage-hero :global(.homepage-hero__eyebrow .home-actions-fallback a) {
    padding: 0;
    min-height: 1.5rem;
    white-space: normal;
    text-wrap: balance;
  }
  .homepage-hero h1 {
    max-width: 100%;
    margin: 0;
    text-wrap: balance;
  }
  .homepage-hero h1:lang(zh) {
    max-width: 18em;
  }
  .homepage-hero__tagline {
    max-width: 56rem;
    margin: 0.5rem 0 0;
    text-wrap: balance;
  }
  .homepage-hero :global(.homepage-hero__actions) {
    width: 100%;
    margin-top: 1rem;
  }
  .homepage-hero :global(.homepage-hero__actions .home-runtime-actions),
  .homepage-hero :global(.homepage-hero__actions .home-actions-fallback) {
    justify-content: center;
    gap: 0.5rem;
  }
  /* Only size the native owner here; its passive Link Prototype owns paint,
     typography and wrapping. Use the real projected anchor class. */
  .homepage-hero :global(.homepage-hero__actions .home-runtime-link) {
    max-width: 100%;
    min-width: 0;
  }
  /* Fixed upstream page-header composition, preserving authored text/hrefs.
     https://github.com/shadcn-ui/ui/blob/3d98900e9b73c45f035f8109e9d41ba6a51685e7/apps/v4/components/page-header.tsx
     Native fallback only. Enhanced Text paint is owned by public recipes. */
  :global([data-site-library-family='shadcn']) .homepage-hero h1:not([data-typography-owner]) {
    font-size: 1.875rem;
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  :global([data-site-library-family='shadcn'])
    .homepage-hero__tagline:not([data-typography-owner]) {
    font-size: 1rem;
    line-height: 1.5rem;
    font-weight: 400;
    color: var(--color-foreground);
  }
  @media (min-width: 640px) {
    :global([data-site-library-family='shadcn'])
      .homepage-hero__tagline:not([data-typography-owner]) {
      font-size: 1.125rem;
      line-height: 1.75rem;
    }
  }
  @media (min-width: 1280px) {
    .homepage-hero :global(.homepage-hero__eyebrow) {
      margin-bottom: 1rem;
    }
    .homepage-hero__tagline {
      margin-top: 1rem;
    }
    .homepage-hero :global(.homepage-hero__actions) {
      margin-top: 1.5rem;
    }
    :global([data-site-library-family='shadcn']) .homepage-hero h1:not([data-typography-owner]) {
      font-size: 3rem;
      letter-spacing: -0.05em;
    }
  }
  @media (max-width: 767px) {
    .homepage-hero {
      padding-top: 0;
    }
    .homepage-hero h1 {
      text-wrap: pretty;
    }
  }
</style>
