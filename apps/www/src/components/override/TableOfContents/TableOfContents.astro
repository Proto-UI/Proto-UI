---
import TableOfContentsList from './TableOfContentsList.astro';

const { toc } = Astro.locals.starlightRoute;
---

{
  toc && (
    <sl-toc data-min-h={toc.minHeadingLevel} data-max-h={toc.maxHeadingLevel}>
      <nav aria-labelledby="starlight__on-this-page">
        <h2 data-site-typography="label" id="starlight__on-this-page">
          {Astro.locals.t('tableOfContents.onThisPage')}
        </h2>
        <TableOfContentsList toc={toc.items} />
      </nav>
      <div data-site-toc-highlight aria-hidden="true" />
    </sl-toc>
  )
}

<script src="./starlight-toc"></script>
