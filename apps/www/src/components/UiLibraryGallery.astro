---
import StaticFamilyIcon from './StaticFamilyIcon.astro';
import StaticLucideIcon from './StaticLucideIcon.astro';
import LibraryCardFrame from './LibraryCardFrame.astro';
import LibraryCardPart from './LibraryCardPart.astro';
import LibraryLiquidCard from './LibraryLiquidCard.astro';
import {
  librarySurfaceProps,
  libraryHeadingProps,
  libraryBodyPropsForFamily,
  libraryCaptionPropsForFamily,
  libraryActionProps,
  bootstrapLibraryHeadingProps,
  bootstrapLibraryActionTextProps,
  type LibraryFamily,
} from './library-card-prototypes';
import { BRUTALIST_THEME } from '../../../../packages/prototypes/brutalist/src/theme';
import { THEME as BOOTSTRAP_THEME } from '../../../../packages/prototypes/bootstrap-2-3-2/src/theme';
import { THEME as LIQUID_THEME } from '../../../../packages/prototypes/liquid-glass/src/theme';

type Locale = 'en' | 'zh-cn';
type LibraryId = 'base' | 'shadcn' | 'lucide' | 'brutalist' | 'bootstrap-2-3-2' | 'liquid-glass';

interface Props {
  locale?: Locale;
  /** Internal evidence route only until the real Card material is verified. */
  liquidMaterialCandidate?: boolean;
}

type LibraryCard = {
  id: LibraryId;
  name: string;
  mark: string;
  logoSrc?: string;
  type: string;
  status?: string;
  description: string;
  bestFor: string;
  sourceLabel: string;
  source: string;
  sourceHref?: string;
  author: string;
  authorHref: string;
  cta: string;
  href: string;
};

const { locale = 'en', liquidMaterialCandidate = false } = Astro.props as Props;

const copy =
  locale === 'zh-cn'
    ? {
        aria: '选择一个 UI 原型库',
        count: '6 个可选库',
        componentCount: '5 个组件库',
        iconCount: '1 个图标库',
        bestFor: '适合',
        prototypeAuthor: '原型实现',
        unstyledMark: '无样式',
        cards: [
          {
            id: 'base',
            name: 'Base',
            mark: 'B',
            logoSrc: '/favicon.svg',
            type: '协议型组件库',
            description: '默认无样式，只提供可跨宿主复用的交互语义，让视觉完全由你定义。',
            bestFor: '自建设计体系、需要完整掌控视觉的产品',
            sourceLabel: '设计体系',
            source: '无',
            author: 'Proto UI contributors',
            authorHref: 'https://github.com/Proto-UI/Proto-UI',
            cta: '浏览 Base',
            href: './base/',
          },
          {
            id: 'shadcn',
            name: 'Shadcn',
            mark: 'sh',
            logoSrc: '/brands/shadcn.svg',
            type: '风格组件库',
            description: '熟悉、清晰且实用的产品界面风格，建立在 Base 协议之上。',
            bestFor: '后台、SaaS 与希望快速获得成熟界面的产品',
            sourceLabel: '设计来源',
            source: 'shadcn/ui',
            sourceHref: 'https://ui.shadcn.com',
            author: 'Proto UI contributors',
            authorHref: 'https://github.com/Proto-UI/Proto-UI',
            cta: '浏览 Shadcn',
            href: './shadcn/',
          },
          {
            id: 'lucide',
            name: 'Lucide',
            mark: '✦',
            logoSrc: '/brands/lucide.svg',
            type: '图标库',
            description: '轻量一致的线性图标，以逐图标入口提供可按需引入的原型。',
            bestFor: '需要统一图标语言与精细包体积控制的界面',
            sourceLabel: '图标来源',
            source: 'Lucide contributors',
            sourceHref: 'https://lucide.dev',
            author: 'Proto UI contributors',
            authorHref: 'https://github.com/Proto-UI/Proto-UI',
            cta: '浏览 Lucide',
            href: './lucide/',
          },
          {
            id: 'brutalist',
            name: 'Brutalist',
            mark: 'B!',
            type: '风格组件库',
            status: '孵化中',
            description: '强边框、硬阴影与高对比配色组成的 Neo-Brutalist 视觉投射。',
            bestFor: '创意工具、作品集与需要鲜明个性的产品',
            sourceLabel: '设计体系',
            source: 'Proto UI Neo-Brutalist',
            sourceHref: 'https://github.com/Proto-UI/Proto-UI',
            author: 'Proto UI contributors',
            authorHref: 'https://github.com/Proto-UI/Proto-UI',
            cta: '浏览 Brutalist',
            href: './brutalist/',
          },
        ] satisfies LibraryCard[],
      }
    : {
        aria: 'Choose a UI prototype library',
        count: '6 libraries',
        componentCount: '5 component libraries',
        iconCount: '1 icon library',
        bestFor: 'Best for',
        prototypeAuthor: 'Prototype implementation',
        unstyledMark: 'HEADLESS',
        cards: [
          {
            id: 'base',
            name: 'Base',
            mark: 'B',
            logoSrc: '/favicon.svg',
            type: 'Protocol components',
            description:
              'Unstyled by default, providing reusable interaction semantics while leaving visuals entirely to you.',
            bestFor: 'Custom design systems and products that need full visual control',
            sourceLabel: 'Design system',
            source: 'None',
            author: 'Proto UI contributors',
            authorHref: 'https://github.com/Proto-UI/Proto-UI',
            cta: 'Explore Base',
            href: './base/',
          },
          {
            id: 'shadcn',
            name: 'Shadcn',
            mark: 'sh',
            logoSrc: '/brands/shadcn.svg',
            type: 'Styled components',
            description:
              'A familiar, crisp product UI language reconstructed on top of Base protocols.',
            bestFor: 'Dashboards, SaaS, and products that want a mature interface quickly',
            sourceLabel: 'Design source',
            source: 'shadcn/ui',
            sourceHref: 'https://ui.shadcn.com',
            author: 'Proto UI contributors',
            authorHref: 'https://github.com/Proto-UI/Proto-UI',
            cta: 'Explore Shadcn',
            href: './shadcn/',
          },
          {
            id: 'lucide',
            name: 'Lucide',
            mark: '✦',
            logoSrc: '/brands/lucide.svg',
            type: 'Icon library',
            description:
              'A consistent line icon set exposed as tree-shakeable, per-icon prototypes.',
            bestFor: 'Interfaces that need a coherent icon language and precise bundle control',
            sourceLabel: 'Icon source',
            source: 'Lucide contributors',
            sourceHref: 'https://lucide.dev',
            author: 'Proto UI contributors',
            authorHref: 'https://github.com/Proto-UI/Proto-UI',
            cta: 'Explore Lucide',
            href: './lucide/',
          },
          {
            id: 'brutalist',
            name: 'Brutalist',
            mark: 'B!',
            type: 'Styled components',
            status: 'Incubating',
            description:
              'A Neo-Brutalist projection built from strong borders, hard shadows, and vivid contrast.',
            bestFor: 'Creative tools, portfolios, and products that want a distinct personality',
            sourceLabel: 'Design system',
            source: 'Proto UI Neo-Brutalist',
            sourceHref: 'https://github.com/Proto-UI/Proto-UI',
            author: 'Proto UI contributors',
            authorHref: 'https://github.com/Proto-UI/Proto-UI',
            cta: 'Explore Brutalist',
            href: './brutalist/',
          },
        ] satisfies LibraryCard[],
      };

const isZh = locale === 'zh-cn';
const cards: LibraryCard[] = [
  ...copy.cards,
  {
    id: 'bootstrap-2-3-2',
    name: 'Bootstrap 2.3.2',
    mark: '2.3',
    type: isZh ? '风格组件库' : 'Styled components',
    status: isZh ? '孵化中' : 'Incubating',
    description: isZh
      ? '经典渐变、输入框与分隔线，交互由 Base 拥有；Switch / Toggle 为设计语言扩展。'
      : 'Classic gradients, fields, and dividers over Base; Switch / Toggle are design-language extensions.',
    bestFor: isZh ? '经典桌面 Web 风格与旧版设计语言复现' : 'Classic desktop-Web visual language',
    sourceLabel: isZh ? '设计来源' : 'Design source',
    source: 'Bootstrap v2.3.2',
    sourceHref: 'https://getbootstrap.com/2.3.2/',
    author: 'Proto UI contributors',
    authorHref: 'https://github.com/Proto-UI/Proto-UI',
    cta: isZh ? '浏览 Bootstrap 2.3.2' : 'Explore Bootstrap 2.3.2',
    href: './bootstrap-2-3-2/',
  },
  {
    id: 'liquid-glass',
    name: 'Liquid Glass',
    mark: 'LG',
    type: isZh ? '风格组件库' : 'Styled components',
    status: isZh ? '孵化中' : 'Incubating',
    description: isZh
      ? '功能层的材质与层次探索。此入口使用不透明 Surface 回退；光学材质仍在验证。'
      : 'An exploration of materials and functional layers. This entry uses the opaque Surface fallback; optical rendering remains under verification.',
    bestFor: isZh
      ? '重视层次和可读性的功能层'
      : 'Layered functional controls with readable content',
    sourceLabel: isZh ? '设计参考' : 'Design reference',
    source: 'Apple Materials HIG',
    sourceHref: 'https://developer.apple.com/design/human-interface-guidelines/materials',
    author: 'Proto UI contributors',
    authorHref: 'https://github.com/Proto-UI/Proto-UI',
    cta: isZh ? '浏览 Liquid Glass' : 'Explore Liquid Glass',
    href: './liquid-glass/',
  },
];
const familyThemes = {
  brutalist: BRUTALIST_THEME,
  'bootstrap-2-3-2': BOOTSTRAP_THEME,
  'liquid-glass': LIQUID_THEME,
};
const themeCss = Object.entries(familyThemes)
  .flatMap(([family, modes]) =>
    ['light', 'dark'].map((mode) => {
      const selector =
        mode === 'light'
          ? `[data-library="${family}"]`
          : `:root:is(.dark,[data-theme='dark']) [data-library="${family}"]`;
      return `${selector}{${Object.entries(modes[mode as 'light' | 'dark'])
        .map(
          ([key, value]) =>
            `--pui-${key}:${String(value).replaceAll('"DM Sans"', '"Library DM Sans"')};`
        )
        .join('')}}`;
    })
  )
  .join('\n');
---

<style is:inline set:html={themeCss}></style>
<section class="library-gallery" aria-label={copy.aria}>
  <p class="library-gallery__summary">{copy.componentCount} · {copy.iconCount}</p>
  <div class="library-gallery__grid">
    {
      cards.map((library) => {
        if (liquidMaterialCandidate && library.id === 'liquid-glass') {
          return (
            <LibraryLiquidCard
              library={library}
              bestForLabel={copy.bestFor}
              prototypeAuthorLabel={copy.prototypeAuthor}
            />
          );
        }
        const family: LibraryFamily = library.id === 'lucide' ? 'base' : library.id;
        const brutalist = family === 'brutalist';
        const bootstrap = family === 'bootstrap-2-3-2';
        const bodyProps = libraryBodyPropsForFamily(family);
        const captionProps = libraryCaptionPropsForFamily(family);
        return (
          <article
            class="library-card"
            data-library={library.id}
            aria-labelledby={`library-${library.id}`}
          >
            <LibraryCardPart
              part={brutalist ? 'brutalist-card' : `${family}-surface`}
              props={brutalist ? {} : librarySurfaceProps}
              class="library-card__surface"
            >
              <LibraryCardFrame bootstrap={bootstrap}>
                <LibraryCardPart
                  part={brutalist ? 'brutalist-header' : 'base-surface'}
                  class="library-card__header"
                >
                  <header>
                    <LibraryCardPart
                      part={`${family}-text`}
                      props={captionProps}
                      class="library-card__kind"
                    >
                      {library.type}
                      {library.status && ` · ${library.status}`}
                    </LibraryCardPart>
                    <h2 id={`library-${library.id}`}>
                      <LibraryCardPart
                        part={`${family}-text`}
                        props={bootstrap ? bootstrapLibraryHeadingProps : libraryHeadingProps}
                      >
                        {library.name}
                      </LibraryCardPart>
                    </h2>
                  </header>
                  {library.logoSrc && (
                    <img
                      class="library-card__logo"
                      src={library.logoSrc}
                      alt=""
                      width="32"
                      height="32"
                      loading="eager"
                    />
                  )}
                </LibraryCardPart>
                <LibraryCardPart
                  part={brutalist ? 'brutalist-content' : 'base-surface'}
                  class="library-card__content"
                >
                  {library.id === 'lucide' && (
                    <div class="library-card__icons" aria-hidden="true">
                      <StaticLucideIcon name="sun" />
                      <StaticLucideIcon name="heart" />
                      <StaticLucideIcon name="search" />
                      <StaticLucideIcon name="circle-check" />
                      <StaticLucideIcon name="panels-top-left" />
                    </div>
                  )}
                  <p>
                    <LibraryCardPart part={`${family}-text`} props={bodyProps}>
                      {library.description}
                    </LibraryCardPart>
                  </p>
                  <p>
                    <LibraryCardPart part={`${family}-text`} props={captionProps}>
                      {copy.bestFor} · {library.bestFor}
                    </LibraryCardPart>
                  </p>
                  <LibraryCardPart
                    part={`${family}-text`}
                    props={{ ...captionProps, tone: 'inherit' }}
                  >
                    <dl class="library-card__credits">
                      <div>
                        <>
                          <dt>{library.sourceLabel}</dt>
                          <dd>
                            {library.sourceHref ? (
                              <a href={library.sourceHref} target="_blank" rel="noreferrer">
                                {library.source}{' '}
                                <StaticFamilyIcon family={library.id} name="arrow-up-right" />
                              </a>
                            ) : (
                              library.source
                            )}
                          </dd>
                        </>
                      </div>
                      <div>
                        <>
                          <dt>{copy.prototypeAuthor}</dt>
                          <dd>
                            <a href={library.authorHref} target="_blank" rel="noreferrer">
                              {library.author}{' '}
                              <StaticFamilyIcon family={library.id} name="arrow-up-right" />
                            </a>
                          </dd>
                        </>
                      </div>
                    </dl>
                  </LibraryCardPart>
                </LibraryCardPart>
                <LibraryCardPart
                  part={brutalist ? 'brutalist-footer' : 'base-surface'}
                  class="library-card__footer"
                >
                  <a href={library.href} data-library-action>
                    <LibraryCardPart
                      part={`${family}-surface`}
                      props={libraryActionProps}
                      class="library-card__action"
                    >
                      <LibraryCardPart
                        part={`${family}-text`}
                        props={
                          bootstrap
                            ? bootstrapLibraryActionTextProps
                            : { size: 'sm', weight: 'medium', tone: 'inherit' }
                        }
                      >
                        {library.cta} <StaticFamilyIcon family={library.id} name="arrow-right" />
                      </LibraryCardPart>
                    </LibraryCardPart>
                  </a>
                </LibraryCardPart>
              </LibraryCardFrame>
            </LibraryCardPart>
          </article>
        );
      })
    }
  </div>
</section>
<script>
  import { initLibraryCards } from './library-card-client';
  let release = initLibraryCards();
  document.addEventListener('astro:before-swap', () => release());
  document.addEventListener('astro:page-load', () => {
    release = initLibraryCards();
  });
</script>
<style>
  @font-face {
    font-family: 'Library DM Sans';
    /* Keep the already licensed, checksum-verified bytes in the render-blocking
       gallery CSS. No network font completion can change this first frame. */
    src: url('../styles/assets/font/dm-sans/DMSans-Variable.ttf?inline') format('truetype');
    font-style: normal;
    font-weight: 100 1000;
    font-display: swap;
  }
  /* Page composition owns only placement. Family Prototype output owns paint,
     radius, border, shadow, type and observed action state, including SSR. */
  .library-gallery {
    margin-block: 1.5rem 3rem;
  }
  .library-gallery__summary {
    margin-block: 0 1rem;
  }
  .library-gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: start;
  }
  .library-card {
    container-type: inline-size;
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
  }
  .library-card :global([data-library-part]) {
    /* Match the WC fallback host layout before definition. Named page layout
       rules below still own flex/grid; Prototype tokens still own paint. */
    display: block;
    min-width: 0;
  }
  .library-card:not([data-library='bootstrap-2-3-2']) :global(.library-card__surface) {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .library-card:not([data-library='brutalist']):not([data-library='bootstrap-2-3-2'])
    :global(.library-card__surface) {
    padding: 1.5rem;
  }
  .library-card :global(.library-card__header) {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }
  .library-card :global(.library-card__kind) {
    display: block;
    margin-bottom: 0.5rem;
  }
  .library-card header {
    min-width: 0;
  }
  .library-card h2,
  .library-card p {
    margin: 0;
  }
  .library-card__logo {
    flex-shrink: 0;
  }
  [data-library='shadcn'] .library-card__logo {
    filter: var(--library-logo-filter, none);
  }
  :global(:root:is(.dark, [data-theme='dark'])) [data-library='shadcn'] .library-card__logo {
    filter: invert(1);
  }
  .library-card:not([data-library='bootstrap-2-3-2']) :global(.library-card__content) {
    display: grid;
    gap: 1rem;
  }
  .library-card__icons {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding-block: 0.5rem;
  }
  .library-card__credits {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }
  .library-card:not([data-library='bootstrap-2-3-2']) .library-card__credits {
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .library-card__credits div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }
  .library-card__credits dd {
    margin: 0;
  }
  .library-card a {
    color: inherit;
    text-underline-offset: 0.2em;
  }
  .library-card :global(.library-card__footer) {
    display: flex;
    align-items: start;
  }
  .library-card [data-library-action] {
    display: inline-block;
    max-width: 100%;
    text-decoration: none;
  }
  .library-card:not([data-library='bootstrap-2-3-2']) :global(.library-card__action) {
    display: block;
    padding: 0.75rem 1rem;
    min-height: 2.75rem;
  }
  /* Layout only: Bootstrap's own atoms supply component paint and spacing. */
  [data-library='bootstrap-2-3-2'] :global(.library-card__surface) {
    padding: 0.25rem;
  }
  [data-library='bootstrap-2-3-2'] :global(.library-card__thumbnail-caption) {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 0.5625rem;
  }
  [data-library='bootstrap-2-3-2'] :global(.library-card__content) {
    display: grid;
    gap: 0.625rem;
  }
  [data-library='bootstrap-2-3-2'] :global(.library-card__action) {
    padding: 0.25rem 0.75rem;
  }
  [data-library='base'] [data-library-action],
  [data-library='lucide'] [data-library-action] {
    text-decoration: underline;
  }
  .library-card a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
  /* A narrow card must spend its width on selectable text, rather than scale
     desktop gutters alongside enlarged text. This is page-owned placement;
     family type, borders and paint are unchanged. */
  @container (max-width: 18rem) {
    .library-card :global(.library-card__header) {
      flex-direction: column-reverse;
      gap: 0.75rem;
    }
    .library-card header {
      width: 100%;
    }
    .library-card:not([data-library='brutalist']):not([data-library='bootstrap-2-3-2'])
      :global(.library-card__surface),
    [data-library='brutalist'] :global(.library-card__header),
    [data-library='brutalist'] :global(.library-card__content),
    [data-library='brutalist'] :global(.library-card__footer) {
      padding-inline: min(1.5rem, 5cqi);
    }
    .library-card:not([data-library='bootstrap-2-3-2']) :global(.library-card__action) {
      padding-inline: min(1rem, 5cqi);
    }
    [data-library='bootstrap-2-3-2'] :global(.library-card__thumbnail-caption) {
      padding-inline: min(0.5625rem, 2cqi);
    }
  }
  @media (max-width: 50rem) {
    .library-gallery__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
