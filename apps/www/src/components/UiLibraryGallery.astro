---
import StaticLucideIcon from './StaticLucideIcon.astro';

type Locale = 'en' | 'zh-cn';
type LibraryId = 'base' | 'shadcn' | 'lucide' | 'brutalist';

interface Props {
  locale?: Locale;
}

type LibraryCard = {
  id: LibraryId;
  name: string;
  mark: string;
  logoSrc?: string;
  type: string;
  status?: string;
  description: string;
  bestFor: string;
  sourceLabel: string;
  source: string;
  sourceHref?: string;
  author: string;
  authorHref: string;
  cta: string;
  href: string;
};

const { locale = 'en' } = Astro.props as Props;

const copy =
  locale === 'zh-cn'
    ? {
        aria: '选择一个 UI 原型库',
        count: '4 个可选库',
        componentCount: '3 个组件库',
        iconCount: '1 个图标库',
        bestFor: '适合',
        prototypeAuthor: '原型实现',
        unstyledMark: '无样式',
        cards: [
          {
            id: 'base',
            name: 'Base',
            mark: 'B',
            logoSrc: '/favicon.svg',
            type: '协议型组件库',
            description: '默认无样式，只提供可跨宿主复用的交互语义，让视觉完全由你定义。',
            bestFor: '自建设计体系、需要完整掌控视觉的产品',
            sourceLabel: '设计体系',
            source: '无',
            author: 'Proto UI contributors',
            authorHref: 'https://github.com/Proto-UI/Proto-UI',
            cta: '浏览 Base',
            href: './base/',
          },
          {
            id: 'shadcn',
            name: 'Shadcn',
            mark: 'sh',
            logoSrc: '/brands/shadcn.svg',
            type: '风格组件库',
            description: '熟悉、清晰且实用的产品界面风格，建立在 Base 协议之上。',
            bestFor: '后台、SaaS 与希望快速获得成熟界面的产品',
            sourceLabel: '设计来源',
            source: 'shadcn/ui',
            sourceHref: 'https://ui.shadcn.com',
            author: 'Proto UI contributors',
            authorHref: 'https://github.com/Proto-UI/Proto-UI',
            cta: '浏览 Shadcn',
            href: './shadcn/',
          },
          {
            id: 'lucide',
            name: 'Lucide',
            mark: '✦',
            logoSrc: '/brands/lucide.svg',
            type: '图标库',
            description: '轻量一致的线性图标，以逐图标入口提供可按需引入的原型。',
            bestFor: '需要统一图标语言与精细包体积控制的界面',
            sourceLabel: '图标来源',
            source: 'Lucide contributors',
            sourceHref: 'https://lucide.dev',
            author: 'Proto UI contributors',
            authorHref: 'https://github.com/Proto-UI/Proto-UI',
            cta: '浏览 Lucide',
            href: './lucide/',
          },
          {
            id: 'brutalist',
            name: 'Brutalist',
            mark: 'B!',
            type: '风格组件库',
            status: '孵化中',
            description: '强边框、硬阴影与高对比配色组成的 Neo-Brutalist 视觉投射。',
            bestFor: '创意工具、作品集与需要鲜明个性的产品',
            sourceLabel: '设计体系',
            source: 'Proto UI Neo-Brutalist',
            sourceHref: 'https://github.com/Proto-UI/Proto-UI',
            author: 'Proto UI contributors',
            authorHref: 'https://github.com/Proto-UI/Proto-UI',
            cta: '浏览 Brutalist',
            href: './brutalist/',
          },
        ] satisfies LibraryCard[],
      }
    : {
        aria: 'Choose a UI prototype library',
        count: '4 libraries',
        componentCount: '3 component libraries',
        iconCount: '1 icon library',
        bestFor: 'Best for',
        prototypeAuthor: 'Prototype implementation',
        unstyledMark: 'HEADLESS',
        cards: [
          {
            id: 'base',
            name: 'Base',
            mark: 'B',
            logoSrc: '/favicon.svg',
            type: 'Protocol components',
            description:
              'Unstyled by default, providing reusable interaction semantics while leaving visuals entirely to you.',
            bestFor: 'Custom design systems and products that need full visual control',
            sourceLabel: 'Design system',
            source: 'None',
            author: 'Proto UI contributors',
            authorHref: 'https://github.com/Proto-UI/Proto-UI',
            cta: 'Explore Base',
            href: './base/',
          },
          {
            id: 'shadcn',
            name: 'Shadcn',
            mark: 'sh',
            logoSrc: '/brands/shadcn.svg',
            type: 'Styled components',
            description:
              'A familiar, crisp product UI language reconstructed on top of Base protocols.',
            bestFor: 'Dashboards, SaaS, and products that want a mature interface quickly',
            sourceLabel: 'Design source',
            source: 'shadcn/ui',
            sourceHref: 'https://ui.shadcn.com',
            author: 'Proto UI contributors',
            authorHref: 'https://github.com/Proto-UI/Proto-UI',
            cta: 'Explore Shadcn',
            href: './shadcn/',
          },
          {
            id: 'lucide',
            name: 'Lucide',
            mark: '✦',
            logoSrc: '/brands/lucide.svg',
            type: 'Icon library',
            description:
              'A consistent line icon set exposed as tree-shakeable, per-icon prototypes.',
            bestFor: 'Interfaces that need a coherent icon language and precise bundle control',
            sourceLabel: 'Icon source',
            source: 'Lucide contributors',
            sourceHref: 'https://lucide.dev',
            author: 'Proto UI contributors',
            authorHref: 'https://github.com/Proto-UI/Proto-UI',
            cta: 'Explore Lucide',
            href: './lucide/',
          },
          {
            id: 'brutalist',
            name: 'Brutalist',
            mark: 'B!',
            type: 'Styled components',
            status: 'Incubating',
            description:
              'A Neo-Brutalist projection built from strong borders, hard shadows, and vivid contrast.',
            bestFor: 'Creative tools, portfolios, and products that want a distinct personality',
            sourceLabel: 'Design system',
            source: 'Proto UI Neo-Brutalist',
            sourceHref: 'https://github.com/Proto-UI/Proto-UI',
            author: 'Proto UI contributors',
            authorHref: 'https://github.com/Proto-UI/Proto-UI',
            cta: 'Explore Brutalist',
            href: './brutalist/',
          },
        ] satisfies LibraryCard[],
      };
---

<section class="library-gallery" aria-label={copy.aria}>
  <div class="library-gallery__summary" aria-label={copy.count}>
    <span>{copy.count}</span>
    <span>{copy.componentCount}</span>
    <span>{copy.iconCount}</span>
  </div>

  <div class="library-gallery__grid">
    {
      copy.cards.map((library) => (
        <article class:list={['library-card', `library-card--${library.id}`]}>
          <header class="library-card__header">
            <span class="library-card__logo" aria-hidden="true">
              {library.logoSrc ? <img src={library.logoSrc} alt="" /> : library.mark}
            </span>
            <span class="library-card__identity">
              <strong>{library.name}</strong>
              <span>{library.type}</span>
            </span>
            {library.status && <span class="library-card__status">{library.status}</span>}
          </header>

          <div class="library-card__preview" aria-hidden="true">
            {library.id === 'base' && (
              <div class="base-preview">
                <span class="base-preview__watermark">{copy.unstyledMark}</span>
                <div class="base-preview__toolbar">
                  <i />
                  <i />
                  <i />
                </div>
                <div class="base-preview__body">
                  <div class="base-preview__title" />
                  <div class="base-preview__copy" />
                  <div class="base-preview__row">
                    <span class="base-preview__field" />
                    <span class="base-preview__switch">
                      <i />
                    </span>
                  </div>
                  <div class="base-preview__actions">
                    <span />
                    <span />
                  </div>
                </div>
              </div>
            )}

            {library.id === 'shadcn' && (
              <div class="shadcn-preview">
                <div class="shadcn-preview__nav">
                  <i />
                  <span />
                  <span />
                  <b />
                </div>
                <div class="shadcn-preview__panel">
                  <div class="shadcn-preview__title" />
                  <div class="shadcn-preview__copy" />
                  <div class="shadcn-preview__fields">
                    <span />
                    <span />
                  </div>
                  <div class="shadcn-preview__button" />
                </div>
              </div>
            )}

            {library.id === 'lucide' && (
              <div class="lucide-preview">
                <div class="lucide-preview__search">
                  <StaticLucideIcon name="search" />
                  <i />
                </div>
                <div class="lucide-preview__icons">
                  <span class="line-icon">
                    <StaticLucideIcon name="sun" />
                  </span>
                  <span class="line-icon">
                    <StaticLucideIcon name="circle-check" />
                  </span>
                  <span class="line-icon">
                    <StaticLucideIcon name="heart" />
                  </span>
                  <span class="line-icon">
                    <StaticLucideIcon name="sparkles" />
                  </span>
                  <span class="line-icon">
                    <StaticLucideIcon name="arrow-up-right" />
                  </span>
                  <span class="line-icon">
                    <StaticLucideIcon name="panels-top-left" />
                  </span>
                </div>
              </div>
            )}

            {library.id === 'brutalist' && (
              <div class="brutalist-preview">
                <div class="brutalist-preview__poster">
                  <span class="brutalist-preview__sticker">NEW</span>
                  <strong>
                    BUILD
                    <br />
                    LOUD.
                  </strong>
                  <div class="brutalist-preview__controls">
                    <span>SELECT</span>
                    <i />
                  </div>
                </div>
                <div class="brutalist-preview__dot" />
              </div>
            )}
          </div>

          <div class="library-card__body">
            <p class="library-card__description">{library.description}</p>
            <p class="library-card__best-for">
              <span>{copy.bestFor}</span>
              {library.bestFor}
            </p>
            <dl class="library-card__credits">
              <div>
                <dt>{library.sourceLabel}</dt>
                <dd>
                  {library.sourceHref ? (
                    <a href={library.sourceHref} target="_blank" rel="noreferrer">
                      {library.source}
                      <span aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    library.source
                  )}
                </dd>
              </div>
              <div>
                <dt>{copy.prototypeAuthor}</dt>
                <dd>
                  <a href={library.authorHref} target="_blank" rel="noreferrer">
                    {library.author}
                    <span aria-hidden="true">↗</span>
                  </a>
                </dd>
              </div>
            </dl>
          </div>

          <footer class="library-card__footer">
            <a class="library-card__primary-link" href={library.href} aria-label={library.cta}>
              <span>{library.cta}</span>
              <span aria-hidden="true">↗</span>
            </a>
          </footer>
        </article>
      ))
    }
  </div>
</section>

<style>
  .library-gallery {
    margin-block: 1.75rem 3rem;
  }

  .library-gallery__summary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .library-gallery__summary span {
    border: 1px solid color-mix(in oklab, var(--color-border) 88%, transparent);
    border-radius: 999px;
    color: var(--color-muted-foreground);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.02em;
    line-height: 1;
    padding: 0.4rem 0.65rem;
  }

  .library-gallery__summary span:first-child {
    background: var(--color-foreground);
    border-color: var(--color-foreground);
    color: var(--color-background);
  }

  .library-gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .library-card {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    min-width: 0;
    margin: 0;
    border: 1px solid color-mix(in oklab, var(--color-border) 88%, transparent);
    border-radius: 0.85rem;
    background: color-mix(in oklab, var(--color-background) 97%, var(--color-muted) 3%);
    box-shadow: 0 1px 0 color-mix(in oklab, var(--color-foreground) 5%, transparent);
    overflow: hidden;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .library-card:hover,
  .library-card:focus-within {
    border-color: color-mix(in oklab, var(--color-foreground) 35%, var(--color-border));
    box-shadow:
      0 14px 32px color-mix(in oklab, var(--color-foreground) 8%, transparent),
      0 1px 0 color-mix(in oklab, var(--color-foreground) 8%, transparent);
    transform: translateY(-2px);
  }

  .library-card__header {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    padding: 0.9rem 0.9rem 0.8rem;
  }

  .library-card__logo {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid color-mix(in oklab, var(--color-border) 88%, transparent);
    border-radius: 0.62rem;
    background: var(--color-foreground);
    color: var(--color-background);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    overflow: hidden;
  }

  .library-card__logo img {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
  }

  .library-card--shadcn .library-card__logo {
    background: #18181b;
    color: #fafafa;
    text-transform: lowercase;
  }

  .library-card--shadcn .library-card__logo img {
    filter: invert(1);
  }

  .library-card--base .library-card__logo img {
    width: 100%;
    height: 100%;
  }

  .library-card--lucide .library-card__logo {
    background: #fff;
    border-color: #f1cfcc;
  }

  .library-card--brutalist .library-card__logo {
    border: 2px solid #111;
    border-radius: 0;
    background: #ffd23f;
    box-shadow: 2px 2px 0 #111;
    color: #111;
  }

  .library-card__identity {
    display: grid;
    min-width: 0;
    gap: 0.08rem;
  }

  .library-card__identity strong {
    color: var(--color-foreground);
    font-size: 0.98rem;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .library-card__identity > span {
    color: var(--color-muted-foreground);
    font-size: 0.7rem;
    line-height: 1.25;
  }

  .library-card__status {
    margin-left: auto;
    border: 1px solid color-mix(in oklab, #f59e0b 60%, var(--color-border));
    border-radius: 999px;
    background: color-mix(in oklab, #f59e0b 12%, var(--color-background));
    color: color-mix(in oklab, #b45309 82%, var(--color-foreground));
    font-size: 0.63rem;
    font-weight: 750;
    letter-spacing: 0.025em;
    line-height: 1;
    padding: 0.34rem 0.48rem;
    white-space: nowrap;
  }

  .library-card__preview {
    position: relative;
    min-height: 13.5rem;
    margin-inline: 0.75rem;
    overflow: hidden;
    border-radius: 0.62rem;
  }

  .library-card__body {
    display: grid;
    align-content: start;
    gap: 0.85rem;
    padding: 1rem 0.95rem 0.9rem;
  }

  .library-card__description,
  .library-card__best-for {
    margin: 0;
  }

  .library-card__description {
    color: var(--color-foreground);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .library-card__best-for {
    color: var(--color-muted-foreground);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .library-card__best-for span {
    margin-right: 0.4rem;
    color: var(--color-foreground);
    font-weight: 700;
  }

  .library-card__credits {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding-top: 0.15rem;
  }

  .library-card__credits div {
    display: grid;
    grid-template-columns: minmax(5.6rem, 0.9fr) minmax(0, 1.2fr);
    gap: 0.6rem;
  }

  .library-card__credits dt,
  .library-card__credits dd {
    margin: 0;
    font-size: 0.68rem;
    line-height: 1.4;
  }

  .library-card__credits dt {
    color: var(--color-muted-foreground);
  }

  .library-card__credits dd {
    overflow: hidden;
    color: var(--color-foreground);
    font-weight: 650;
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .library-card__credits a {
    position: relative;
    z-index: 2;
    display: inline-flex;
    max-width: 100%;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem;
    color: inherit;
    text-decoration: none;
    text-underline-offset: 0.18em;
  }

  .library-card__credits a:hover,
  .library-card__credits a:focus-visible {
    text-decoration: underline;
    text-decoration-color: currentColor;
  }

  .library-card__credits a span {
    color: var(--color-muted-foreground);
    font-size: 0.62rem;
  }

  .library-card__footer {
    border-top: 1px solid color-mix(in oklab, var(--color-border) 78%, transparent);
    color: var(--color-foreground);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.72rem 0.95rem;
  }

  .library-card__primary-link {
    display: flex;
    justify-content: space-between;
    color: inherit;
    text-decoration: none;
  }

  .library-card__primary-link::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    border-radius: 0.85rem;
    content: '';
  }

  .library-card__primary-link:focus-visible {
    outline: none;
  }

  .library-card__primary-link:focus-visible::after {
    outline: 2px solid var(--color-primary);
    outline-offset: -3px;
  }

  .library-card__primary-link span:last-child {
    transition: transform 180ms ease;
  }

  .library-card:hover .library-card__primary-link span:last-child {
    transform: translate(2px, -2px);
  }

  /* Base preview */
  .library-card--base .library-card__preview {
    display: grid;
    place-items: center;
    background:
      linear-gradient(color-mix(in oklab, #e5e7eb 62%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in oklab, #e5e7eb 62%, transparent) 1px, transparent 1px),
      #f8fafc;
    background-size: 18px 18px;
  }

  .base-preview {
    position: relative;
    width: 78%;
    overflow: hidden;
    border: 1px dashed #64748b;
    border-radius: 0.2rem;
    background: rgba(255, 255, 255, 0.82);
    color: #0f172a;
    transform: rotate(-1deg);
  }

  .base-preview__watermark {
    position: absolute;
    left: 50%;
    top: 50%;
    color: rgba(15, 23, 42, 0.08);
    font-family: var(--font-mono);
    font-size: clamp(1.35rem, 4.5vw, 2.3rem);
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1;
    transform: translate(-50%, -50%) rotate(-8deg);
    white-space: nowrap;
  }

  .base-preview__toolbar {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 0.3rem;
    border-bottom: 1px solid #e2e8f0;
    padding: 0.52rem 0.62rem;
  }

  .base-preview__toolbar i {
    width: 0.36rem;
    height: 0.36rem;
    border-radius: 50%;
    background: #cbd5e1;
  }

  .base-preview__body {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.72rem;
    padding: 1rem;
  }

  .base-preview__title,
  .base-preview__copy,
  .base-preview__field,
  .base-preview__actions span {
    display: block;
    border-radius: 0;
    background: #64748b;
  }

  .base-preview__title {
    width: 42%;
    height: 0.48rem;
  }

  .base-preview__copy {
    width: 76%;
    height: 0.25rem;
    background: #cbd5e1;
  }

  .base-preview__row,
  .base-preview__actions {
    display: flex;
    align-items: center;
  }

  .base-preview__row {
    justify-content: space-between;
    border-top: 1px dashed #94a3b8;
    border-bottom: 1px dashed #94a3b8;
    padding-block: 0.7rem;
  }

  .base-preview__field {
    width: 36%;
    height: 0.26rem;
    background: #94a3b8;
  }

  .base-preview__switch {
    display: flex;
    width: 1.75rem;
    height: 0.95rem;
    justify-content: flex-end;
    align-items: center;
    border: 1px solid #64748b;
    border-radius: 0;
    background: transparent;
    padding: 0.12rem;
  }

  .base-preview__switch i {
    width: 0.7rem;
    height: 0.7rem;
    border: 1px solid #64748b;
    border-radius: 0;
    background: #e2e8f0;
  }

  .base-preview__actions {
    justify-content: flex-end;
    gap: 0.4rem;
  }

  .base-preview__actions span {
    width: 2.7rem;
    height: 1.1rem;
    border: 1px solid #cbd5e1;
    background: transparent;
  }

  .base-preview__actions span:last-child {
    border-style: dashed;
    border-color: #64748b;
    background: transparent;
  }

  /* Shadcn preview */
  .library-card--shadcn .library-card__preview {
    background: #e4e4e7;
    color: #18181b;
  }

  .shadcn-preview {
    position: absolute;
    inset: 0;
    background: #e4e4e7;
    padding: 1rem;
  }

  .shadcn-preview__nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .shadcn-preview__nav i {
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 0.25rem;
    background: #18181b;
  }

  .shadcn-preview__nav span {
    width: 2.4rem;
    height: 0.23rem;
    border-radius: 999px;
    background: #a1a1aa;
  }

  .shadcn-preview__nav b {
    width: 2.7rem;
    height: 1.05rem;
    margin-left: auto;
    border-radius: 0.3rem;
    background: #18181b;
  }

  .shadcn-preview__panel {
    display: grid;
    width: 72%;
    gap: 0.65rem;
    margin: 1.3rem auto 0;
    border: 1px solid #d4d4d8;
    border-radius: 0.58rem;
    background: #fff;
    box-shadow: 0 16px 36px rgba(24, 24, 27, 0.18);
    padding: 1rem;
  }

  .shadcn-preview__title,
  .shadcn-preview__copy,
  .shadcn-preview__fields span,
  .shadcn-preview__button {
    display: block;
    border-radius: 0.18rem;
  }

  .shadcn-preview__title {
