---
import '../styles/site-copy-command.css';
import '../styles/site-note-surface.css';
import { codeStartupPaintCss } from './site-startup-paint';
const codePaint = await codeStartupPaintCss();
---

<style is:inline set:html={codePaint}></style>

<script>
  import { initSiteCopyCommands } from './site-copy-client';
  import { initSiteCodeSurfaces } from './site-code-surface';
  initSiteCodeSurfaces(document);
  document.addEventListener('astro:page-load', () => initSiteCodeSurfaces(document));
  initSiteCopyCommands(document);
  document.addEventListener('astro:page-load', () => initSiteCopyCommands(document));
</script>
