---
import { renderProtoStyleTokenCss } from '../../../../packages/cli/src/services/proto-style-css';
import { DRAFT_FAMILY_STYLE_TOKENS } from '../../../../packages/cli/src/generated/draft-family-style-tokens';
const tokens = [...new Set(Object.values(DRAFT_FAMILY_STYLE_TOKENS).flat())];
---

<!-- Physical token output from the real Prototype source, not a site skin. -->
<style is:global data-draft-projection-css set:html={renderProtoStyleTokenCss(tokens)}></style>

<style is:global>
  /* The Previewer owns the visible canvas backdrop. Keep this content carrier
     transparent so no unrepresented CSS paint sits between it and the controls. */
  .liquid-functional-demo {
    padding: 24px;
    border-radius: 20px;
  }
  .liquid-functional-demo [role='status'] {
    background: #ffffff;
    color: #1d1d1f;
    padding: 4px 8px;
    border-radius: 4px;
  }
</style>
