---
import { AdapterIds } from './runtimes/registry';
import {
  DEFAULT_ADAPTER,
  PREFERRED_ADAPTER_EVENT,
  PREFERRED_ADAPTER_KEY,
} from '../adapter-preference';
const adapterIdsJson = JSON.stringify(AdapterIds);
---

<script
  is:inline
  define:vars={{
    PREFERRED_ADAPTER_KEY,
    PREFERRED_ADAPTER_EVENT,
    DEFAULT_ADAPTER,
    adapterIdsJson,
  }}
>
  (function () {
    if (window.__protoAdapterPanelInit === '1') return;
    window.__protoAdapterPanelInit = '1';
    var supportedAdapters = JSON.parse(adapterIdsJson);

    function showPanel(adapter) {
      document.querySelectorAll('[data-adapter-panel]').forEach(function (el) {
        el.style.display = el.getAttribute('data-adapter-panel') === adapter ? '' : 'none';
      });
    }

    function isSupported(adapter) {
      return supportedAdapters.indexOf(adapter) !== -1;
    }

    function getPreferred() {
      try {
        let SelectedAdapter = localStorage.getItem(PREFERRED_ADAPTER_KEY);
        return SelectedAdapter && isSupported(SelectedAdapter) ? SelectedAdapter : DEFAULT_ADAPTER;
      } catch (e) {
        return DEFAULT_ADAPTER;
      }
    }

    function syncPreferredPanel() {
      showPanel(getPreferred());
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncPreferredPanel, { once: true });
    } else {
      syncPreferredPanel();
    }

    document.addEventListener(PREFERRED_ADAPTER_EVENT, function (event) {
      var adapter = event && event.detail && event.detail.adapter;
      if (isSupported(adapter)) showPanel(adapter);
    });
  })();
</script>
