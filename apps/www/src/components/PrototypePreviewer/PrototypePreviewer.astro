---
import {
  AdapterIds,
  InternalAdapterIds,
  selectRuntimeIds,
  type RuntimeId,
} from './runtimes/registry';
import AdapterSelect from '../override/AdapterSelect.astro';
import CodePanel from './CodePanel.astro';
import { highlightCode, type CodeLang } from './code-highlight';

function codeLangForRuntime(runtime: RuntimeId): CodeLang {
  if (runtime === 'vue' || runtime === 'vue2') return 'vue';
  if (runtime === 'react') return 'tsx';
  return 'html';
}

interface Props {
  prototypeId?: string; // 原型 ID（与 demoId 二选一）
  demoId?: string; // demo ID（*.demo.ts）
  initialRuntime?: RuntimeId; // 默认 'wc'
  props?: Record<string, unknown>; // 传给原型适配后组件的 props
  class?: string;
  toolbar?: boolean; // 是否渲染运行时切换 UI，默认 true
  runtimes?: RuntimeId[]; // 可选的运行时列表，默认使用全部 public AdapterIds
  loader?: string; // 动态导入路径，例如 './demo-inline'
  /** 可选：展示的代码片段，提供后显示 Preview | Code 标签页 */
  code?: string;
  hasCode?: boolean;
  codePanel?: boolean;
  lazy?: boolean; // 进入视口附近后再加载 demo 与原型模块
  /** Allows internal validation pages to opt into runtimes outside the public adapter set. */
  allowExperimentalRuntimes?: boolean;
}

function assertJsonLike(value: unknown, path: string[] = []) {
  const makePath = () => (path.length === 0 ? '(root)' : path.join('.'));
  const fail = (detail: string) => {
    throw new Error(
      `[PrototypePreviewer] props 必须是 JSON-like 数据。\n` +
        `非法值位置: ${makePath()}\n` +
        `问题: ${detail}`
    );
  };

  if (value === null) return;
  const t = typeof value;
  if (t === 'string' || t === 'number' || t === 'boolean') return;
  if (t === 'undefined' || t === 'function' || t === 'symbol' || t === 'bigint') {
    fail(`不支持的类型 "${t}"`);
  }
  if (Array.isArray(value)) {
    for (let i = 0; i < value.length; i++) {
      assertJsonLike(value[i], [...path, `[${i}]`]);
    }
    return;
  }
  if (t === 'object') {
    if (Object.getPrototypeOf(value) !== Object.prototype) {
      fail('仅支持普通对象');
    }
    for (const [k, v] of Object.entries(value as Record<string, unknown>)) {
      assertJsonLike(v, [...path, k]);
    }
    return;
  }

  fail(`不支持的类型 "${t}"`);
}

// 自动扫描 demo_components 下的所有 codeMap 文件
const codeMapModules = import.meta.glob('../../content/docs/demo_components/**/*Code.ts', {
  eager: true,
});

function findCodeMapForDemo(targetDemoId: string): Partial<Record<RuntimeId, string>> | undefined {
  for (const mod of Object.values(codeMapModules)) {
    const map = (mod as { codeMap?: Partial<Record<RuntimeId, Record<string, string>>> }).codeMap;
    if (!map) continue;
    const hasDemo = Object.values(map).some((runtimeMap) => targetDemoId in runtimeMap);
    if (!hasDemo) continue;
    const result: Partial<Record<RuntimeId, string>> = {};
    for (const [runtime, runtimeMap] of Object.entries(map)) {
      if (runtimeMap[targetDemoId]) {
        result[runtime as RuntimeId] = runtimeMap[targetDemoId];
      }
    }
    return result;
  }
  return undefined;
}

const {
  prototypeId,
  demoId,
  initialRuntime = 'wc',
  props: protoProps = {},
  class: className = '',
  toolbar = true,
  runtimes,
  loader,
  code: codeSnippet,
  hasCode = false,
  codePanel = true,
  lazy = false,
  allowExperimentalRuntimes = false,
} = Astro.props;

const permittedRuntimes = allowExperimentalRuntimes ? InternalAdapterIds : AdapterIds;
const effectiveRuntimes = selectRuntimeIds(runtimes, permittedRuntimes);
const effectiveInitialRuntime = effectiveRuntimes.includes(initialRuntime)
  ? initialRuntime
  : effectiveRuntimes[0]!;
const autoCodeMap = demoId && codePanel ? findCodeMapForDemo(demoId) : undefined;
const effectiveHasCode = codePanel && (hasCode || !!autoCodeMap || !!codeSnippet);
const effectiveCode = autoCodeMap ? autoCodeMap[effectiveInitialRuntime] : codeSnippet;

const highlights: Record<string, string> = {};
if (autoCodeMap) {
  for (const [runtime, raw] of Object.entries(autoCodeMap)) {
    highlights[runtime] = await highlightCode(raw, codeLangForRuntime(runtime as RuntimeId));
  }
}

if (!prototypeId && !demoId) {
  throw new Error('[PrototypePreviewer] "prototypeId" or "demoId" is required.');
}

if (prototypeId && demoId) {
  throw new Error('[PrototypePreviewer] "prototypeId" and "demoId" cannot be used together.');
}

assertJsonLike(protoProps);

const rid = `pp-${Math.random().toString(36).slice(2)}`;
---

<div
  class:list={['proto-previewer', className]}
  data-previewer-id={rid}
  data-prototype-id={prototypeId || ''}
  data-demo-id={demoId || ''}
  data-initial-runtime={effectiveInitialRuntime}
  data-props={JSON.stringify(protoProps)}
  data-runtimes={JSON.stringify(effectiveRuntimes)}
  data-loader={loader || ''}
  data-code-map={autoCodeMap ? JSON.stringify(autoCodeMap) : ''}
  data-code-highlights={Object.keys(highlights).length ? JSON.stringify(highlights) : ''}
  data-lazy={lazy ? 'true' : 'false'}
>
  {
    toolbar && (
      <div class="proto-previewer__header">
        <div class="proto-previewer__toolbar">
          <label class="proto-previewer__label">Runtime</label>
          <AdapterSelect />
        </div>
      </div>
    )
  }

  <div
    id={`${rid}-preview`}
    role="tabpanel"
    aria-labelledby={hasCode ? `${rid}-preview-tab` : undefined}
    class="proto-previewer__preview-panel"
    data-panel="preview"
  >
    <div class="proto-previewer__preview" role="region" aria-live="polite">
      <div class="host">
        {lazy && <span class="proto-previewer__skeleton" aria-hidden="true" />}
      </div>
    </div>
  </div>

  {
    effectiveHasCode && (
      <CodePanel code={effectiveCode} lang={codeLangForRuntime(effectiveInitialRuntime)} />
    )
  }

  <style>
    .proto-previewer {
      --proto-previewer-radius: 0.75rem;
      --proto-previewer-border: 1px solid var(--color-border);
      --proto-previewer-bg: color-mix(in oklch, var(--color-muted) 30%, transparent);
      --proto-code-fg: var(--color-code-foreground);
      border: var(--proto-previewer-border);
      border-radius: var(--proto-previewer-radius);
      overflow: hidden;
    }

    .proto-previewer__header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem 1rem;
      border-bottom: var(--proto-previewer-border);
      background: color-mix(in oklch, var(--color-muted) 12%, transparent);
    }

    .proto-previewer__toolbar {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .proto-previewer__label {
      font-size: 0.8125rem;
      color: var(--color-muted-foreground);
    }

    .proto-previewer__toolbar select {
      padding: 0.375rem 0.625rem;
      font-size: 0.8125rem;
      border: 1px solid var(--color-border);
      border-radius: 0.375rem;
      background: var(--color-background);
      color: var(--color-foreground);
    }

    .proto-previewer__preview-panel {
      display: block;
    }

    .proto-previewer__preview {
      padding: 1.5rem;
      min-height: 16rem;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--proto-previewer-bg);
    }

    .proto-previewer__preview .host {
      min-height: 9rem;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .proto-previewer__skeleton {
      width: min(9rem, 58%);
      height: 2.5rem;
      border-radius: 0.5rem;
      background: linear-gradient(
        100deg,
        color-mix(in oklch, var(--color-muted) 55%, transparent) 30%,
        color-mix(in oklch, var(--color-muted) 85%, transparent) 48%,
        color-mix(in oklch, var(--color-muted) 55%, transparent) 66%
      );
      background-size: 260% 100%;
      animation: proto-previewer-skeleton 1.5s ease-in-out infinite;
    }

    @keyframes proto-previewer-skeleton {
      from {
        background-position: 100% 0;
      }
      to {
        background-position: 0 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .proto-previewer__skeleton {
        animation: none;
      }
    }

    @media (max-width: 640px) {
      .proto-previewer__preview {
        padding: 1.1rem;
        min-height: 14rem;
      }

      .proto-previewer__preview .host {
        min-height: 8rem;
      }
    }
  </style>

  <script>
    import type { RuntimeId } from './runtimes/registry';
    const defaultRuntimeIds: RuntimeId[] = ['wc', 'react', 'vue', 'vue2'];

    async function mount(root: HTMLElement) {
      if (root.dataset.inited === '1' || root.dataset.mounting === '1') return;
      root.dataset.mounting = '1';
      const prototypeId = root.dataset.prototypeId || '';
      const demoId = root.dataset.demoId || '';
      const initialRuntime = (root.dataset.initialRuntime || 'wc') as RuntimeId;
      const demoProps = root.dataset.props ? JSON.parse(root.dataset.props) : {};
      const runtimeList = root.dataset.runtimes
        ? JSON.parse(root.dataset.runtimes)
        : defaultRuntimeIds;
      const loader = root.dataset.loader || '';

      if (!prototypeId && !demoId) {
        console.error('[PrototypePreviewer] missing prototypeId or demoId', root);
        delete root.dataset.mounting;
        return;
      }

      try {
        const { initPreviewer } = await import('./previewer-client');
        if (!root.isConnected) return;
        initPreviewer({
          root,
          prototypeId,
          demoId,
          initialRuntime,
          demoProps,
          runtimeList,
          loader,
        });
      } finally {
        delete root.dataset.mounting;
      }
    }

    function init() {
      document
        .querySelectorAll<HTMLElement>('.proto-previewer[data-previewer-id]:not([data-inited])')
        .forEach((root) => {
          if (root.dataset.lazy !== 'true') {
            void mount(root);
            return;
          }

          if (root.dataset.lazyObserved === '1') return;
          root.dataset.lazyObserved = '1';

          if (typeof IntersectionObserver === 'undefined') {
            void mount(root);
            return;
          }

          const observer = new IntersectionObserver(
            (entries) => {
              if (!entries.some((entry) => entry.isIntersecting)) return;
              observer.disconnect();
              void mount(root);
            },
            { rootMargin: '360px 0px' }
          );
          observer.observe(root);
        });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    document.addEventListener('astro:page-load', init);
  </script>
</div>
