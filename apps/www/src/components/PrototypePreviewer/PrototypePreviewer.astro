---
import {
  AdapterIds,
  InternalAdapterIds,
  selectRuntimeIds,
  type RuntimeId,
} from './runtimes/registry';
import AdapterSelect from '../override/AdapterSelect.astro';
import CodePanel from './CodePanel.astro';
import { highlightCode, type CodeLang } from './code-highlight';
import { tryResolveProjectionRecipe } from './projection-families';

function codeLangForRuntime(runtime: RuntimeId): CodeLang {
  if (runtime === 'vue' || runtime === 'vue2') return 'vue';
  if (runtime === 'react') return 'tsx';
  return 'html';
}

interface Props {
  prototypeId?: string; // 原型 ID（与 demoId 二选一）
  demoId?: string; // demo ID（*.demo.ts）
  initialRuntime?: RuntimeId; // 默认 'wc'
  props?: Record<string, unknown>; // 传给原型适配后组件的 props
  class?: string;
  toolbar?: boolean; // 是否渲染运行时切换 UI，默认 true
  runtimes?: RuntimeId[]; // 可选的运行时列表，默认使用全部 public AdapterIds
  loader?: string; // 动态导入路径，例如 './demo-inline'
  /** 可选：展示的代码片段，提供后显示 Preview | Code 标签页 */
  code?: string;
  hasCode?: boolean;
  codePanel?: boolean;
  lazy?: boolean; // 进入视口附近后再加载 demo 与原型模块
  /** Allows internal validation pages to opt into runtimes outside the public adapter set. */
  allowExperimentalRuntimes?: boolean;
}

function assertJsonLike(value: unknown, path: string[] = []) {
  const makePath = () => (path.length === 0 ? '(root)' : path.join('.'));
  const fail = (detail: string) => {
    throw new Error(
      `[PrototypePreviewer] props 必须是 JSON-like 数据。\n` +
        `非法值位置: ${makePath()}\n` +
        `问题: ${detail}`
    );
  };

  if (value === null) return;
  const t = typeof value;
  if (t === 'string' || t === 'number' || t === 'boolean') return;
  if (t === 'undefined' || t === 'function' || t === 'symbol' || t === 'bigint') {
    fail(`不支持的类型 "${t}"`);
  }
  if (Array.isArray(value)) {
    for (let i = 0; i < value.length; i++) {
      assertJsonLike(value[i], [...path, `[${i}]`]);
    }
    return;
  }
  if (t === 'object') {
    if (Object.getPrototypeOf(value) !== Object.prototype) {
      fail('仅支持普通对象');
    }
    for (const [k, v] of Object.entries(value as Record<string, unknown>)) {
      assertJsonLike(v, [...path, k]);
    }
    return;
  }

  fail(`不支持的类型 "${t}"`);
}

// 自动扫描 demo_components 下的所有 codeMap 文件
const codeMapModules = import.meta.glob('../../content/docs/demo_components/**/*Code.ts', {
  eager: true,
});

function findCodeMapForDemo(targetDemoId: string): Partial<Record<RuntimeId, string>> | undefined {
  for (const mod of Object.values(codeMapModules)) {
    const map = (mod as { codeMap?: Partial<Record<RuntimeId, Record<string, string>>> }).codeMap;
    if (!map) continue;
    const hasDemo = Object.values(map).some((runtimeMap) => targetDemoId in runtimeMap);
    if (!hasDemo) continue;
    const result: Partial<Record<RuntimeId, string>> = {};
    for (const [runtime, runtimeMap] of Object.entries(map)) {
      if (runtimeMap[targetDemoId]) {
        result[runtime as RuntimeId] = runtimeMap[targetDemoId];
      }
    }
    return result;
  }
  return undefined;
}

const {
  prototypeId,
  demoId,
  initialRuntime = 'wc',
  props: protoProps = {},
  class: className = '',
  toolbar = true,
  runtimes,
  loader,
  code: codeSnippet,
  hasCode = false,
  codePanel = true,
  lazy = false,
  allowExperimentalRuntimes = false,
} = Astro.props;

const permittedRuntimes = allowExperimentalRuntimes ? InternalAdapterIds : AdapterIds;
const effectiveRuntimes = selectRuntimeIds(runtimes, permittedRuntimes);
const effectiveInitialRuntime = effectiveRuntimes.includes(initialRuntime)
  ? initialRuntime
  : effectiveRuntimes[0]!;
const autoCodeMap = demoId && codePanel ? findCodeMapForDemo(demoId) : undefined;
const effectiveHasCode = codePanel && (hasCode || !!autoCodeMap || !!codeSnippet);
const effectiveCode = autoCodeMap ? autoCodeMap[effectiveInitialRuntime] : codeSnippet;
const projectionRecipe = demoId ? tryResolveProjectionRecipe(demoId) : null;

const highlights: Record<string, string> = {};
if (autoCodeMap) {
  for (const [runtime, raw] of Object.entries(autoCodeMap)) {
    highlights[runtime] = await highlightCode(raw, codeLangForRuntime(runtime as RuntimeId));
  }
}

if (!prototypeId && !demoId) {
  throw new Error('[PrototypePreviewer] "prototypeId" or "demoId" is required.');
}

if (prototypeId && demoId) {
  throw new Error('[PrototypePreviewer] "prototypeId" and "demoId" cannot be used together.');
}

assertJsonLike(protoProps);

const rid = `pp-${Math.random().toString(36).slice(2)}`;
const isZh = Astro.url.pathname.startsWith('/zh-cn/');
---

<div
  class:list={['proto-previewer', 'pui-runtime-box', className]}
  data-previewer-id={rid}
  data-prototype-id={prototypeId || ''}
  data-demo-id={demoId || ''}
  data-initial-runtime={effectiveInitialRuntime}
  data-props={JSON.stringify(protoProps)}
  data-runtimes={JSON.stringify(effectiveRuntimes)}
  data-loader={loader || ''}
  data-code-map={autoCodeMap ? JSON.stringify(autoCodeMap) : ''}
  data-code-highlights={Object.keys(highlights).length ? JSON.stringify(highlights) : ''}
  data-lazy={lazy ? 'true' : 'false'}
  data-projection-mode={projectionRecipe ? 'fixed-family' : undefined}
  data-projection-family={projectionRecipe?.projectionFamilyId}
  data-projection-component={projectionRecipe?.familyId}
  data-projection-toolbar={projectionRecipe ? String(toolbar) : undefined}
>
  {
    toolbar && !projectionRecipe && (
      <div class="proto-previewer__header">
        <div class="proto-previewer__toolbar">
          <label class="proto-previewer__label">Runtime</label>
          <AdapterSelect />
        </div>
      </div>
    )
  }

  <div
    id={`${rid}-preview`}
    role="tabpanel"
    aria-labelledby={hasCode ? `${rid}-preview-tab` : undefined}
    class="proto-previewer__preview-panel"
    data-panel="preview"
  >
    <div class="proto-previewer__preview" role="region" aria-live="polite">
      <div class="host">
        <span class="proto-previewer__skeleton">{isZh ? '交互示例' : 'Interactive preview'}</span>
        <noscript
          >{
            isZh
              ? '交互示例需要 JavaScript；正文和源码仍可阅读。'
              : 'Interactive previews require JavaScript; the article and source remain readable.'
          }</noscript
        >
      </div>
    </div>
  </div>

  {
    effectiveHasCode && (
      <CodePanel code={effectiveCode} lang={codeLangForRuntime(effectiveInitialRuntime)} />
    )
  }

  <style>
    .proto-previewer {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
      min-width: 0;
    }

    .proto-previewer__header {
      display: flex;
      min-width: 0;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem;
      padding: var(--runtime-box-toolbar-padding);
    }

    .proto-previewer__toolbar {
      display: flex;
      min-width: 0;
      max-width: 100%;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
    }

    .proto-previewer__label {
      font-size: 0.75rem;
      color: var(--color-muted-foreground);
    }

    .proto-previewer__preview-panel {
      display: block;
      min-width: 0;
    }

    .proto-previewer__preview {
      padding: 0;
      min-height: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .proto-previewer__preview .host {
      min-width: 0;
      max-width: 100%;
      min-height: 7rem;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .proto-previewer[data-projection-mode='fixed-family'] .proto-previewer__preview {
      padding: 0;
      display: block;
    }

    .proto-previewer[data-projection-mode='fixed-family'] .proto-previewer__preview .host {
      position: relative;
      display: block;
    }

    .proto-previewer[data-projection-mode='fixed-family'] :global(.pui-projection-generation),
    .proto-previewer[data-projection-mode='fixed-family'] :global(.pui-projection-scope) {
      width: 100%;
    }

    .proto-previewer[data-projection-mode='fixed-family'] :global(.pui-projection-scope) {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .proto-previewer[data-projection-mode='fixed-family'] :global(.pui-projection-controls) {
      display: flex;
      min-width: 0;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.875rem;
      padding: var(--runtime-box-toolbar-padding);
    }

    .proto-previewer[data-projection-mode='fixed-family'] :global(.pui-projection-controls:empty) {
      display: none;
    }

    .proto-previewer[data-projection-mode='fixed-family'] :global(.pui-projection-control) {
      display: flex;
      align-items: center;
      flex-wrap: nowrap;
      gap: 0.75rem;
      min-width: 0;
    }

    .proto-previewer[data-projection-mode='fixed-family'] :global(.pui-projection-content) {
      padding: 0;
      min-width: 0;
      max-width: 100%;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .proto-previewer__skeleton {
      font-size: 0.875rem;
      line-height: 1.5;
    }

    @media (max-width: 640px) {
      .proto-previewer__preview {
        padding: 0;
      }

      .proto-previewer__preview .host {
        min-height: 7rem;
      }
    }
  </style>

  <script>
    import { initPreviewerBootstrap } from './previewer-bootstrap';
    initPreviewerBootstrap(document);
  </script>
</div>
