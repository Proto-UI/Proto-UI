---
interface Props {
  id?: string;
  class?: string;
}
const locale = Astro.locals.starlightRoute.locale === 'en' ? 'en' : 'zh-cn';
const { id = 'home-demo-previewer', class: className = '' } = Astro.props;
const copy =
  locale === 'en'
    ? {
        title: 'Interactive components',
        family: 'Page style',
        loading: 'Preparing',
        ready: 'Ready',
        error: 'Error',
      }
    : { title: '交互组件', family: '页面风格', loading: '准备中', ready: '就绪', error: '错误' };
const projectionOwner = `${id}-projection-${Math.random().toString(36).slice(2)}`;
---

<section
  id={id}
  class:list={['home-demo-previewer', className]}
  aria-label={copy.title}
  data-home-showcase="website-component-gallery"
  data-locale={locale}
  data-projection-owner={projectionOwner}
  data-family-label={copy.family}
  data-runner-state="loading"
  data-runner-runtime="wc"
  data-status-loading={copy.loading}
  data-status-ready={copy.ready}
  data-status-error={copy.error}
>
  <div class="home-demo-previewer__host" data-home-demo-host aria-busy="true"></div>
  <output class="home-demo-previewer__status" data-home-demo-status aria-live="polite">
    {copy.loading}
  </output>
</section>

<style>
  /* App-owned layout and type only. Interactive surfaces belong to the selected PUI library. */
  .home-demo-previewer {
    width: min(100%, 78rem);
    margin: 0 auto;
    padding: 0 0 3rem;
    scroll-margin-block: 8rem;
    font-family: var(--font-sans);
  }
  .home-demo-previewer__host {
    position: relative;
    min-height: 20rem;
    width: 100%;
  }
  .home-demo-previewer :global(.pui-projection-generation),
  .home-demo-previewer :global(.pui-projection-scope),
  .home-demo-previewer :global(.pui-projection-content) {
    width: 100%;
    min-width: 0;
  }
  .home-demo-previewer :global(.pui-projection-controls:empty) {
    display: none;
  }
  .home-demo-previewer__status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
  .home-demo-previewer[data-runner-state='error'] .home-demo-previewer__status,
  .home-demo-previewer[data-runner-state='loading'] .home-demo-previewer__status {
    position: static;
    display: block;
    width: auto;
    height: auto;
    margin: 0.75rem 0 0;
    clip: auto;
    white-space: normal;
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .home-demo-previewer :global(.home-settings) {
    display: grid;
    gap: 1.5rem;
  }
  .home-demo-previewer :global(.home-settings__title) {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .home-demo-previewer :global(.home-settings__fields) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }
  .home-demo-previewer :global(.home-settings__preferences) {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-settings__field) {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-settings__label) {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.5;
  }
  .home-demo-previewer :global(.home-settings__switch-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .home-demo-previewer :global(.home-settings__muted) {
    font-size: 0.75rem;
    line-height: 1.5;
    text-align: right;
  }
  .home-demo-previewer :global(.home-settings__footer) {
    display: grid;
    gap: 0.875rem;
  }
  .home-demo-previewer :global(.home-settings__actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .home-demo-previewer :global(.home-settings__feedback) {
    min-height: 1.5em;
    font-size: 0.8125rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .home-demo-previewer :global(.home-gallery) {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
  }
  .home-demo-previewer :global(.home-gallery__column),
  .home-demo-previewer :global(.home-gallery__card-body),
  .home-demo-previewer :global(.home-gallery__stack) {
    display: grid;
    align-content: start;
    gap: 1rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__column) {
    gap: 1rem;
  }
  .home-demo-previewer :global(.home-gallery__item) {
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__card-heading) {
    display: grid;
    gap: 0.25rem;
  }
  .home-demo-previewer :global(.home-gallery__title) {
    font-size: 1rem;
    line-height: 1.5;
    font-weight: 600;
  }
  .home-demo-previewer :global(.home-gallery__caption) {
    font-size: 0.6875rem;
    line-height: 1.5;
    color: var(--color-muted-foreground);
  }
  .home-demo-previewer :global(.home-gallery__copy),
  .home-demo-previewer :global(.home-gallery__status),
  .home-demo-previewer :global(.home-gallery__choice-label) {
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .home-demo-previewer :global(.home-gallery__row) {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .home-demo-previewer :global(.home-gallery__choice) {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__text-preview) {
    min-height: 8rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 0.9375rem;
    line-height: 1.7;
  }
  .home-demo-previewer :global(.home-settings),
  .home-demo-previewer :global(.home-settings__fields),
  .home-demo-previewer :global(.home-settings__preferences) {
    gap: 1rem;
  }
  .home-demo-previewer :global(.home-settings__field) {
    gap: 0.5rem;
  }
  .home-demo-previewer :global(.home-settings__actions) {
    gap: 0.5rem;
  }
  .home-demo-previewer :global(.home-settings__label) {
    font-size: 0.8125rem;
  }
  @media (max-width: 1199px) {
    .home-demo-previewer :global(.home-gallery) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 639px) {
    .home-demo-previewer :global(.home-gallery) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
