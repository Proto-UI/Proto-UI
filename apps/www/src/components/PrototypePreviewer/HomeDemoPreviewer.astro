---
import HomepageGhostCard from '../Homepage/HomepageGhostCard.astro';
interface Props {
  id?: string;
  class?: string;
}
const locale = Astro.locals.starlightRoute.locale === 'en' ? 'en' : 'zh-cn';
const { id = 'home-demo-previewer', class: className = '' } = Astro.props;
const copy =
  locale === 'en'
    ? {
        title: 'Interactive components',
        family: 'Page style',
        loading: 'Preparing',
        ready: 'Ready',
        error: 'Error',
        noScript: 'These interactive examples need JavaScript.',
        documentation: 'Read the component documentation',
      }
    : {
        title: '交互组件',
        family: '页面风格',
        loading: '准备中',
        ready: '就绪',
        error: '错误',
        noScript: '这些交互示例需要 JavaScript。',
        documentation: '阅读组件文档',
      };
const projectionOwner = `${id}-projection-${Math.random().toString(36).slice(2)}`;
---

<section
  id={id}
  class:list={['home-demo-previewer', className]}
  aria-label={copy.title}
  data-home-showcase="website-component-gallery"
  data-locale={locale}
  data-projection-owner={projectionOwner}
  data-family-label={copy.family}
  data-runner-state="loading"
  data-runner-runtime="wc"
  data-status-loading={copy.loading}
  data-status-ready={copy.ready}
  data-status-error={copy.error}
>
  <div class="home-demo-previewer__viewport" aria-hidden="true" inert>
    <div class="home-demo-previewer__backdrop">
      {
        ['left', 'right'].map((side) => (
          <div class:list={['home-demo-previewer__rail', `home-demo-previewer__rail--${side}`]}>
            {[0, 1, 2].map((index) => (
              <HomepageGhostCard tall={index === 1} />
            ))}
          </div>
        ))
      }
    </div>
  </div>
  <noscript>
    <p data-home-demo-nojs>
      {copy.noScript}
      <a href={`/${locale}/ui-libraries/shadcn/accordion/`}>{copy.documentation}</a>
    </p>
  </noscript>
  <div class="home-demo-previewer__skeleton" data-home-demo-skeleton aria-hidden="true" inert>
    {
      [0, 1, 2, 3, 4].map((col) => (
        <div class="home-demo-previewer__skeleton-col">
          <HomepageGhostCard tall={col % 2 === 1} />
          <HomepageGhostCard tall={col % 2 === 0} />
        </div>
      ))
    }
  </div>
  <div id={`${id}-demos`} class="home-demo-previewer__host" data-home-demo-host aria-busy="true">
  </div>
  <output
    class="home-demo-previewer__status"
    data-home-demo-status
    data-site-typography="caption"
    aria-live="polite"
  >
    {copy.loading}
  </output>
</section>

<style>
  /* App-owned layout only. Text and Interactive surfaces belong to the selected PUI library. */
  .home-demo-previewer {
    /* Upstream shadcn apps/v4 CardsDemo rhythm: --gap 2rem, lg 1.5rem,
       >=1900px 2.5rem; top inset p-12, lg p-6, >=1900px p-12, pb-0. */
    --homepage-gallery-gap: 2rem;
    --homepage-gallery-inset-block-start: 3rem;
    /* Upstream bottom fade h-48 / lg:h-80 / xl:h-64, bounded for short stages. */
    --homepage-gallery-fade: min(12rem, 28%);
    --homepage-gallery-column-gap: var(--homepage-gallery-gap);
    --homepage-gallery-row-gap: var(--homepage-gallery-gap);
    --homepage-gallery-wide-columns: 5;
    position: relative;
    width: min(100%, 116rem);
    margin: 0 auto;
    padding: var(--homepage-gallery-inset-block-start) 0 0;
    scroll-margin-block: 8rem;
  }
  @media (min-width: 64rem) {
    .home-demo-previewer {
      --homepage-gallery-gap: 1.5rem;
      --homepage-gallery-inset-block-start: 1.5rem;
      --homepage-gallery-fade: min(20rem, 28%);
    }
  }
  @media (min-width: 80rem) {
    .home-demo-previewer {
      --homepage-gallery-fade: min(16rem, 28%);
    }
  }
  @media (min-width: 118.75rem) {
    .home-demo-previewer {
      --homepage-gallery-gap: 2.5rem;
      --homepage-gallery-inset-block-start: 3rem;
    }
  }
  /* Shadcn page style only: the full-bleed bg-muted stage with its upstream
     top fade (background -> muted) and bottom fade back to background. Dark
     mode keeps bg-background, as upstream does. border-image outset paints
     edge to edge without creating horizontal scroll overflow. */
  :global(html[data-site-library-family='shadcn']:not([data-theme='dark'])) .home-demo-previewer {
    border-image: linear-gradient(
        to bottom,
        var(--color-background),
        var(--color-muted) min(15rem, 30%),
        var(--color-muted) calc(100% - var(--homepage-gallery-fade)),
        var(--color-background)
      )
      fill 0 / 0 / 0 100vw;
  }
  /* Decorative continuation is clipped independently, never the live controls
     or their focus outlines. These are deliberately inert artwork, not demos. */
  .home-demo-previewer__viewport {
    --homepage-gallery-paint-gutter: 1rem;
    --homepage-gallery-viewport-outset: max(0px, calc((100vw - 100% - 2rem) / 2));
    display: none;
    position: absolute;
    inset-block-start: calc(-1 * var(--homepage-gallery-paint-gutter));
    inset-inline: 0;
    height: 100%;
    box-sizing: content-box;
    /* Padding expands the clipping box to the viewport; equal negative margins
       preserve its content width as the live stage's exact rail reference. */
    padding-inline: var(--homepage-gallery-viewport-outset);
    margin-inline: calc(-1 * var(--homepage-gallery-viewport-outset));
    padding-block-start: var(--homepage-gallery-paint-gutter);
    overflow: clip;
    /* Preserve viewport clearance when enlarged text leaves no outward room. */
    clip-path: inset(0 max(0px, calc((100% - 100vw + 2rem) / 2)) 0);
    pointer-events: none;
    user-select: none;
  }
  .home-demo-previewer__backdrop {
    position: relative;
    width: 100%;
    height: 100%;
    color: var(--color-muted-foreground);
    opacity: 0.24;
  }
  .home-demo-previewer__rail {
    /* The padded mask admits outside family paint. Equal negative margins
       retain card tracks; fade stops remain at 68%/100% of their content height. */
    mask-image: linear-gradient(
      to bottom,
      black,
      black calc(68% - var(--homepage-gallery-paint-gutter) * 0.3),
      transparent calc(100% - var(--homepage-gallery-paint-gutter))
    );
    box-sizing: content-box;
    padding: var(--homepage-gallery-paint-gutter);
    margin: calc(-1 * var(--homepage-gallery-paint-gutter));
    position: absolute;
    top: 0;
    display: grid;
    gap: var(--homepage-gallery-row-gap);
    width: calc(
      (100% - (var(--homepage-gallery-wide-columns) - 1) * var(--homepage-gallery-column-gap)) /
        var(--homepage-gallery-wide-columns)
    );
  }
  .home-demo-previewer__rail--left {
    inset-inline-end: calc(100% + var(--homepage-gallery-column-gap));
  }
  .home-demo-previewer__rail--right {
    inset-inline-start: calc(100% + var(--homepage-gallery-column-gap));
  }
  @media (min-width: 124rem) {
    .home-demo-previewer__viewport {
      display: block;
    }
  }
  .home-demo-previewer__host {
    position: relative;
    min-height: 20rem;
    width: 100%;
  }
  .home-demo-previewer__host:empty {
    min-height: 0;
  }
  .home-demo-previewer__skeleton {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--homepage-gallery-column-gap);
    width: 100%;
    color: var(--color-muted-foreground);
    opacity: 0.45;
    pointer-events: none;
    user-select: none;
    mask-image: linear-gradient(to bottom, black, black 72%, transparent 100%);
  }
  .home-demo-previewer__skeleton-col {
    display: grid;
    align-content: start;
    gap: var(--homepage-gallery-row-gap);
    min-width: 0;
  }
  .home-demo-previewer__skeleton-col:nth-child(n + 2) {
    display: none;
  }
  @media (min-width: 48rem) {
    .home-demo-previewer__skeleton {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .home-demo-previewer__skeleton-col:nth-child(2) {
      display: grid;
    }
  }
  @media (min-width: 72rem) {
    .home-demo-previewer__skeleton {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .home-demo-previewer__skeleton-col:nth-child(3) {
      display: grid;
    }
  }
  @media (min-width: 96rem) {
    .home-demo-previewer__skeleton {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .home-demo-previewer__skeleton-col:nth-child(n + 4) {
      display: grid;
    }
  }
  /* Ghost cards cover cold acquisition only. A committed gallery stays usable
     during a switch, with the existing regional cancel/retry controls. */
  .home-demo-previewer[data-projection-generation] .home-demo-previewer__skeleton,
  .home-demo-previewer[data-runner-state='ready'] .home-demo-previewer__skeleton,
  .home-demo-previewer[data-runner-state='error'] .home-demo-previewer__skeleton {
    display: none;
  }
  .home-demo-previewer:not([data-projection-generation])
    :global([data-runtime-loading-mask][data-state='loading'] [data-demo-ref='scrim']),
  .home-demo-previewer:not([data-projection-generation])
    :global([data-runtime-loading-mask][data-state='loading'] [data-demo-ref='panel']) {
    display: none !important;
  }
  .home-demo-previewer :global(.pui-projection-generation),
  .home-demo-previewer :global(.pui-projection-scope),
  .home-demo-previewer :global(.pui-projection-content) {
    width: 100%;
    min-width: 0;
  }
  .home-demo-previewer :global(.pui-projection-controls:empty) {
    display: none;
  }
  .home-demo-previewer__status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
  .home-demo-previewer:not([data-runtime-mask-ready='true'])[data-runner-state='error']
    .home-demo-previewer__status {
    position: static;
    display: block;
    width: auto;
    height: auto;
    margin: 0.75rem 0 0;
    clip: auto;
    white-space: normal;
  }
  .home-demo-previewer :global(.home-settings) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
    gap: 1rem;
  }
  .home-demo-previewer :global(.home-settings__fields) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }
  .home-demo-previewer :global(.home-settings__preferences) {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-settings__field) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-settings__switch-row) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .home-demo-previewer :global(.home-settings__muted) {
    text-align: right;
  }
  .home-demo-previewer :global(.home-settings__footer) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
    gap: 0.625rem;
  }
  .home-demo-previewer :global(.home-settings__actions) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
  }
  .home-demo-previewer :global(.home-settings__feedback) {
    min-height: 1.25em;
    overflow-wrap: anywhere;
  }
  .home-demo-previewer :global(.home-gallery) {
    --homepage-gallery-compact-row-gap: var(--homepage-gallery-gap);
  }
  .home-demo-previewer :global(.home-gallery__viewport) {
    position: relative;
    width: 100%;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__stage) {
    /* App-owned rhythm only. Component paint, radii and elevation stay in Proto UI. */
    position: relative;
    columns: 18rem;
    column-gap: var(--homepage-gallery-column-gap);
  }
  /* The page decoration is not a scrolling mask or a pointer/focus boundary.
     Its unscaled viewport keeps the same fade on desktop and the live mobile
     overview. Attribution and focused controls remain outside its paint. */
  .home-demo-previewer :global(.home-gallery__viewport)::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: min(8rem, 28%);
    z-index: 1;
    pointer-events: none;
    background-image: linear-gradient(
      to top,
      var(--color-background),
      color-mix(in srgb, var(--color-background) 65%, transparent) 30%,
      transparent
    );
  }
  /* Shadcn: the card fade shares the stage's fade length and ends in the same
     background, so cards and the full-bleed band dissolve together. */
  :global(html[data-site-library-family='shadcn'])
    .home-demo-previewer
    :global(.home-gallery__viewport)::after {
    height: var(--homepage-gallery-fade);
    background-image: linear-gradient(to top, var(--color-background), transparent);
  }
  .home-demo-previewer :global(.home-gallery__viewport:focus-within)::after {
    visibility: hidden;
  }
  @media (forced-colors: active), (prefers-reduced-transparency: reduce) {
    .home-demo-previewer :global(.home-gallery__viewport)::after {
      display: none;
    }
  }
  .home-demo-previewer :global(.home-gallery__card-body),
  .home-demo-previewer :global(.home-gallery__stack) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: 0.875rem;
    min-width: 0;
  }
  /* Keep the authored reading/tab order while allowing cards, not fixed
     groups, to fill responsive columns. No component paint is owned here. */
  .home-demo-previewer :global(.home-gallery__column) {
    display: contents;
  }
  .home-demo-previewer :global(.home-gallery__item) {
    min-width: 0;
    break-inside: avoid;
    margin-block-end: var(--homepage-gallery-row-gap);
  }
  .home-demo-previewer :global(.home-gallery__item--compact) {
    margin-block-end: var(--homepage-gallery-compact-row-gap);
  }
  /* Finite density/emphasis vocabulary. Quiet cards only reduce authored body
     spacing; accent cards reserve a slightly roomier stack. No per-card skins. */
  .home-demo-previewer :global(.home-gallery__item--quiet .home-gallery__card-body),
  .home-demo-previewer :global(.home-gallery__item--quiet .home-gallery__stack) {
    gap: 0.75rem;
  }
  .home-demo-previewer :global(.home-gallery__item--accent .home-gallery__card-body),
  .home-demo-previewer :global(.home-gallery__item--accent .home-gallery__stack) {
    gap: 1rem;
  }
  .home-demo-previewer :global(.home-gallery__header-split) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__title-row) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__icon) {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    color: inherit;
  }
  .home-demo-previewer :global(.home-gallery__media) {
    width: 100%;
    min-width: 0;
    padding-inline: 1.25rem;
    box-sizing: border-box;
    display: grid;
    gap: 0.5rem;
  }
  .home-demo-previewer :global(.home-gallery__card-body .home-gallery__media) {
    padding-inline: 0;
  }
  .home-demo-previewer :global(.home-gallery__media--bleed) {
    width: 100%;
    min-width: 0;
    padding-inline: 0;
    display: block;
  }
  .home-demo-previewer :global(.home-gallery__chart) {
    display: block;
    color: var(--pui-foreground, currentColor);
  }
  .home-demo-previewer :global(.home-gallery__chart-bars svg),
  .home-demo-previewer :global(.home-gallery__spark-chart svg) {
    display: block;
    width: 100%;
  }
  .home-demo-previewer :global(.home-gallery__spark-kpi) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__spark-chart) {
    display: block;
    width: 100%;
    color: var(--pui-foreground, currentColor);
    margin-block-start: 0.25rem;
  }
  .home-demo-previewer :global(.home-gallery__metric) {
    font-variant-numeric: tabular-nums;
  }
  .home-demo-previewer :global(.home-gallery__metric-row),
  .home-demo-previewer :global(.home-gallery__meta-row),
  .home-demo-previewer :global(.home-gallery__range-bounds),
  .home-demo-previewer :global(.home-gallery__chart-labels) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__slider-group) {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__stacked-actions) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__chart-labels) {
    padding-inline: 0.25rem;
  }
  .home-demo-previewer :global(.home-gallery__chart-label) {
    flex: 1 1 0;
    text-align: center;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__stats) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .home-demo-previewer :global(.home-gallery__stat) {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }
  /* The icon-free Shadcn example keeps the 4px wrapper inset. Its native
     editor therefore needs 4px more, not the standalone 10px, to align
     to the 8px option text inset. The shell and option paint stay untouched. */
  .home-demo-previewer
    :global(
      [data-gallery-demo='workspace-command']
        [data-projection-prototype='shadcn-command-input-wrapper']
        input
    ) {
    padding-inline-start: 0.25rem;
  }
  .home-demo-previewer :global(.home-gallery__profile),
  .home-demo-previewer :global(.home-gallery__release) {
    display: grid;
    justify-items: center;
    gap: 0.875rem;
    padding-block: 0.5rem;
    text-align: center;
  }
  .home-demo-previewer :global(.home-gallery__profile-copy),
  .home-demo-previewer :global(.home-gallery__release-copy) {
    display: grid;
    gap: 0.375rem;
    justify-items: center;
    max-width: 24ch;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__qr) {
    display: grid;
    place-items: center;
    padding-block: 0.25rem;
    color: var(--pui-foreground, currentColor);
  }
  .home-demo-previewer :global(.home-gallery__qr svg) {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .home-demo-previewer :global(.home-gallery__release-actions) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
  }
  .home-demo-previewer :global(.home-gallery__shortcuts-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__shortcut-list) {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__shortcut-item) {
    padding: 0.25rem 0.5rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__shortcut-row) {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__control-bar) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-width: 0;
  }
  /* Explicit five-column composition on large displays. Narrow layouts retain
     the same authored reading order and flow cards instead of empty tracks. */
  @media (min-width: 96rem) {
    .home-demo-previewer :global(.home-gallery__stage) {
      display: grid;
      grid-template-columns: repeat(var(--homepage-gallery-wide-columns), minmax(0, 1fr));
      align-items: start;
    }
    .home-demo-previewer :global(.home-gallery__column) {
      display: block;
      min-width: 0;
    }
  }
  .home-demo-previewer :global(.home-gallery__attribution) {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    min-width: 0;
    padding-block: 2rem 0.5rem;
    font-size: var(--sl-text-sm, 0.875rem);
    color: var(--sl-color-gray-3, inherit);
  }
  .home-demo-previewer :global(.home-gallery__attribution-link) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .home-demo-previewer :global(.home-gallery__card-heading) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
    gap: 0.25rem;
  }
  .home-demo-previewer :global(.home-gallery__row) {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .home-demo-previewer :global(.home-gallery__choice) {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__choice--detailed) {
    align-items: flex-start;
    gap: 0.625rem;
  }
  .home-demo-previewer :global(.home-gallery__choice--detailed > :first-child) {
    margin-block-start: 0.125rem;
  }
  .home-demo-previewer :global(.home-gallery__choice-copy) {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__text-preview) {
    min-height: 9rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  /* Let intrinsic English labels reflow inside a resized text layout rather
     than widening an implicit grid track. Surface paint stays in Proto UI. */
  .home-demo-previewer :global(.home-gallery__title),
  .home-demo-previewer :global(.home-gallery__caption),
  .home-demo-previewer :global(.home-gallery__choice-label),
  .home-demo-previewer :global(.home-gallery__choice-desc),
  .home-demo-previewer :global(.home-gallery__shortcut-title),
  .home-demo-previewer :global(.home-gallery__shortcut-label),
  .home-demo-previewer :global(.home-gallery__chart-label),
  .home-demo-previewer :global(.home-gallery__stat-value),
