---
interface Props {
  id?: string;
  class?: string;
}
const locale = Astro.locals.starlightRoute.locale === 'en' ? 'en' : 'zh-cn';
const { id = 'home-demo-previewer', class: className = '' } = Astro.props;
const copy =
  locale === 'en'
    ? {
        title: 'Interactive components',
        family: 'Page style',
        loading: 'Preparing',
        ready: 'Ready',
        error: 'Error',
        noScript: 'These interactive examples need JavaScript.',
        documentation: 'Read the component documentation',
      }
    : {
        title: '交互组件',
        family: '页面风格',
        loading: '准备中',
        ready: '就绪',
        error: '错误',
        noScript: '这些交互示例需要 JavaScript。',
        documentation: '阅读组件文档',
      };
const projectionOwner = `${id}-projection-${Math.random().toString(36).slice(2)}`;
---

<section
  id={id}
  class:list={['home-demo-previewer', className]}
  aria-label={copy.title}
  data-home-showcase="website-component-gallery"
  data-locale={locale}
  data-projection-owner={projectionOwner}
  data-family-label={copy.family}
  data-runner-state="loading"
  data-runner-runtime="wc"
  data-status-loading={copy.loading}
  data-status-ready={copy.ready}
  data-status-error={copy.error}
>
  <div class="home-demo-previewer__backdrop" aria-hidden="true" inert>
    {
      ['left', 'right'].map((side) => (
        <div class:list={['home-demo-previewer__rail', `home-demo-previewer__rail--${side}`]}>
          {[0, 1, 2].map((index) => (
            <svg
              viewBox="0 0 288 248"
              fill="none"
              focusable="false"
              class:list={{ 'home-demo-previewer__ghost--tall': index === 1 }}
            >
              <rect x="1" y="1" width="286" height="246" rx="22" stroke="currentColor" />
              <g fill="currentColor" opacity="0.4">
                <rect x="24" y="26" width={index === 1 ? 158 : 112} height="13" rx="6" />
                <rect x="24" y="54" width="204" height="9" rx="4" />
                <rect x="24" y="84" width="240" height={index === 0 ? 64 : 98} rx="10" />
                <rect x="24" y="198" width="104" height="25" rx="12" />
                <rect x="140" y="198" width="124" height="25" rx="12" />
              </g>
            </svg>
          ))}
        </div>
      ))
    }
  </div>
  <noscript>
    <p data-home-demo-nojs>
      {copy.noScript}
      <a href={`/${locale}/ui-libraries/shadcn/accordion/`}>{copy.documentation}</a>
    </p>
  </noscript>
  <div class="home-demo-previewer__host" data-home-demo-host aria-busy="true"></div>
  <output
    class="home-demo-previewer__status"
    data-home-demo-status
    data-site-typography="caption"
    aria-live="polite"
  >
    {copy.loading}
  </output>
</section>

<style>
  /* App-owned layout only. Text and Interactive surfaces belong to the selected PUI library. */
  .home-demo-previewer {
    position: relative;
    width: min(100%, 104rem);
    margin: 0 auto;
    padding: 0;
    scroll-margin-block: 8rem;
  }
  /* Decorative continuation is clipped independently, never the live controls
     or their focus outlines. These are deliberately inert artwork, not demos. */
  .home-demo-previewer__backdrop {
    display: none;
    position: absolute;
    inset-block: 0;
    left: 50%;
    width: calc(100vw - 2rem);
    transform: translateX(-50%);
    overflow: clip;
    pointer-events: none;
    user-select: none;
    color: var(--color-muted-foreground);
    opacity: 0.18;
    mask-image: linear-gradient(to bottom, transparent, black 5%, black 65%, transparent);
  }
  .home-demo-previewer__rail {
    position: absolute;
    top: 1.5rem;
    display: grid;
    gap: 2rem;
    width: 18rem;
  }
  .home-demo-previewer__rail--left {
    right: calc(50% + 54rem);
  }
  .home-demo-previewer__rail--right {
    left: calc(50% + 54rem);
  }
  .home-demo-previewer__rail svg {
    width: 100%;
    height: auto;
  }
  .home-demo-previewer__rail .home-demo-previewer__ghost--tall {
    height: 21rem;
  }
  @media (min-width: 116rem) {
    .home-demo-previewer__backdrop {
      display: block;
    }
  }
  .home-demo-previewer__host {
    position: relative;
    min-height: 20rem;
    width: 100%;
  }
  .home-demo-previewer :global(.pui-projection-generation),
  .home-demo-previewer :global(.pui-projection-scope),
  .home-demo-previewer :global(.pui-projection-content) {
    width: 100%;
    min-width: 0;
  }
  .home-demo-previewer :global(.pui-projection-controls:empty) {
    display: none;
  }
  .home-demo-previewer__status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
  .home-demo-previewer:not([data-runtime-mask-ready='true'])[data-runner-state='error']
    .home-demo-previewer__status,
  .home-demo-previewer:not([data-runtime-mask-ready='true'])[data-runner-state='loading']
    .home-demo-previewer__status {
    position: static;
    display: block;
    width: auto;
    height: auto;
    margin: 0.75rem 0 0;
    clip: auto;
    white-space: normal;
  }
  .home-demo-previewer :global(.home-settings) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
    gap: 1.5rem;
  }
  .home-demo-previewer :global(.home-settings__title) {
  }
  .home-demo-previewer :global(.home-settings__fields) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }
  .home-demo-previewer :global(.home-settings__preferences) {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-settings__field) {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-settings__label) {
  }
  .home-demo-previewer :global(.home-settings__switch-row) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .home-demo-previewer :global(.home-settings__muted) {
    text-align: right;
  }
  .home-demo-previewer :global(.home-settings__footer) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
    gap: 0.875rem;
  }
  .home-demo-previewer :global(.home-settings__actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .home-demo-previewer :global(.home-settings__feedback) {
    min-height: 1.5em;

    overflow-wrap: anywhere;
  }
  .home-demo-previewer :global(.home-gallery) {
    /* App-owned rhythm only. Component paint, radii and elevation stay in Proto UI. */
    --homepage-gallery-column-gap: 2rem;
    --homepage-gallery-row-gap: 1.25rem;
    --homepage-gallery-compact-row-gap: 0.875rem;
    position: relative;
    columns: 18rem;
    column-gap: var(--homepage-gallery-column-gap);
  }
  .home-demo-previewer :global(.home-gallery__card-body),
  .home-demo-previewer :global(.home-gallery__stack) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: 1rem;
    min-width: 0;
  }
  /* Keep the authored reading/tab order while allowing cards, not fixed
     groups, to fill responsive columns. No component paint is owned here. */
  .home-demo-previewer :global(.home-gallery__column) {
    display: contents;
  }
  .home-demo-previewer :global(.home-gallery__item) {
    min-width: 0;
    break-inside: avoid;
    margin-block-end: var(--homepage-gallery-row-gap);
  }
  .home-demo-previewer :global(.home-gallery__item--compact) {
    margin-block-end: var(--homepage-gallery-compact-row-gap);
  }
  /* Finite density/emphasis vocabulary. Quiet cards only reduce authored body
     spacing; accent cards reserve a slightly roomier stack. No per-card skins. */
  .home-demo-previewer :global(.home-gallery__item--quiet .home-gallery__card-body),
  .home-demo-previewer :global(.home-gallery__item--quiet .home-gallery__stack) {
    gap: 0.75rem;
  }
  .home-demo-previewer :global(.home-gallery__item--accent .home-gallery__card-body),
  .home-demo-previewer :global(.home-gallery__item--accent .home-gallery__stack) {
    gap: 1.25rem;
  }
  .home-demo-previewer :global(.home-gallery__title-row) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__icon) {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    color: inherit;
  }
  /* The media is already outside CardContent. Negative margins here used to
     subtract padding a second time and push both end bars outside the card. */
  .home-demo-previewer :global(.home-gallery__media) {
    width: 100%;
    min-width: 0;
    padding-inline: 1.25rem;
    box-sizing: border-box;
  }
  .home-demo-previewer :global(.home-gallery__chart) {
    display: block;
    color: var(--pui-muted-foreground, currentColor);
  }
  .home-demo-previewer :global(.home-gallery__chart-bars svg) {
    display: block;
    width: 100%;
  }
  .home-demo-previewer :global(.home-gallery__metric) {
    font-variant-numeric: tabular-nums;
  }
  .home-demo-previewer :global(.home-gallery__metric-row),
  .home-demo-previewer :global(.home-gallery__chart-labels) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__chart-labels) {
    padding-inline: 0.375rem;
  }
  .home-demo-previewer :global(.home-gallery__chart-label) {
    flex: 1 1 0;
    text-align: center;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__stats) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .home-demo-previewer :global(.home-gallery__stat) {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__profile) {
    display: grid;
    justify-items: center;
    gap: 0.875rem;
    padding-block: 1rem;
    text-align: center;
  }
  /* Explicit five-column composition on large displays. Narrow layouts retain
     the same authored reading order and flow cards instead of empty tracks. */
  @media (min-width: 108rem) {
    .home-demo-previewer :global(.home-gallery) {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      align-items: start;
    }
    .home-demo-previewer :global(.home-gallery__column) {
      display: block;
      min-width: 0;
    }
    .home-demo-previewer :global(.home-gallery__attribution) {
      grid-column: 1 / -1;
    }
  }
  .home-demo-previewer :global(.home-gallery__attribution) {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    min-width: 0;
    column-span: all;
    padding-block: 2rem 0.5rem;
    font-size: var(--sl-text-sm, 0.875rem);
    color: var(--sl-color-gray-3, inherit);
  }
  .home-demo-previewer :global(.home-gallery__attribution-link) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .home-demo-previewer :global(.home-gallery__card-heading) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
    gap: 0.25rem;
  }
  .home-demo-previewer :global(.home-gallery__title) {
  }
  .home-demo-previewer :global(.home-gallery__caption) {
  }
  .home-demo-previewer :global(.home-gallery__copy),
  .home-demo-previewer :global(.home-gallery__status),
  .home-demo-previewer :global(.home-gallery__choice-label) {
  }
  .home-demo-previewer :global(.home-gallery__row) {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .home-demo-previewer :global(.home-gallery__choice) {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-gallery__text-preview) {
    min-height: 11rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .home-demo-previewer :global(.home-settings),
  .home-demo-previewer :global(.home-settings__fields),
  .home-demo-previewer :global(.home-settings__preferences) {
    gap: 1rem;
  }
  .home-demo-previewer :global(.home-settings__field) {
    gap: 0.5rem;
  }
  .home-demo-previewer :global(.home-settings__actions) {
    gap: 0.5rem;
  }
  .home-demo-previewer :global(.home-settings__label) {
  }
  /* Let intrinsic English labels reflow inside a resized text layout rather
     than widening an implicit grid track. Surface paint stays in Proto UI. */
  .home-demo-previewer :global(.home-gallery__title),
  .home-demo-previewer :global(.home-gallery__caption),
  .home-demo-previewer :global(.home-gallery__choice-label),
  .home-demo-previewer :global(.home-gallery__chart-label),
  .home-demo-previewer :global(.home-gallery__stat-value),
  .home-demo-previewer :global(.home-gallery__eyebrow),
  .home-demo-previewer :global(.home-settings__label) {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  @media (max-width: 767px) {
    .home-demo-previewer :global(.home-gallery) {
      --homepage-gallery-column-gap: 1.5rem;
      --homepage-gallery-row-gap: 1rem;
      --homepage-gallery-compact-row-gap: 0.75rem;
    }
  }
  @media (max-width: 639px) {
    .home-demo-previewer :global(.home-gallery) {
      columns: 1;
    }
  }
  /* With scripting enabled, noscript contains text rather than these child elements.
     Hide only the empty loading structure when the real static fallback is present. */
  .home-demo-previewer:has([data-home-demo-nojs]) > .home-demo-previewer__host,
  .home-demo-previewer:has([data-home-demo-nojs])[data-runner-state]
    > .home-demo-previewer__status {
    display: none;
  }
</style>
