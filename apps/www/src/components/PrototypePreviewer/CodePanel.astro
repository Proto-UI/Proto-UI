---
import { codeFileIcon, type CodeFileIcon } from '../code-file-icon';
import StaticLucideIcon from '../StaticLucideIcon.astro';
import CodeScrollArea from './CodeScrollArea.astro';
import SiteCopyBootstrap from '../SiteCopyBootstrap.astro';
import {
  previewButtonTag,
  resolvePreviewControlFamily,
  resolveSiteLibraryFamily,
  siteControlTags,
  type PreviewControlFamily,
} from '../site-library-family';
const siteFamily = resolveSiteLibraryFamily(Astro.url.pathname);
const defaultSiteControls = siteControlTags(siteFamily);
const isChinese = Astro.url.pathname.startsWith('/zh-cn/');
import { highlightCode, type CodeLang, type HighlightLinesInput } from './code-highlight';

export type { CodeLang, HighlightLinesInput } from './code-highlight';

interface Props {
  code: string | undefined;
  lang?: CodeLang;
  highlightLines?: HighlightLinesInput;
  id?: string;
  labelledBy?: string;
  hidden?: boolean;
  fileIndex?: number;
  framed?: boolean;
  /** Required instructions stay readable, including before hydration. */
  collapsible?: boolean;
  copyLabel?: string;
  expandLabel?: string;
  collapseLabel?: string;
  controlFamily?: PreviewControlFamily;
  title?: string;
  scrollableTitle?: boolean;
  titleIcon?: 'terminal' | 'folder-tree' | CodeFileIcon;
  lineNumbers?: boolean;
  presentation?: 'docs';
  scrollLimit?: 'preview' | 'file' | 'unbounded';
  panelRole?: 'tabpanel' | 'region';
}

const {
  code,
  lang = 'tsx',
  highlightLines,
  id,
  labelledBy,
  hidden,
  fileIndex,
  framed = true,
  collapsible = true,
  copyLabel = isChinese ? '复制代码' : 'Copy code',
  expandLabel = isChinese ? '展开代码' : 'View code',
  collapseLabel = isChinese ? '收起代码' : 'Collapse code',
  controlFamily,
  title,
  scrollableTitle = false,
  titleIcon,
  lineNumbers = true,
  presentation,
  scrollLimit,
  panelRole = 'tabpanel',
} = Astro.props;
const effectiveControlFamily = resolvePreviewControlFamily(Astro.url.pathname, controlFamily);
const Button =
  effectiveControlFamily === siteFamily
    ? defaultSiteControls.Button
    : previewButtonTag(effectiveControlFamily);
const highlighted = await highlightCode(code, lang, { highlightLines });
---

<SiteCopyBootstrap />
<!-- Source is readable before hydration and without JavaScript. The client
     owns collapsing long examples and revealing their expansion control. -->
<figure
  id={id}
  class="relative min-w-0 max-w-full"
  role={labelledBy ? panelRole : undefined}
  aria-labelledby={labelledBy}
  hidden={hidden}
  data-code-file-panel={labelledBy || fileIndex !== undefined ? '' : undefined}
  data-code-file-index={fileIndex}
  data-code-shell
  data-code-presentation={presentation}
  data-code-line-numbers={String(lineNumbers)}
  data-code-collapsible={String(collapsible)}
  data-code-expanded="true"
  data-site-code-surface={framed ? 'frame' : undefined}
>
  {
    title && (
      <figcaption class="code-panel__title" data-code-file-header>
        <StaticLucideIcon
          name={titleIcon ?? codeFileIcon(title)}
          size={scrollableTitle ? '16px' : '1rem'}
        />
        <span
          data-code-file-title
          data-code-title-scroll={scrollableTitle ? '' : undefined}
          tabindex={scrollableTitle ? 0 : undefined}
          set:text={title}
        />
        <div
          class="site-code-copy-header"
          hidden={collapsible}
          data-copy
          data-site-copy
          data-copy-label={copyLabel}
        />
      </figcaption>
    )
  }
  <div class="group relative min-w-0 max-w-full min-h-12" data-code-inner data-code-expanded="true">
    {
      !title && (
        <div
          class="site-code-copy-overlay"
          hidden={collapsible}
          data-copy
          data-site-copy
          data-copy-label={copyLabel}
        />
      )
    }

    {
      scrollLimit ? (
        <CodeScrollArea
          limit={scrollLimit}
          label={title ?? (isChinese ? '示例代码' : 'Example source')}
        >
          <div class="min-w-0 max-w-full" data-code-content set:html={highlighted} />
        </CodeScrollArea>
      ) : (
        <div class="min-w-0 max-w-full" data-code-content set:html={highlighted} />
      )
    }

    {
      collapsible && (
        <div class="code-panel__collapsed-guard" data-code-expand-guard hidden aria-hidden="true" />
      )
    }

    {
      collapsible && (
        <Button
          data-site-button
          data-site-control-family={effectiveControlFamily}
          data-variant="outline"
          data-size="sm"
          class="absolute left-1/2 bottom-1/2 -translate-x-1/2 translate-y-1/2 z-10"
          data-code-toggle
          hidden
          aria-expanded="false"
          aria-label={expandLabel}
        >
          {expandLabel}
        </Button>
      )
    }
  </div>
  {
    collapsible && (
      <div class="code-panel__collapse-bar" data-code-collapse-bar hidden>
        <Button
          data-site-button
          data-site-control-family={effectiveControlFamily}
          data-variant="outline"
          data-size="sm"
          data-code-collapse
          aria-expanded="true"
          aria-label={collapseLabel}
        >
          {collapseLabel}
        </Button>
      </div>
    )
  }
</figure>

<script>
  import { initSiteControls } from '../site-shadcn-controls';
  import { initCodePanels } from './code-panel-client';

  initSiteControls(document);
  initCodePanels(document);
  document.addEventListener('astro:page-load', () => {
    initSiteControls(document);
    initCodePanels(document);
  });
</script>

<style is:global>
  /* The static pre remains the scroll and focus owner if the browser does not
     upgrade the Shadcn anatomy. A ready viewport is the only scroll owner. */
  [data-code-scroll-root][data-code-scroll-limit='file']:not([data-code-scroll-ready])
    .proto-previewer__code {
    max-height: 28rem;
  }
  [data-code-scroll-root],
  [data-code-scroll-anatomy],
  [data-code-scroll-ready] [data-code-scroll-viewport] {
    display: block;
    min-width: 0;
    max-width: 100%;
  }
  [data-code-scroll-ready] [data-code-scroll-viewport] {
    height: auto;
    overflow: auto;
    overscroll-behavior-x: contain;
    overscroll-behavior-y: auto;
  }
  [data-code-scroll-ready][data-code-scroll-limit='file'] [data-code-scroll-viewport] {
    max-height: 28rem;
  }
  [data-code-scroll-ready][data-code-scroll-limit='preview'] [data-code-scroll-viewport] {
    max-height: min(36rem, 65svh);
  }
  [data-code-expanded='false']
    [data-code-scroll-ready][data-code-scroll-limit='preview']
    [data-code-scroll-viewport] {
    max-height: 4.5rem;
    overflow: hidden !important;
  }
  [data-code-expanded='false'] [data-code-scroll-ready] [data-code-scroll-viewport] {
    overflow: hidden !important;
  }
  [data-code-expanded='false'] [data-code-scroll-track] {
    display: none;
  }
  .code-panel__collapsed-guard {
    position: absolute;
    inset: 0;
    z-index: 5;
    cursor: pointer;
    user-select: none;
    border-radius: var(--docs-code-radius, 0.5rem);
    background: transparent;
    transition: background-color 150ms ease;
  }
  .code-panel__collapsed-guard:hover {
    background: color-mix(in srgb, var(--color-foreground) 4%, transparent);
  }
  .code-panel__collapsed-guard[hidden] {
    display: none;
  }
  .code-panel__collapse-bar {
    display: flex;
    justify-content: center;
    padding: 0.5rem 0.75rem 0.25rem;
  }
  .code-panel__collapse-bar[hidden] {
    display: none;
  }
  @container code-panel (max-width: 14rem) {
    [data-code-expanded='true']
      [data-code-scroll-ready][data-code-scroll-limit='preview']
      [data-code-scroll-viewport] {
      max-height: min(36rem, 65svh, max(6rem, calc(100svh - var(--header-height, 4rem) - 4rem)));
    }
  }
  [data-code-scroll-ready] [data-code-scroll-viewport] .proto-previewer__code {
    box-sizing: border-box;
    width: max-content;
    min-width: 100%;
    max-width: none;
    max-height: none;
    overflow: visible;
  }
  [data-code-expanded='false'] [data-code-scroll-ready] [data-code-scroll-viewport] {
    mask-image: linear-gradient(to bottom, black, transparent);
  }
  [data-code-expanded='false'] [data-code-scroll-ready] [data-code-content] {
    mask-image: none;
  }
  [data-code-scroll-ready] [data-code-scroll-viewport]:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: -2px;
  }
  .code-panel__title {
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-border) 60%, transparent);
    font-size: 0.875rem;
    gap: 0.5rem;
    overflow-wrap: anywhere;
  }
  [data-site-library-family='brutalist'] .code-panel__title,
  [data-site-library-family='bootstrap-2-3-2'] .code-panel__title {
    border-bottom-color: var(--color-border);
  }
  /* Required source reserves a real column for Copy, outside the scroll viewport. */
  [data-code-collapsible='false']:not(:has([data-code-file-header])) [data-code-inner] {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    column-gap: 0.5rem;
  }
  [data-code-collapsible='false']
    [data-code-inner]
    > :is([data-code-content], [data-code-scroll-root]) {
    grid-column: 1;
    grid-row: 1;
  }
  [data-code-collapsible='false'] .site-code-copy-overlay {
    position: static;
    grid-column: 2;
    grid-row: 1;
    margin: 0;
  }
  [data-code-collapsible='false'] .proto-previewer__code {
    max-height: none;
    padding-inline-end: 0;
  }
  .code-panel__title > [data-code-file-title] {
    min-width: 0;
  }
  [data-code-title-scroll] {
    flex: 1 1 auto;
    white-space: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
  }
  [data-code-title-scroll]:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }
  .site-code-copy-header {
    margin-inline-start: auto;
    flex: none;
  }
  [data-code-file-header] + [data-code-inner] {
    padding-inline: 0;
  }
  [data-code-file-header] ~ [data-code-inner] .proto-previewer__code {
    font-size: 0.875rem;
    line-height: 1.3125rem;
  }
  [data-code-file-header] ~ [data-code-inner] .proto-previewer__code > code {
    display: grid;
    min-width: max-content;
  }
  [data-code-file-header] ~ [data-code-inner] .proto-previewer__code .line {
    display: block;
    padding-block: 1px;
  }
  [data-code-presentation='docs'] [data-code-file-header] {
    min-height: 2.625rem;
    padding-block: 0.375rem;
  }
  [data-code-presentation='docs'] [data-code-inner] {
    padding: 0.875rem 1rem;
  }
  [data-code-presentation='docs'] [data-code-inner] .proto-previewer__code .line {
    padding-block: 0;
  }
  [data-code-line-numbers='false'] .proto-previewer__code .line::before {
    display: none;
  }
</style>
