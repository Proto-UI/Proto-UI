---
import SiteCopyBootstrap from '../SiteCopyBootstrap.astro';
import { resolveSiteLibraryFamily, siteControlTags } from '../site-library-family';
const siteFamily = resolveSiteLibraryFamily(Astro.url.pathname);
const { Button } = siteControlTags(siteFamily);
import { highlightCode, type CodeLang } from './code-highlight';

export type { CodeLang } from './code-highlight';

interface Props {
  code: string | undefined;
  lang?: CodeLang;
  id?: string;
  labelledBy?: string;
  hidden?: boolean;
  fileIndex?: number;
  framed?: boolean;
}

const { code, lang = 'tsx', id, labelledBy, hidden, fileIndex, framed = true } = Astro.props;
const highlighted = await highlightCode(code, lang);
---

<SiteCopyBootstrap />
<figure
  id={id}
  class="relative min-w-0 max-w-full"
  role={labelledBy ? 'tabpanel' : undefined}
  aria-labelledby={labelledBy}
  hidden={hidden}
  data-code-file-panel={labelledBy ? '' : undefined}
  data-code-file-index={fileIndex}
  data-code-shell
  data-site-code-surface={framed ? 'frame' : undefined}
>
  <div class="group relative min-w-0 max-w-full min-h-12" data-code-inner>
    <div class="site-code-copy-overlay" hidden data-copy data-site-copy data-copy-label="Copy code">
    </div>

    <div class="min-w-0 max-w-full" data-code-content set:html={highlighted} />

    <Button
      data-site-button
      data-site-control-family={siteFamily}
      data-variant="outline"
      data-size="sm"
      class="absolute left-1/2 bottom-1/2 -translate-x-1/2 translate-y-1/2 z-10"
      data-code-toggle
      aria-expanded="false"
      aria-label="展开代码"
    >
      View code
    </Button>
  </div>
</figure>

<script>
  import { initSiteControls } from '../site-shadcn-controls';
  import { initCodePanels } from './code-panel-client';

  initSiteControls(document);
  initCodePanels(document);
  document.addEventListener('astro:page-load', () => {
    initSiteControls(document);
    initCodePanels(document);
  });
</script>
