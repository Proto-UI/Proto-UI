---
import SiteCopyBootstrap from './SiteCopyBootstrap.astro';
import { resolveSiteLibraryFamily, siteControlTags } from './site-library-family';
const siteFamily = resolveSiteLibraryFamily(Astro.url.pathname);
const { Button } = siteControlTags(siteFamily);
// <InstallCommandCard
//   manager="npm"
//   commands={{
//     pnpm: 'pnpm dlx @proto.ui/cli@0.2.0-rc.0 add react shadcn-button',
//     npm: 'npx @proto.ui/cli@0.2.0-rc.0 add react shadcn-button',
//     yarn: 'yarn dlx @proto.ui/cli@0.2.0-rc.0 add react shadcn-button',
//   }}
// />

type PackageManager = 'pnpm' | 'npm' | 'yarn' | 'bun';

interface Props {
  command?: string;
  manager?: PackageManager | string;
  managers?: (PackageManager | string)[];
  commands?: Partial<Record<PackageManager | string, string>>;
}

const { command, manager = 'npm', managers, commands } = Astro.props;
const shellId = `install-command-${Math.random().toString(36).slice(2)}`;

const normalizedEntries = (() => {
  if (commands && Object.keys(commands).length > 0) {
    const preferredManagers = managers?.length
      ? managers
      : (Object.keys(commands) as (PackageManager | string)[]);
    return preferredManagers
      .filter((item) => typeof commands[item] === 'string' && commands[item])
      .map((item) => ({
        manager: item,
        command: commands[item] as string,
      }));
  }

  if (!command) {
    throw new Error('[InstallCommandCard] Either "command" or "commands" is required.');
  }

  const resolvedManagers = managers?.length ? managers : [manager];
  return resolvedManagers.map((item) => ({
    manager: item,
    command,
  }));
})();

const activeManager =
  normalizedEntries.find((entry) => entry.manager === manager)?.manager ??
  normalizedEntries[0]?.manager;
---

<SiteCopyBootstrap />
<figure
  class="install-command-card"
  data-install-command-card
  data-site-code-surface="frame"
  data-active-manager={activeManager}
  id={shellId}
>
  <div class="install-command-card__toolbar" data-code-toolbar data-site-code-surface="toolbar">
    <div class="install-command-card__managers" aria-label="Package manager">
      {
        normalizedEntries.map((entry) => (
          <Button
            data-site-button
            data-site-control-family={siteFamily}
            data-variant={
              siteFamily === 'brutalist'
                ? entry.manager === activeManager
                  ? 'solid'
                  : 'surface'
                : entry.manager === activeManager
                  ? 'secondary'
                  : 'ghost'
            }
            data-size="sm"
            type="button"
            class:list={[
              'install-command-card__manager',
              entry.manager === activeManager && 'install-command-card__manager--active',
            ]}
            data-manager-tab={entry.manager}
            aria-pressed={entry.manager === activeManager ? 'true' : 'false'}
          >
            {entry.manager}
          </Button>
        ))
      }
    </div>

    <div
      class="install-command-card__copy"
      data-copy-button
      data-site-copy
      data-copy-label="Copy command"
    >
    </div>
  </div>

  {
    normalizedEntries.map((entry) => (
      <pre
        class:list={[
          'install-command-card__body',
          entry.manager === activeManager || 'install-command-card__body--hidden',
        ]}
        tabindex="0"
        aria-label="Install command"
        data-command-panel={entry.manager}
        hidden={entry.manager !== activeManager}
      >
        <code data-command>{entry.command}</code>
      </pre>
    ))
  }
</figure>

<script>
  import { setElementProps } from '@proto.ui/adapter-web-component';

  (() => {
    document.querySelectorAll<HTMLElement>('[data-install-command-card]').forEach((card) => {
      if (card.dataset.installCommandInit === '1') return;
      card.dataset.installCommandInit = '1';

      const tabs = Array.from(card.querySelectorAll<HTMLElement>('[data-manager-tab]'));
      const panels = Array.from(card.querySelectorAll<HTMLElement>('[data-command-panel]'));
      if (tabs.length === 0 || panels.length === 0) return;

      function setActiveManager(nextManager: string) {
        card.dataset.activeManager = nextManager;
        tabs.forEach((tab) => {
          const active = tab.dataset.managerTab === nextManager;
          tab.classList.toggle('install-command-card__manager--active', active);
          tab.setAttribute('aria-pressed', active ? 'true' : 'false');
          setElementProps(tab, {
            variant:
              tab.dataset.siteControlFamily === 'brutalist'
                ? active
                  ? 'solid'
                  : 'surface'
                : active
                  ? 'secondary'
                  : 'ghost',
            size: 'sm',
          });
        });
        panels.forEach((panel) => {
          const active = panel.dataset.commandPanel === nextManager;
          panel.hidden = !active;
          panel.classList.toggle('install-command-card__body--hidden', !active);
        });
      }

      tabs.forEach((tab) => {
        tab.addEventListener('click', (event) => {
          if (
            tab.matches('wc-shadcn-button, wc-brutalist-button') &&
            !(event instanceof CustomEvent)
          )
            return;
          const nextManager = tab.dataset.managerTab;
          if (!nextManager) return;
          setActiveManager(nextManager);
        });
      });
    });
  })();
</script>

<script>
  import { initSiteControls } from './site-shadcn-controls';

  initSiteControls(document);
  document.addEventListener('astro:page-load', () => initSiteControls(document));
</script>

<style>
  .install-command-card {
    margin: 1.5rem 0 0;
  }
  .install-command-card__managers {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    min-width: 0;
    overflow-x: auto;
  }
  .install-command-card__manager {
    flex: none;
    min-height: 2.75rem;
  }
  .install-command-card__copy {
    margin-inline-start: auto;
    flex: none;
  }
  .install-command-card__body {
    margin: 0;
    padding: var(--docs-code-padding);
    overflow: auto;
    white-space: normal;
    text-align: start;
  }
  .install-command-card__body--hidden {
    display: none;
  }
  .install-command-card__body code {
    display: block;
    font: inherit;
    width: max-content;
    min-width: 100%;
    white-space: pre;
  }
</style>
