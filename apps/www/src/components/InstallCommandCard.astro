---
// <InstallCommandCard
//   manager="npm"
//   commands={{
//     pnpm: 'pnpm dlx @proto.ui/cli@0.2.0-rc.0 add react shadcn-button',
//     npm: 'npx @proto.ui/cli@0.2.0-rc.0 add react shadcn-button',
//     yarn: 'yarn dlx @proto.ui/cli@0.2.0-rc.0 add react shadcn-button',
//   }}
// />

type PackageManager = 'pnpm' | 'npm' | 'yarn' | 'bun';

interface Props {
  command?: string;
  manager?: PackageManager | string;
  managers?: (PackageManager | string)[];
  commands?: Partial<Record<PackageManager | string, string>>;
}

const { command, manager = 'npm', managers, commands } = Astro.props;
const shellId = `install-command-${Math.random().toString(36).slice(2)}`;

const normalizedEntries = (() => {
  if (commands && Object.keys(commands).length > 0) {
    const preferredManagers = managers?.length
      ? managers
      : (Object.keys(commands) as (PackageManager | string)[]);
    return preferredManagers
      .filter((item) => typeof commands[item] === 'string' && commands[item])
      .map((item) => ({
        manager: item,
        command: commands[item] as string,
      }));
  }

  if (!command) {
    throw new Error('[InstallCommandCard] Either "command" or "commands" is required.');
  }

  const resolvedManagers = managers?.length ? managers : [manager];
  return resolvedManagers.map((item) => ({
    manager: item,
    command,
  }));
})();

const activeManager =
  normalizedEntries.find((entry) => entry.manager === manager)?.manager ??
  normalizedEntries[0]?.manager;
---

<figure
  class="install-command-card"
  data-install-command-card
  data-active-manager={activeManager}
  id={shellId}
>
  <div class="install-command-card__toolbar">
    <span class="install-command-card__prompt" aria-hidden="true">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M8 9l-3 3 3 3"></path>
        <path d="M13 15h6"></path>
      </svg>
    </span>

    <div class="install-command-card__managers" aria-label="Package manager">
      {
        normalizedEntries.map((entry) => (
          <wc-shadcn-button
            data-site-shadcn-button
            data-variant="ghost"
            data-size="sm"
            type="button"
            class:list={[
              'install-command-card__manager',
              entry.manager === activeManager && 'install-command-card__manager--active',
            ]}
            data-manager-tab={entry.manager}
            aria-pressed={entry.manager === activeManager ? 'true' : 'false'}
          >
            {entry.manager}
          </wc-shadcn-button>
        ))
      }
    </div>

    <wc-shadcn-button
      data-site-shadcn-button
      data-variant="ghost"
      data-size="icon"
      type="button"
      class="install-command-card__copy"
      title="Copy command"
      aria-label="Copy command"
      data-copy-button
    >
      <span data-copy-icon>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
      </span>
      <span class="sr-only">Copy command</span>
    </wc-shadcn-button>
  </div>

  {
    normalizedEntries.map((entry) => (
      <div
        class:list={[
          'install-command-card__body',
          entry.manager === activeManager || 'install-command-card__body--hidden',
        ]}
        data-command-panel={entry.manager}
        hidden={entry.manager !== activeManager}
      >
        <code data-command>{entry.command}</code>
      </div>
    ))
  }
</figure>

<script>
  (() => {
    document.querySelectorAll<HTMLElement>('[data-install-command-card]').forEach((card) => {
      if (card.dataset.installCommandInit === '1') return;
      card.dataset.installCommandInit = '1';

      const copyButton = card.querySelector<HTMLElement>('[data-copy-button]');
      const copyIcon = card.querySelector<HTMLElement>('[data-copy-icon]');
      const tabs = Array.from(card.querySelectorAll<HTMLElement>('[data-manager-tab]'));
      const panels = Array.from(card.querySelectorAll<HTMLElement>('[data-command-panel]'));
      if (!copyButton || !copyIcon || tabs.length === 0 || panels.length === 0) return;

      const defaultIcon = copyIcon.innerHTML;
      const successIcon = `
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
      `;

      function getCommandNode() {
        const activeManager = card.dataset.activeManager;
        return card.querySelector<HTMLElement>(
          `[data-command-panel="${activeManager}"] [data-command]`
        );
      }

      function setActiveManager(nextManager: string) {
        card.dataset.activeManager = nextManager;
        tabs.forEach((tab) => {
          const active = tab.dataset.managerTab === nextManager;
          tab.classList.toggle('install-command-card__manager--active', active);
          tab.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        panels.forEach((panel) => {
          const active = panel.dataset.commandPanel === nextManager;
          panel.hidden = !active;
          panel.classList.toggle('install-command-card__body--hidden', !active);
        });
      }

      tabs.forEach((tab) => {
        tab.addEventListener('click', (event) => {
          if (tab.matches('wc-shadcn-button') && !(event instanceof CustomEvent)) return;
          const nextManager = tab.dataset.managerTab;
          if (!nextManager) return;
          setActiveManager(nextManager);
        });
      });

      copyButton.addEventListener('click', async (event) => {
        if (copyButton.matches('wc-shadcn-button') && !(event instanceof CustomEvent)) return;
        try {
          await navigator.clipboard.writeText(getCommandNode()?.textContent ?? '');
          copyIcon.innerHTML = successIcon;
          window.setTimeout(() => {
            copyIcon.innerHTML = defaultIcon;
          }, 1500);
        } catch {
          copyIcon.innerHTML = defaultIcon;
        }
      });
    });
  })();
</script>

<script>
  import { initSiteShadcnControls } from './site-shadcn-controls';

  initSiteShadcnControls(document);
  document.addEventListener('astro:page-load', () => initSiteShadcnControls(document));
</script>

<style>
  .install-command-card {
    margin: 1.5rem 0 0;
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    overflow: hidden;
    background: color-mix(in oklch, var(--color-muted) 55%, var(--color-background) 45%);
    box-shadow: 0 1px 0 color-mix(in oklch, var(--color-foreground) 4%, transparent);
  }

  .install-command-card__toolbar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3rem;
    padding: 0.85rem 0.95rem;
    border-bottom: 1px solid color-mix(in oklch, var(--color-border) 88%, transparent);
  }

  .install-command-card__prompt {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 0.28rem;
    background: color-mix(in oklch, var(--color-foreground) 72%, var(--color-background) 28%);
    color: var(--color-background);
    flex: none;
  }

  .install-command-card__managers {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .install-command-card__manager {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2rem;
    padding: 0.15rem 0.8rem;
    border-radius: 0.8rem;
    color: var(--color-muted-foreground);
    font-size: 1rem;
    line-height: 1;
    font-weight: 500;
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
  }

  .install-command-card__manager--active {
    background: var(--color-background);
    color: var(--color-foreground);
    border-color: color-mix(in oklch, var(--color-border) 90%, transparent);
    box-shadow:
      0 1px 2px color-mix(in oklch, var(--color-foreground) 5%, transparent),
      inset 0 1px 0 color-mix(in oklch, white 50%, transparent);
  }

  .install-command-card__copy {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 0.75rem;
    background: transparent;
    color: var(--color-muted-foreground);
    cursor: pointer;
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }

  .install-command-card__copy:hover {
    background: color-mix(in oklch, var(--color-accent) 22%, transparent);
    color: var(--color-foreground);
  }

  .install-command-card__body {
    margin: 0;
    padding: 0.6rem 1rem 0.7rem;
    overflow-x: auto;
    color: var(--color-code-foreground, var(--color-foreground));
    font-size: 1rem;
    line-height: 1.4;
    text-align: left;
  }

  .install-command-card__body--hidden {
    display: none;
  }

  .install-command-card__body code {
    display: block;
    font-family:
      'SFMono-Regular', 'Cascadia Code', 'JetBrains Mono', Consolas, 'Liberation Mono', Menlo,
      monospace;
    width: max-content;
    min-width: 100%;
    white-space: pre;
    text-align: left;
  }

  :global([data-theme='dark']) .install-command-card {
    box-shadow: 0 1px 0 color-mix(in oklch, white 3%, transparent);
  }

  :global([data-theme='dark']) .install-command-card__prompt {
    background: color-mix(in oklch, white 24%, #2b2b2b 76%);
    color: white;
  }

  :global([data-theme='dark']) .install-command-card__manager--active {
    box-shadow:
      0 1px 1px color-mix(in oklch, black 30%, transparent),
      inset 0 1px 0 color-mix(in oklch, white 8%, transparent);
  }
</style>
