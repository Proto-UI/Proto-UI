---
import DraftProjectionStyle from '../../../components/DraftProjectionStyle.astro';
import { renderThemeCss } from '../../../../../../packages/prototypes/liquid-glass/src/theme';
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Liquid Glass: live bounded material evidence</title>
    <DraftProjectionStyle />
    <style is:global data-material-theme set:html={renderThemeCss()}></style>
    <script is:inline>
      document.documentElement.dataset.theme =
        new URLSearchParams(location.search).get('theme') === 'dark' ? 'dark' : 'light';
    </script>
  </head>
  <body>
    <main>
      <h1>Liquid Glass: real translucent controls</h1>
      <p>
        One Base Button. Source-authored alpha and 4px backdrop blur when live preferences and
        explicit Web support allow it.
      </p>
      <p>
        Only the functional control layer uses glass. The page content remains ordinary, readable
        content. Refraction and Apple's native material engine are not claimed.
      </p>
      <div class="grid">
        {
          ['wc', 'react', 'vue', 'vue2'].map((runtime) => (
            <section>
              <h2>
                {runtime === 'wc'
                  ? 'Web Components'
                  : runtime === 'vue'
                    ? 'Vue 3'
                    : runtime === 'vue2'
                      ? 'Vue 2'
                      : 'React'}
              </h2>
              <div class="material-scene" data-material-host={runtime} />
              <p>
                Regular action: automatic material. Opaque action: deliberate safe opt-out. Accent:
                solid for text clarity.
              </p>
              <output data-activations={runtime}>0 activations</output>
            </section>
          ))
        }
      </div>
    </main>
    <script>
      import button from '@proto.ui/prototypes-liquid-glass/button';
      import { registerPrototype } from '../../../components/PrototypePreviewer/registry';
      import { renderDemo } from '../../../components/PrototypePreviewer/demo-renderer';
      import type {
        DemoRenderResult,
        DemoSpec,
      } from '../../../components/PrototypePreviewer/demo-types';
      import type { RuntimeId } from '../../../components/PrototypePreviewer/runtimes/registry';
      if (new URLSearchParams(location.search).has('unknown'))
        Object.defineProperty(window, 'matchMedia', { value: undefined, configurable: true });
      registerPrototype('liquid-glass-button', button);
      const records: DemoRenderResult[] = [];
      (window as any).liquidMaterialFixture = {
        async dispose() {
          for (const record of records.splice(0).reverse()) await record.destroy();
        },
      };
      async function mount() {
        for (const runtime of ['wc', 'react', 'vue', 'vue2'] as RuntimeId[]) {
          const host = document.querySelector<HTMLElement>(`[data-material-host="${runtime}"]`)!;
          const demo: DemoSpec = {
            type: 'demo',
            root: {
              kind: 'box',
              className: 'material-controls',
              children: [
                {
                  kind: 'proto',
                  prototypeId: 'liquid-glass-button',
                  ref: 'regular',
                  props: {},
                  children: ['Regular action'],
                },
                {
                  kind: 'proto',
                  prototypeId: 'liquid-glass-button',
                  props: { material: 'opaque' },
                  children: ['Opaque action'],
                },
                {
                  kind: 'proto',
                  prototypeId: 'liquid-glass-button',
                  props: { variant: 'prominent' },
                  children: ['Accent'],
                },
              ],
            },
            setup({ refs, api }) {
              let count = 0;
              const update = () => {
                document.querySelector<HTMLOutputElement>(
                  `[data-activations="${runtime}"]`
                )!.value = `${++count} activations`;
              };
              api.setProps('regular', { onClick: update });
              const event = (event: Event) => {
                if (event instanceof CustomEvent) update();
              };
              refs.regular.addEventListener('click', event);
              return () => refs.regular.removeEventListener('click', event);
            },
          };
          records.push(await renderDemo({ runtime, demo, host }));
        }
        document.documentElement.dataset.materialReady = 'true';
      }
      void mount().catch((error) => {
        document.documentElement.dataset.materialError = String(error);
        console.error(error);
      });
    </script>
  </body>
</html>
<style is:global>
  body {
    margin: 0;
    color: var(--pui-foreground);
    background: var(--pui-background);
    font-family: ui-sans-serif, system-ui, sans-serif;
  }
  main {
    max-width: 1200px;
    padding: 32px;
    margin: auto;
  }
  h1 {
    font-size: 32px;
    letter-spacing: -0.03em;
  }
  p {
    line-height: 1.6;
    max-width: 80ch;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  section {
    min-width: 0;
  }
  .material-scene {
    padding: 36px 20px;
    border-radius: 20px;
    background: repeating-linear-gradient(
      105deg,
      #fa9cce 0 9px,
      #b4daf7 9px 18px,
      #f9e4a3 18px 27px,
      #a5d9ce 27px 36px
    );
  }
  .material-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }
  @media (max-width: 700px) {
    main {
      padding: 20px;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
