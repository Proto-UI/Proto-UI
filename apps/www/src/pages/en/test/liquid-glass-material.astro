---
import DraftProjectionStyle from '../../../components/DraftProjectionStyle.astro';
import { renderThemeCss } from '../../../../../../packages/prototypes/liquid-glass/src/theme';
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Liquid Glass: V2 optical provider evidence</title>
    <DraftProjectionStyle />
    <style is:global data-material-theme set:html={renderThemeCss()}></style>
    <script is:inline>
      document.documentElement.dataset.theme =
        new URLSearchParams(location.search).get('theme') === 'dark' ? 'dark' : 'light';
    </script>
  </head>
  <body>
    <main>
      <h1>Liquid Glass: visible application backdrop</h1>
      <p>
        One Base Button on each Web Adapter. The fixed liquidGL optical kernel samples the visible
        application-owned canvas behind the controls.
      </p>
      <p>
        The live canvas is the only admitted source plane. This does not capture arbitrary DOM or
        the browser compositor. Source loss, overlapping content and unavailable preferences
        preserve readable fallback. No native or Apple-private equivalence is claimed.
      </p>
      <div class="grid">
        {
          ['wc', 'react', 'vue', 'vue2'].map((runtime) => (
            <section>
              <h2>
                {runtime === 'wc'
                  ? 'Web Components'
                  : runtime === 'vue'
                    ? 'Vue 3'
                    : runtime === 'vue2'
                      ? 'Vue 2'
                      : 'React'}
              </h2>
              <div class="material-scene" data-material-host={runtime} />
              <p>
                Regular action: automatic material. Opaque action: deliberate safe opt-out. Accent:
                solid for text clarity.
              </p>
              <output data-activations={runtime}>0 activations</output>
            </section>
          ))
        }
      </div>
    </main>
    <script>
      import button from '@proto.ui/prototypes-liquid-glass/button';
      import { createPreviewMaterialScene } from '../../../components/PrototypePreviewer/preview-material-scene';
      import { inspectCanvasBackdrop } from '@proto.ui/adapter-base/web-material';
      import { inspectWebOpticalResources } from '../../../../../../packages/adapters/base/src/material/program-pool';
      import { createWebOpticalProgram } from '../../../../../../packages/adapters/base/src/material/program';
      import { resolvePaletteColor } from '../../../../../../packages/adapters/base/src/material/style';
      import { registerPrototype } from '../../../components/PrototypePreviewer/registry';
      import { renderDemo } from '../../../components/PrototypePreviewer/demo-renderer';
      import type {
        DemoRenderResult,
        DemoSpec,
      } from '../../../components/PrototypePreviewer/demo-types';
      import type { RuntimeId } from '../../../components/PrototypePreviewer/runtimes/ids';
      if (new URLSearchParams(location.search).has('unknown'))
        Object.defineProperty(window, 'matchMedia', { value: undefined, configurable: true });
      registerPrototype('liquid-glass-button', button);
      const records: DemoRenderResult[] = [];
      const scenes = new Map<string, ReturnType<typeof createPreviewMaterialScene>>();
      (window as any).liquidMaterialFixture = {
        metrics() { return inspectWebOpticalResources(document); },
        async stress(count: number) {
          const host = document.createElement('section'); host.dataset.materialStress = ''; document.querySelector('main')!.append(host);
          const scene = createPreviewMaterialScene(host); scene.pause(true); scenes.set('stress', scene);
          records.push(await renderDemo({ runtime: 'wc', host: scene.mount, demo: { type: 'demo', root: { kind: 'box', className: 'material-controls', children: Array.from({ length: count }, (_, i) => ({ kind: 'proto', prototypeId: 'liquid-glass-button', children: [`Stress ${i}`] })) } } }));
        },
        pause(value: boolean) { for (const scene of scenes.values()) scene.pause(value); },
        source(runtime: string, value: boolean) { scenes.get(runtime)?.sourceAvailable(value); },
        redraw() { for (const scene of scenes.values()) scene.redraw(); },
        zeroRefraction(runtime: string) {
          const scene = scenes.get(runtime)!, host = scene.scope.querySelector<HTMLElement>('[data-demo-ref="regular"]')!;
          const source = scene.lease.current()!, admission = inspectCanvasBackdrop(host, source);
          if (!admission.valid) throw new Error(admission.reason);
          const css = getComputedStyle(host), rect = host.getBoundingClientRect(), canvas = document.createElement('canvas');
          const program = createWebOpticalProgram(canvas, 'zero-refraction');
          try { return program.render({ source, geometry: { width: rect.width, height: rect.height, radius: Math.min(parseFloat(css.borderTopLeftRadius), rect.width / 2, rect.height / 2), dpr: devicePixelRatio, bounds: admission.bounds }, pressed: false, variant: 'regular', fill: resolvePaletteColor(css.getPropertyValue('--pui-secondary').trim(), {})!, foreground: resolvePaletteColor(css.color, {})! }); }
          finally { program.clear(); }
        },
        async dispose() {
          for (const record of records.splice(0).reverse()) await record.destroy();
          for (const scene of scenes.values()) scene.dispose(); scenes.clear();
        },
      };
      async function mount() {
        for (const runtime of ['wc', 'react', 'vue', 'vue2'] as RuntimeId[]) {
          const host = document.querySelector<HTMLElement>(`[data-material-host="${runtime}"]`)!;
          const scene = createPreviewMaterialScene(host); scenes.set(runtime, scene);
          const demo: DemoSpec = {
            type: 'demo',
            root: {
              kind: 'box',
              className: 'material-controls',
              children: [
                {
                  kind: 'proto',
                  prototypeId: 'liquid-glass-button',
                  ref: 'regular',
                  props: {},
                  children: ['Regular action'],
                },
                {
                  kind: 'proto',
                  prototypeId: 'liquid-glass-button',
                  props: { material: 'opaque' },
                  children: ['Opaque action'],
                },
                {
                  kind: 'proto',
                  prototypeId: 'liquid-glass-button',
                  props: { variant: 'prominent' },
                  children: ['Accent'],
                },
              ],
            },
            setup({ refs, api }) {
              let count = 0;
              const update = () => {
                document.querySelector<HTMLOutputElement>(
                  `[data-activations="${runtime}"]`
                )!.value = `${++count} activations`;
              };
              api.setProps('regular', { onClick: update });
              const event = (event: Event) => {
                if (event instanceof CustomEvent) update();
              };
              refs.regular.addEventListener('click', event);
              return () => refs.regular.removeEventListener('click', event);
            },
          };
          records.push(await renderDemo({ runtime, demo, host: scene.mount }));
        }
        document.documentElement.dataset.materialReady = 'true';
      }
      void mount().catch((error) => {
        document.documentElement.dataset.materialError = String(error);
        console.error(error);
      });
    </script>
  </body>
</html>
<style is:global>
  body {
    margin: 0;
    color: var(--pui-foreground);
    background: var(--pui-background);
    font-family: ui-sans-serif, system-ui, sans-serif;
  }
  main {
    max-width: 1200px;
    padding: 32px;
    margin: auto;
  }
  h1 {
    font-size: 32px;
    letter-spacing: -0.03em;
  }
  p {
    line-height: 1.6;
    max-width: 80ch;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  section {
    min-width: 0;
  }
  .material-scene {
    padding: 36px 20px;
    border-radius: 20px;
    background: repeating-linear-gradient(
      105deg,
      #fa9cce 0 9px,
      #b4daf7 9px 18px,
      #f9e4a3 18px 27px,
      #a5d9ce 27px 36px
    );
  }
  .material-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }
  @media (max-width: 700px) {
    main {
      padding: 20px;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
