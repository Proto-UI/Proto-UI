---
import '../../../styles/global.css';
import SiteLibraryStyle from '../../../components/SiteLibraryStyle.astro';
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Native typography acceptance fixture</title>
    <SiteLibraryStyle />
  </head>
  <body>
    <!-- Original native content only. This bounded test route is not a public
         Typography API or a second implementation of a projection/runtime. -->
    <main
      data-site-family-scope
      data-site-library-family="shadcn"
      data-pagefind-body
      class="font-sans"
    >
      <div class="fixture-controls">
        <label for="fixture-runtime">Test runtime</label>
        <select id="fixture-runtime">
          <option value="wc">Web Components</option><option value="react">React</option>
          <option value="vue">Vue</option><option value="vue2">Vue 2</option>
        </select>
        <label for="fixture-family">Test family</label>
        <select id="fixture-family">
          <option value="shadcn">Shadcn</option><option value="brutalist">Brutalist</option>
        </select>
      </div>
      <div data-doc-flow>
        <h1 id="native-title">Native typography acceptance</h1>
        <h2 id="native-section">Original semantics</h2>
        <p id="native-copy">
          Alpha <em id="native-emphasis">original emphasis</em> 中文可以选择与复制 <a
            id="native-link"
            href="#native-target">native link</a
          >
        </p>
        <p id="latin-copy">Original Latin typography</p>
        <p id="cjk-copy" lang="zh-CN">中文原文可选择复制</p>
        <label id="native-label" for="native-input">Your name 姓名</label>
        <input id="native-input" size="8" value="retained" />
        <fieldset id="native-group">
          <legend id="native-legend">Options 选项</legend><input
            type="checkbox"
            id="native-option"
          /><label for="native-option">Keep source</label>
        </fieldset>
        <h3 id="native-target">Native destination</h3>
        <p>
          Evidence fixture only. These are original native elements using the website's real
          typography participant.
        </p>
      </div>
    </main>
    <script is:inline>
      // Capture actual SSR source identities before any deferred module runs.
      window.__nativeTypographySources = Array.from(
        document.querySelectorAll(
          '[data-doc-flow] h1,[data-doc-flow] h2,[data-doc-flow] h3,[data-doc-flow] p,[data-doc-flow] label,[data-doc-flow] legend'
        )
      ).map((native) => {
        const walker = document.createTreeWalker(native, NodeFilter.SHOW_TEXT);
        const texts = [];
        while (walker.nextNode()) texts.push(walker.currentNode);
        return {
          native,
          text: native.textContent,
          texts,
          values: texts.map((node) => node.textContent),
        };
      });
    </script>
    <script>
      import { initDocumentationTypography } from '../../../components/site-typography-client';
      import {
        PREFERRED_ADAPTER_EVENT,
        PREFERRED_ADAPTER_KEY,
      } from '../../../components/adapter-preference';
      import {
        applySiteLibraryFamily,
        requireSiteLibraryFamily,
      } from '../../../components/site-library-family';
      import { isRuntimeId } from '../../../components/PrototypePreviewer/runtimes/registry';
      const runtime = document.querySelector<HTMLSelectElement>('#fixture-runtime')!;
      const family = document.querySelector<HTMLSelectElement>('#fixture-family')!;
      const saved = localStorage.getItem(PREFERRED_ADAPTER_KEY);
      if (isRuntimeId(saved)) runtime.value = saved;
      runtime.addEventListener('change', () => {
        if (!isRuntimeId(runtime.value)) return;
        localStorage.setItem(PREFERRED_ADAPTER_KEY, runtime.value);
        document.dispatchEvent(
          new CustomEvent(PREFERRED_ADAPTER_EVENT, { detail: { adapter: runtime.value } })
        );
      });
      family.addEventListener('change', () =>
        applySiteLibraryFamily(document, requireSiteLibraryFamily(family.value))
      );
      initDocumentationTypography(document);
    </script>
  </body>
</html>

<style>
  main {
    max-width: 52rem;
    padding: 1rem;
    margin-inline: auto;
  }
  .fixture-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  select,
  input {
    max-width: 100%;
  }
</style>
